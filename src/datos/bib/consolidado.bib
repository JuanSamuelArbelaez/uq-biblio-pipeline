@article{cons2406,
    author = "Bai, Yunpeng and Li, Yuanjun and Zhao, Min and Zhao, Chenjie and Liu, Bingjun and Chen, Dengkai",
    title = "Comparative analysis of AIGC-assisted and conventional design approaches in car seat design",
    journal = "Advanced Design Research",
    volume = "3",
    number = "1",
