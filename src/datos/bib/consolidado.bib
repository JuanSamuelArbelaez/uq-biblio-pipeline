}

@inproceedings{cons79,
    author = "Fang, Wenjie and Luo, Bin",
    title = "Application and Impact of Generative Artificial Intelligence Techniques in Education--Citespace-based visualization and analysis",
    year = "2025",
    isbn = "9798400712692",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3722237.3722258",
    doi = "10.1145/3722237.3722258",
    abstract = "Recently, generative AI technology has arisen as a trending research agenda in education. This study makes an review of 260 documents from the CNKI database published from 2020 to 2024. Through the bibliometric and content analysis methods, together with the CiteSpace tool, highlight the trending application of this technology in education, the distribution characteristics of the core authors and institutions' postings, and the clustering analysis of the research hotspots. The results show continued wide adoption of generative AI technology in education in recent years, peaking sharply in 2023. There hasn't been a stable core group of authors within the field, and the collaborative network is relatively sparse. Research hotspots mainly cover artificial intelligence, human-computer collaboration and educational transformation, which indicates the function generative AI technology could have within the digital transformation and quality enhancement of education. This paper additionally shows the actualization of generative AI technology through its presentation of AI tutors and teaching assistants, teaching models reform, and reshaped instructional evaluation systems via case studies. In face of misuse, integrity issues, and ethical concerns arising, there is a need to find a balance in the application of the technology, such that its more proper development can promote rather than replace human subjectivity.",
    booktitle = "Proceedings of the 2024 3rd International Conference on Artificial Intelligence and Education",
    pages = "117–122",
    numpages = "6",
    keywords = "CiteCpace visual analytic, Educational Application, Generative AI, Human-computer collaboration",
    location = "",
    series = "ICAIE '24"
}

@inproceedings{cons80,
    author = "Liu, Rongxin and Zenke, Carter and Liu, Charlie and Holmes, Andrew and Thornton, Patrick and Malan, David J.",
    title = "Teaching CS50 with AI: Leveraging Generative Artificial Intelligence in Computer Science Education",
    year = "2024",
    isbn = "9798400704239",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3626252.3630938",
    doi = "10.1145/3626252.3630938",
    abstract = {In Summer 2023, we developed and integrated a suite of AI-based software tools into CS50 at Harvard University. These tools were initially available to approximately 70 summer students, then to thousands of students online, and finally to several hundred on campus during Fall 2023. Per the course's own policy, we encouraged students to use these course-specific tools and limited the use of commercial AI software such as ChatGPT, GitHub Copilot, and the new Bing. Our goal was to approximate a 1:1 teacher-to-student ratio through software, thereby equipping students with a pedagogically-minded subject-matter expert by their side at all times, designed to guide students toward solutions rather than offer them outright. The tools were received positively by students, who noted that they felt like they had "a personal tutor.'' Our findings suggest that integrating AI thoughtfully into educational settings enhances the learning experience by providing continuous, customized support and enabling human educators to address more complex pedagogical issues. In this paper, we detail how AI tools have augmented teaching and learning in CS50, specifically in explaining code snippets, improving code style, and accurately responding to curricular and administrative queries on the course's discussion forum. Additionally, we present our methodological approach, implementation details, and guidance for those considering using these tools or AI generally in education.},
    booktitle = "Proceedings of the 55th ACM Technical Symposium on Computer Science Education V. 1",
    pages = "750–756",
    numpages = "7",
    keywords = "ai, artificial intelligence, generative ai, large language models, llms",
    location = "Portland, OR, USA",
    series = "SIGCSE 2024"
}

@inproceedings{cons81,
    author = "Ma, Shuaiyao and Lei, Lei",
    title = "Opportunities and Challenges of Generative Artificial Intelligence in Facilitating Learning for Chinese University Students",
    year = "2024",
    isbn = "9798400716157",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3660043.3660178",
    doi = "10.1145/3660043.3660178",
    abstract = "With the emergence of Artificial Intelligence in General Chat (AIGC), represented by ChatGPT, collaborative learning tasks between university students and machines have become a new norm in higher education. Simply prohibiting this new wave of technology cannot fundamentally address its challenges. This article presents the results of a survey investigating Chinese university students' perspectives on generative artificial intelligence technologies, such as ChatGPT, in supporting their learning. It analyzes the opportunities and challenges presented by this technology. Universities need to adapt to this transformation by altering the nature of student assignments and the methods of assessment. Additionally, they must effectively leverage the advantages of students conveniently acquiring knowledge through AIGC and the opportunity for personalized tutoring across various subjects. Striking the right balance between opportunities and challenges is crucial for creating a more productive and beneficial learning environment. Ultimately, this adaptation will better prepare education for the developments and changes in the era of artificial intelligence.",
    booktitle = "Proceedings of the 2023 International Conference on Information Education and Artificial Intelligence",
    pages = "756–760",
    numpages = "5",
    location = "Xiamen, China",
    series = "ICIEAI '23"
}

@inproceedings{cons82,
    author = "Zhang, Yushuang and Miao, Miao",
    title = "The Roles and Functions of Foreign Language Teachers of China in the Context of Generative Artificial Intelligence",
    year = "2024",
    isbn = "9798400709920",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3687311.3687415",
    doi = "10.1145/3687311.3687415",
    abstract = "With the rapid development of Generative Artificial Intelligence (Generative AI) technology, its application in the field of foreign language teaching is becoming increasingly widespread, showing great potential for improving teaching efficiency and personalized learning in higher education. This paper discusses the application of Generative AI in foreign language teaching and analyzes teachers' roles and functions in this process. Teachers face challenges in adapting to this new technology, which calls for teachers to transform from authorities and disseminators of language knowledge to innovative designers, co-learner supporters, and navigators for future education.",
    booktitle = "Proceedings of the 2024 International Conference on Intelligent Education and Computer Technology",
    pages = "584–586",
    numpages = "3",
    location = "Guilin, China",
    series = "IECT '24"
}

@article{cons83,
    author = "Zhang, Hongbo and Chen, Pei and Xie, Xuelong and Jiang, Zhaoqu and Zhou, Zihong and Sun, Lingyun",
    title = "A Hybrid Prototype Method Combining Physical Models and Generative Artificial Intelligence to Support Creativity in Conceptual Design",
    year = "2024",
    issue_date = "October 2024",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    volume = "31",
    number = "5",
    issn = "1073-0516",
    url = "https://doi.org/10.1145/3689433",
    doi = "10.1145/3689433",
    abstract = "Conceptual design is an essential stage in the design process, and its ultimate success largely depends on designers’ creativity. Both physical and digital prototypes are commonly adopted by designers to support ideation and creativity, providing intuitive perception and rapid iteration, respectively. In recent advancements, large-scale generation models are able to offer data-enabled creativity support by generating high-quality solutions comparable to human designers. This opens up an imaginary space for designers and brings new possibilities for design tools. In this study, we proposed a hybrid prototype method that synergistically combines physical models and generative artificial intelligence (AI) in the conceptual design stage. Correspondingly, we developed a hybrid prototype system to implement the proposed method. We conducted a comparative user study with 45 designers who completed a design task using the physical prototype method, standalone generative AI and the hybrid prototype method, respectively. Our results verified the effectiveness of the hybrid prototype method and investigated its mechanism in supporting creativity. Finally, we discussed the application value and optimisation space of the hybrid prototype method.",
    journal = "ACM Trans. Comput.-Hum. Interact.",
    month = "November",
    articleno = "65",
    numpages = "34",
    keywords = "Hybrid Prototype, Generative AI, Co-creative Systems, Physical Prototype, Creativity Support Tool (CST), Applications of Large-scale Generation Models"
}

@inproceedings{cons84,
    author = "Song, Ningning and Han, Fengwu and He, Pengyang",
    title = "The Research on the Influencing Factors of College Students'Dishonest Behaviors in Online Learning in the background of Generative Artificial Intelligence",
    year = "2025",
    isbn = "9798400717468",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3711403.3711408",
    doi = "10.1145/3711403.3711408",
    abstract = "With the popularity of online learning and the development of generative artificial intelligence technology, a significant scale of dishonest behaviors have emerged in the online learning environment, directly harming the construction and development of online learning ecology. Therefore, based on the Theory of Planned Behavior (TPB) and Self-Determination Theory (SDT), this study adopts the method of structural equation model to deeply understand the influencing factors of college students' dishonest behaviors in online learning under the background of generative artificial intelligence. The results show that attitude, perceived behavioral control, and subjective norm all have a significant positive impact on behavior intention of dishonesty when online learning. Specifically, the attitude of dishonest behaviors in online learning is influenced by autonomous motivation (e.g., intrinsic interest, self-improvement) and controlled motivation (e.g., external rewards, avoidance of punishments); perceived behavioral control is influenced by autonomous motivation, controlled motivation, and moral obligation; and the subjective norm is not only affected by autonomous motivation but also by moral obligation. Based on this, this study proposes some interventions to mitigate dishonest behaviors in online learning to create a good learning atmosphere for the online learning environment.",
    booktitle = "Proceedings of the 2024 7th International Conference on Educational Technology Management",
    pages = "28–35",
    numpages = "8",
    keywords = "Dishonest behaviors, Online learning, Structural equation model",
    location = "",
    series = "ICETM '24"
}

@inproceedings{cons85,
    author = "Liu, Rongxin and Zenke, Carter and Liu, Charlie and Holmes, Andrew and Thornton, Patrick and Malan, David J.",
    title = "Teaching CS50 with AI: Leveraging Generative Artificial Intelligence in Computer Science Education",
    year = "2024",
    isbn = "9798400704246",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3626253.3635427",
    doi = "10.1145/3626253.3635427",
    abstract = {CS50.ai is an AI-based educational tool developed and integrated into CS50 at Harvard University using large language models (LLMs), supporting both in-person and online learners. CS50.ai encapsulates a variety of AI-based tools designed to enhance students' learning by approximating a 1:1 teacher-to-student ratio. We showcase: "Explain Highlighted Code," a Visual Studio (VS) Code extension that provides just-in-time explanations of code snippets; style50, a VS Code extension that offers formatting suggestions and explanations thereof; and our "CS50 Duck," an AI-based chatbot for course-related questions, implemented both as a VS Code extension and as a standalone web application. We also demonstrate the integration of our tools into Ed, the course's discussion forum. This demo will illustrate the functionality and effectiveness of these tools as well as the pedagogical "guardrails" that we put in place to ensure secure and fair usage of these tools, while sharing insights from our own experience therewith this past summer and fall.},
    booktitle = "Proceedings of the 55th ACM Technical Symposium on Computer Science Education V. 2",
    pages = "1927",
    numpages = "1",
    keywords = "ai, artificial intelligence, generative ai, large language models, llms",
    location = "Portland, OR, USA",
    series = "SIGCSE 2024"
}

@inproceedings{cons86,
    author = "Qi, Wenqian and Liu, Mengmeng and Li, Na and Qu, Chenfei and Wang, Shaoqing and Li, Yuanmeng and Zhao, Mengyue and Liu, Chao",
    title = "Introduction to the research on the path of generative artificial intelligence technology ChatGPT to help teachers' professional development",
    year = "2024",
    isbn = "9798400707100",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3700297.3700395",
    doi = "10.1145/3700297.3700395",
    abstract = {This research explores the application of ChatGPT, a generative artificial intelligence technology, in the field of education. ChatGPT, short for "generative pre-training," continuously evolves and adapts through user feedback, facilitating authentic human-machine interaction. It can process natural language input and generate relevant responses, thereby providing information and answering questions. The study highlights the potential of ChatGPT in university teacher education, where it can offer intelligent teaching assistance, personalized learning resources, and instructional support. However, the integration of ChatGPT also raises challenges, such as redefining the authority of knowledge and altering the dynamics of the teacher-student relationship. Some scholars contend that ChatGPT cannot replicate genuine emotions or free will, underscoring the irreplaceable nature of education. The transformative impact of ChatGPT on education demands a reevaluation of teachers' roles and professional development in the digital age. This study seeks to clarify the role of teachers within the digital transformation represented by ChatGPT and to explore strategies for successfully navigating this shift. Additionally, the research aims to assess teachers' perceptions and utilization of ChatGPT, address related challenges, and evaluate the feasibility, potential applications, and limitations of its integration into teaching.},
    booktitle = "Proceedings of the 2024 International Symposium on Artificial Intelligence for Education",
    pages = "568–573",
    numpages = "6",
    keywords = "ChatGPT, Teacher, professional development",
    location = "",
    series = "ISAIE '24"
}

@article{cons87,
    author = "Melegati, Jorge and Petrik, Dimitri and Saltan, Andrey",
    title = "7th International Workshop on Software-intensive Business (IWSiB 2024): Software-intensive Business in the Era of Generative Artificial Intelligence",
    year = "2024",
    issue_date = "October 2024",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    volume = "49",
    number = "4",
    issn = "0163-5948",
    url = "https://doi.org/10.1145/3696117.3696123",
    doi = "10.1145/3696117.3696123",
    abstract = {The 7th International Workshop on Software-intensive Business (IWSiB'24), held on April 16, 2024, in Lisbon, Portugal, as part of the 46th International Conference on Software Engineering (ICSE 2024), brought together diverse research communities to address the pressing challenges faced by software-producing organizations. These challenges, driven by changing demands, evolving technologies, and dynamic environments, require interdisciplinary collaboration across software engineering and business research. The workshop focused on the theme "Software Business in the Era of Generative Artificial Intelligence," highlighting the transformative impact of GenAI and large language models on software businesses. The event featured a keynote by Jan Bosch and showcased 11 accepted papers on a diverse range of topics. Participants engaged in interactive discussions, group activities, and ideation sessions aimed at identifying future challenges and solutions for software-intensive businesses, fostering ongoing community development and cross-disciplinary synergy.},
    journal = "SIGSOFT Softw. Eng. Notes",
    month = "October",
    pages = "22–25",
    numpages = "4",
    keywords = "agile, software ecosystem, artificial intelligence, ethics., software-intensive business"
}

@inproceedings{cons88,
    author = "Tang, Valerie and Wong, Lap and Lam, Hoi Yan and Tang, Yuk Ming",
    title = "Amplifying Learning and Teaching Effectiveness through Generative Artificial Intelligence: A Qualitative Approach with Case Studies on Supply Chain and Cold Chain Management",
    year = "2024",
    isbn = "9798400718151",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3686081.3686126",
    doi = "10.1145/3686081.3686126",
    abstract = "The increasing popularity of Generative Artificial Intelligence (GAI) technology offers new possibilities and challenges for teaching and promoting human-AI collaborative learning. In order to enhance the learning quality and experience of students, it is important to develop an effective instructional design, particularly in defining the goals and strategies, solving individual needs, and enhancing learning performance. However, the impact of implementing GAI in student learning and performance enhancement considerations is still lacking. Therefore, this study proposes an experimental framework for evaluating the effectiveness of GAI-based learning for students. By scrutinizing instructional goals and design strategies to achieve desirable learning outcomes, it provides guidelines on coverage design and development in GAI-based learning environments. Experiment with case studies on supply chain and cold chain management is adopted to analyze the effectiveness and facilitate instructional design in GAI-based learning to enhance the student learning experience. The result indicates that the treatment group outperformed the control group. This study is expected to provide insights into academic development and future education on GAI-based learning.",
    booktitle = "Proceedings of the International Conference on Decision Science \&amp; Management",
    pages = "264–269",
    numpages = "6",
    keywords = "Cold Chain Management, Generative Artificial Intelligence (GAI), Qualitative Approach, Supply Chain Management, Teaching and Learning",
    location = "",
    series = "ICDSM '24"
}

@inproceedings{cons89,
    author = "Shan, Qiang",
    title = "Design and application of a web front-end development course training platform based on generative artificial intelligence and low code development",
    year = "2024",
    isbn = "9798400710230",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3691720.3691768",
    doi = "10.1145/3691720.3691768",
    abstract = "With the rapid development of artificial intelligence technology, generative artificial intelligence has shown strong application potential in various fields, and low code development has become a popular choice for quickly building application systems due to its efficient and easy-to-use characteristics. With the continuous updates and iterations of web front-end development technology, how to improve learners' practical abilities and development efficiency has become an important issue in the field of vocational education. Therefore, we have designed an innovative web front-end development course training platform that combines the automation generation ability of generative artificial intelligence and the fast construction advantage of low code development. In platform design, we fully utilize the automated generation capability of generative artificial intelligence to achieve intelligent generation and layout optimization of front-end page elements. At the same time, with the help of the visual programming interface and component-based development methods of low code development platforms, the front-end development process is simplified, the technical threshold is lowered, and students can focus more on the implementation of business logic and creative expression.",
    booktitle = "Proceedings of the 2nd International Conference on Educational Knowledge and Informatization",
    pages = "287–291",
    numpages = "5",
    location = "Shanghai, China",
    series = "EKI '24"
}

@inproceedings{cons90,
    author = "Mu, Guoliang",
    title = "Based on the generative artificial intelligence painting model Stable Diffusion Application and Research in Product Appearance Design",
    year = "2025",
    isbn = "9798400712845",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3726010.3726032",
    doi = "10.1145/3726010.3726032",
    abstract = "Generative AI technology, mainly based on AIGC, has been developed at a fast-moving speed recently, among which Stable Diffusion uses diffusion models, possessing strong and surprising performance on image creation or processing. This paper aims to explain the essential functioning principles behind the Stable Diffusion model and show prospective uses within product appearance design. With Stable Diffusion, designers can quickly generate multiple design ideas, optimize product details, and improve design efficiency by applying painting models. Besides, Stable Diffusion still can accelerate the innovation ability of product design and the reaction speed to the market via rapid prototype generation and customized design based on user's requirements. At the same time, this paper analyzes some practical application cases, shows the practical effect of Stable Diffusion in product appearance design, and discusses the future development direction of the technology.",
    booktitle = "Proceedings of the 2024 International Conference on Artificial Intelligence, Digital Media Technology and Interaction Design",
    pages = "154–159",
    numpages = "6",
    location = "",
    series = "ICADI '24"
}

@inproceedings{cons91,
    author = "Wu, Jinyong and Cui, Yujia and Cui, Yingwei",
    title = "The image-generative artificial intelligence Midjourney empowers Chinese landscape painting teaching and creation with positive nurturing",
    year = "2024",
    isbn = "9798400710285",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3691016.3691035",
    doi = "10.1145/3691016.3691035",
    abstract = {This study explores the positive impacts of the image-generative AI, Midjourney, on teaching and creating Chinese landscape paintings. Amid the rapid development of image-generative AI, Midjourney acts as an "assistive creative tool" in the creation of Chinese landscape paintings. The visual effects generated by key descriptive words play a significant role in guiding landscape painters' innovative thinking, brush and ink techniques, and creative concepts, even forming new circles of innovative thinking. The process of "human-machine interaction" is analyzed through the principles of human-machine cooperative Chinese landscape painting, using Midjourney training as an example to explore the mechanisms and processes of generating stylized painting schemes.},
    booktitle = "Proceedings of the 2024 International Conference on Image Processing, Intelligent Control and Computer Engineering",
    pages = "104–108",
    numpages = "5",
    location = "Qingdao, China",
    series = "IPICE '24"
}

@inproceedings{cons92,
    author = "Ji, Wei and Sun, Jian and Chen, Biaoxin and Luo, Chuangli",
    title = "The Current Status and Trends of Research on the Impact of Generative Artificial Intelligence on Employment in China",
    year = "2024",
    isbn = "9798400717147",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3675417.3675574",
    doi = "10.1145/3675417.3675574",
    abstract = "With the increasing expansion of technology application scenarios, generative artificial intelligence is set to significantly boost global productivity and profoundly impact China's employment market. This article employs 218 academic papers from 2013 to 2023, featured in Peking University's core journals and CSSCI, focusing on generative AI's impact on China's job market, for quantitative analysis using CiteSpace software. Multidimensional exploration of research overviews and hotspots reveals that the evolving and rapid application of generative AI on China's employment market becomes more and more in-depth. On this basis, the paper analyzes the challenges and opportunities generative AI presents to China's job market and proposes corresponding strategies.",
    booktitle = "Proceedings of the 2024 Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence",
    pages = "948–953",
    numpages = "6",
    location = "Hongkong, China",
    series = "DEAI '24"
}

@inproceedings{cons93,
    author = "Liu, Shitou and Liang, Zhenjie and Zhang, Ling",
    title = "Analyzing Key Influencing Factors of University Teachers45 Use of Generative Artificial Intelligence in a Small-Sample Data Environment",
    year = "2024",
    isbn = "9798400717147",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3675417.3675461",
    doi = "10.1145/3675417.3675461",
    abstract = "This study focuses on exploring the key factors influencing the use of generative artificial intelligence (AI) by university teachers in the context of digital education, particularly in the backdrop of human-computer interaction. Considering the challenges posed by small-sample data, we employed various machine learning models such as linear regression, random forest regression, and support vector regression (SVR), and optimized model parameters through grid search and cross-validation techniques. The optimized models exhibited significantly improved performance, with the linear regression model showing a mean squared error (MSE) of 0.1239 and an R² score of 0.6362, indicating its good predictive accuracy and generalization ability on the small-sample dataset. The study results emphasize performance expectations, perceived value, and community influence as primary influencing factors for university teachers' use of generative AI, especially in the context of human-computer interaction. This is crucial for understanding and promoting the acceptance and use of educational technology. This research provides valuable insights for education policymakers and technology developers and offers important methodological guidance for machine learning applications dealing with small-sample data.",
    booktitle = "Proceedings of the 2024 Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence",
    pages = "271–279",
    numpages = "9",
    location = "Hongkong, China",
    series = "DEAI '24"
}

@inproceedings{cons94,
    author = "Hsiao, Ming-Yu and Zhang, Simo",
    title = "Research on the educational application of generative artificial intelligence images in the design of semiotics learning models",
    year = "2024",
    isbn = "9798400716676",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3637907.3637947",
    doi = "10.1145/3637907.3637947",
    abstract = "Generative Artificial Intelligence (AI) has emerged as a novel technology with profound implications for education and deep learning, particularly due to its advancements in image generation. This progress has had a disruptive impact on the design industry, where designers are increasingly embracing generative AI images as innovative tools and techniques to enhance design ideation and creative expression. Integrating generative AI images into design education has become an inevitable trend, as it guides students in developing a deeper understanding of design aesthetics. However, the current application of generative AI images in design education lacks innovative use grounded in design theory. Therefore, the incorporation of generative AI images within the framework of design theory becomes crucial to interpret and refine design processes and design thinking. This research aims to explore the application of generative AI images in design semiotics, utilizing design theory as its foundation. By integrating design processes and incorporating design case studies, the study seeks to analyze how generative AI images can be effectively applied in design semiotics. Ultimately, the research strives to establish a pedagogical approach for the application of generative AI image-based design semiotics.",
    booktitle = "Proceedings of the 2023 6th International Conference on Educational Technology Management",
    pages = "8–15",
    numpages = "8",
    keywords = "AI Educational Applications, AI Teaching Methods, Design Semiotics, Design with Generative AI Images",
    location = "Guangzhou, China",
    series = "ICETM '23"
}

@inproceedings{cons95,
    author = "Li, Jingchao and Zhan, Meiwei and Li, Shanshan",
    title = "Study on the Role of Generative Artificial Intelligence in Advancing the Knowledge System of Traditional Chinese Medicine in Higher Education",
    year = "2025",
    isbn = "9798400714405",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3729605.3729611",
    doi = "10.1145/3729605.3729611",
    abstract = "The transfer and promotion of effectively inheritance and innovation of knowledge is a problem that higher education of Chinese medicine must face. This study provides a novel generative AI framework to promote the inheritance and innovative development of knowledge in traditional Chinese medical education. Utilizing multi-modal data processing (textual, visual and experiential) to construct a knowledge base, the model is based on Generative Adversarial Networks (GANs) and Transformer-based architecture. This context-aware and semantic-rich embedding is made possible using state-of-the-art technology, including attention mechanism and knowledge graph embedding. The learning structure of the model foreshadows the traditional Chinese medicine teaching model and cultivates students as good at in-depth understanding and creative application of knowledge. Furthermore, through transfer learning and domain-specific fine-tuning, the framework attains high fidelity of captured knowledge representation while also supporting the generation of new hypotheses and therapeutics. Our generative AI model improves knowledge transfer accuracy and depth, and encourage innovative thinking compared to traditional educational methodologies, as we demonstrate through experimental results.",
    booktitle = "Proceedings of the 2025 International Conference on Big Data and Informatization Education",
    pages = "28–33",
    numpages = "6",
    keywords = "Educational Innovation, Generative AI, Generative Model, Higher Education, Knowledge Transfer",
    location = "",
    series = "ICBDIE '25"
}

@inproceedings{cons96,
    author = "Fernandez Nieto, Berenice",
    title = "Toward a Human-Centered Framework for Trustworthy, Safe and Ethical Generative Artificial Intelligence: A Multi-Level Analysis of Large Language Models Social Impact",
    year = "2024",
    isbn = "9798400717017",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3661167.3661177",
    doi = "10.1145/3661167.3661177",
    abstract = {This research proposal aims to comprehensively explore the trustworthy, safe, and ethical use of Generative Artificial Intelligence (GAI), particularly Large Language Models (LLMs). To this end, we examine the risks and potential social hazards of LLMs, adopting a multidimensional approach— focused on society, human rights, and ethics— involving various stakeholders, including the AI industry, governmental institutions, and regulatory organizations, among others. This strategy allows for offering a research proposal grounded on social and technological dimensions and providing a comprehensive diagnosis, including perceived challenges in the AI industry, the regulatory debate, ethical dilemmas, etc. By delving into these areas, we aim to design a post-audit tool to ensure models are trustworthy, socially responsible, and in alignment with human rights. Additionally, we aim to encourage responsible AI Innovation through Ethics-Driven Incentives. Supervisor: Prof. Danilo Caivano, danilo.caivano@uniba.it, University of Bari "A. Moro" Co-supervisor: Dr. Azzurra Ragone, azzurra.ragone@uniba.it University of Bari "A. Moro"},
    booktitle = "Proceedings of the 28th International Conference on Evaluation and Assessment in Software Engineering",
    pages = "505–509",
    numpages = "5",
    location = "Salerno, Italy",
    series = "EASE '24"
}

@inproceedings{cons97,
    author = "Wu, Dongjie and Chen, Lizhu and Han, Yunbing",
    title = "Challenges that generative artificial intelligence poses to higher education and management and the countermeasures— A visualized analysis of literature from 2019 to 2023 using CiteSpace",
    year = "2024",
    isbn = "9798400716157",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3660043.3660174",
    doi = "10.1145/3660043.3660174",
    abstract = "In this study, a visualized analysis of the target literature is made from different perspectives using CiteSpace and the literature analysis module of the Chinese National Knowledge Infrastructure (CNKI) to identify the challenges that the generative artificial intelligence (GAI) technology poses to higher education and management and corresponding countermeasures. Our analysis revealed that GAI would reduce the demand for teachers, weaken the teacher-student tie, and exacerbate the students’ digital overdependence, causing conflicts in data ethics and intellectual property. Thus, recommendations are made here for the four parties involved in the research: the government should formulate laws to strengthen network supervision; schools need to advance the digital reform on talent training models; teachers need to keep up with the latest educational theories to shift their roles; and students need to remain critical and independent thinkers in the age of educational digitalization 2.0.",
    booktitle = "Proceedings of the 2023 International Conference on Information Education and Artificial Intelligence",
    pages = "733–738",
    numpages = "6",
    location = "Xiamen, China",
    series = "ICIEAI '23"
}

@inproceedings{cons98,
    author = "Wang, Shuyi and Sun, Jian",
    title = "Research on the Maturity Evaluation of Generative Artificial Intelligence Industry under the Background of Digital Economy: A Case Study of Guangdong Province",
    year = "2024",
    isbn = "9798400717147",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3675417.3675453",
    doi = "10.1145/3675417.3675453",
    abstract = "In order to scientifically measure the development stage of generative AI industry under the background of digital economy and evaluate the degree of perfection of emerging industry structure, this study takes Guangdong Province as an example, constructs the evaluation index system and model of generative AI industry maturity in Guangdong Province from the four dimensions of environment, technology, market and industry chain, and evaluates the current situation of the maturity of generative AI industry in each region of Guangdong Province by using entropy method and TOPSIS method. On this basis, conclusions and insights are presented. The construction of the model provides a reference standard for the scientific evaluation of the high-quality development of generative AI emerging industries, and provides empirical reference for empirical research in other regions.",
    booktitle = "Proceedings of the 2024 Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence",
    pages = "224–229",
    numpages = "6",
    location = "Hongkong, China",
    series = "DEAI '24"
}

@inproceedings{cons99,
    author = "Xu, Zhixiang and Idzwan bin Ismail, Adzrool",
    title = "Generative AI-Based Dialogue Generation and Optimization in the Style of Traditional Chinese Opera Dream of the Red Chamber Using K-means Clustering",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734944",
    doi = "10.1145/3734921.3734944",
    abstract = "This study proposes a generative artificial intelligence framework that integrates prompt engineering and K-means clustering to generate stylized dialogues from the tradition of Dream of the Red Chamber. The prompts for each character were constructed from the linguistic features of classical texts, and each generated sentence was encoded into semantic, lexical, and keyword-based features. K-means clustering was used to identify stylistic categories, and the number of clusters was validated using the Elbow Method and the Silhouette Coefficient. Evaluation used BLEU, Perplexity, and a custom Style Consistency Score. As a result, the K-means-enhanced model improved fluency and style consistency over the baseline. This method provides a quantitative approach to improving generative models in traditional cultural domains.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "149–156",
    numpages = "8",
    keywords = "Classical Chinese Opera, Dream of the Red Chamber, GPT-4o, Generative AI, K-means Clustering, Text Generation",
    location = "",
    series = "GADM '25"
}

@inbook{cons100,
    author = "Zhang, Bin and Wu, Liangshun and Rong, Jiang and Huang, Shixin and Li, Yuwen and Luo, Meizhen",
    title = "Synergistic Optimization Mechanism of Brain-Inspired Intelligence and Generative Models in Small Target Detection",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728763",
    abstract = "In the era of generative artificial intelligence, we attempt to apply brain-inspired intelligence and generative models to small target detection, but currently lack a synergistic optimization mechanism. This paper attempts to enhance the detection performance of small targets by integrating the bionic perception of brain-inspired intelligence with the data augmentation capabilities of generative models. Firstly, we simulate the multi-scale attention mechanism of the biological visual system using a brain-inspired spiking neural network (SNN), enhancing the spatial sensitivity of small target detection. Secondly, we generate high-quality small target samples and optimize local feature representation through Generative Adversarial Networks (GANs), alleviating data scarcity and feature ambiguity. This paper proposes for the first time a solution providing a cross-modal collaborative framework for small target detection, exploring the potential of combining brain-inspired mechanisms with generative models.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "242–246",
    numpages = "5"
}

@inproceedings{cons101,
    author = "Li, Tao and Li, Ruihang and Zheng, Huangnan and Lv, Pan and Pan, Zhijie",
    title = "Controllable 3D Urban Generation via Conditional VAEs and CLIP for Simulations",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734926",
    doi = "10.1145/3734921.3734926",
    abstract = "The 3D urban generation technology is of great significance in the game industry, autonomous driving simulation, and traffic simulation. However, existing image-based methods generate results with blurred boundaries, graphic-based methods produce results with poor diversity, and rendering-based methods synthesize inconsistent images. To solve these problems, this paper proposes a novel controllable 3D urban generation pipeline, which consists of urban layouts and 3D scenes generation. Specifically, we introduce the graph dynamic attention model and the dummy node to enhance the diversity of the generated results. We also design a scene asset matching method based on the CLIP model to controllably generate 3D urban scenes. Experimental results indicate that the diversity of the generated results surpasses that of existing methods, and the generated 3D urban scenes are of good consistency.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "26–31",
    numpages = "6",
    keywords = "3D Urban Generation, Dummy Node, Layout Generation, Simulation",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons102,
    author = "Gou, Pingzhang and Ren, Xuanyu",
    title = "Developing Students' Computational Thinking through Project-Based Learning Empowered by Generative AI: A Practical Study",
    year = "2025",
    isbn = "9798400715624",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3756580.3756611",
    doi = "10.1145/3756580.3756611",
    abstract = "Generative artificial intelligence shows broad application potential in the field of education, as the core thinking of the foundation of human intelligence, computational thinking urgently needs to proactively adapt to the development trend of generative artificial intelligence, and to promote the in-depth transformation of teaching methods. Taking the development of computational thinking ability as the goal, we construct a ternary teaching model that covers the empowerment layer, teaching layer and target layer, and integrates generative artificial intelligence and project-based teaching method. Taking the course of Python Programming as an example, the teaching practice is carried out. The findings demonstrate that the approach considerably enhances students' overall computational thinking skills, particularly in task decomposition, algorithm design, and assessment reflection, and lessens the complexity of problem comprehension and program development. Meanwhile, further optimization strategies for teaching are proposed to provide practical paths and theoretical references for promoting curriculum integration and teaching innovation in the context of artificial intelligence.",
    booktitle = "Proceedings of the 2025 6th International Conference on Education, Knowledge and Information Management",
    pages = "190–195",
    numpages = "6",
    keywords = "computational thinking, generative artificial intelligence, human-computer collaboration, project-based teaching",
    location = "",
    series = "ICEKIM '25"
}

@inbook{cons103,
    author = "Zhao, Jiahui and Li, Hao and Tang, Suqin",
    title = "A Hybrid Framework for Predicting Citation Harm from Retracted Papers",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728790",
    abstract = "The increasing prevalence of retractions poses significant challenges to academic integrity and scientific progress. While various tools track retracted papers, the academic community lacks proactive mechanisms to predict the potential harm caused by citing retracted research. Building upon recent work quantifying the harm, we construct a dataset to forecast the harm papers will suffer from citing retracted research. We further propose a hybrid framework that combines language model with gradient boosted trees. Our framework achieves the lowest mean absolute error (MAE) across all prediction time horizons, achieving a 2.4\% reduction in MAE compared to baseline methods. This work provides foundational resources and methodological insights for future studies on retraction impacts, aiming to help researchers make more informed citation decisions.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "411–416",
    numpages = "6"
}

@inproceedings{cons104,
    author = "Xu, Feifei and Chen, Lulu",
    title = "A Lightweight Multi-level feature Mixing network For Image Super-Resolution",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734936",
    doi = "10.1145/3734921.3734936",
    abstract = "With the development of digital image technology, single image super-resolution (SISR) has made unprecedented progress. However, the existing SISR technology based on convolutional neural network (CNN) still faces great challenges in the application of resource-constrained mobile devices. For lightweight SISR, we propose a multi-level feature mixing network (MFMN), which achieves high-quality super-resolution image reconstruction at low computational cost. Based on re-parameterization, a multi-level feature generation module (MFGM) is designed to extract feature mappings from different perspectives. Then, to enhance feature details, a feature refinement module (FRM) is constructed to aggregate high-frequency information, which can assign weight values to pixels in feature maps according to the importance of different hierarchical features. Through many experiments, our proposed method shows excellent image reconstruction results in a lightweight way on multiple benchmark datasets and exceeds the current advanced methods.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "89–94",
    numpages = "6",
    keywords = "convolutional neural network (CNN), feature refinement, multi-level feature, single image super-resolution (SISR)",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons105,
    author = "Wang, Xuan and Fitri bin Haris, Mohamad",
    title = "AI-Driven Violin Performance Evaluation: A Deep Learning Approach for Automated Assessment and Personalized Feedback in Music Education",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734941",
    doi = "10.1145/3734921.3734941",
    abstract = "Violin performance evaluation normally faces the difficulty of relatively low efficiency and reliance on personal experience in traditional music education. The study focuses on a deep learning automated system, combining an LSTM for temporal analysis for feature extraction of CNN. As well as datasets of the experiment collected 500 participants’ personalized feedback by artificial intelligence. It showed the model of CNN+LSTM that achieved a precision improvement with the error rate decreasing by 16.4\%. This study also considers Transformer-based models, such as Music Transformer and MERT, because they can model complex artistic expressions to meet new developments. And the future research will examine Transformer designs to improve the accuracy of feedback and the subtlety of song. Ultimately, the system can create flexible, objective, and adaptable programs in music education training.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "126–132",
    numpages = "7",
    keywords = "CNN-LSTM architecture, Deep learning, Music education technology, Personalized feedback, Violin performance assessment",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons106,
    author = "Lu, Yao and He, Sixuan and Zhong, Yuhan",
    title = "Research on the Application of AI Painting Technology in Mobile Commerce Design",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734924",
    doi = "10.1145/3734921.3734924",
    abstract = "With the rapid expansion of the mobile commerce industry, the demand for visual design has increased sharply, and the shortage of professional designer has become a bottleneck restricting the development of the industry. In order to solve this contradiction, this paper focuses on the application research of AI painting technology, especially through a series of computer optimization techniques to improve key links such as image preprocessing, model selection and output optimization, so as to better meet the unique needs of visual communication in mobile commerce. In this paper, the image preprocessing is divided into portrait, product and scene, which are classified according to the characteristics of the collected images, and then different LoRA models are trained to match the Checkpoint model to generate images that meet the characteristics of mobile commerce, thus improving the application efficiency and flexibility of AI painting. Through the selection and optimization of these technologies, AI painting technology can more effectively adapted to the production mode of mobile business design, thus improving the work efficiency of the industry, reducing the dependence on human resources, and providing new solutions for the development of the industry..",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "14–18",
    numpages = "5",
    keywords = "Design features of mobile commerce, Efficiency improvement, Image preprocessing",
    location = "",
    series = "GADM '25"
}

@inbook{cons107,
    author = "Zhang, Siyuan and Zhou, Wenjun and Wang, Yifan and Zhang, Quan and Peng, Bo",
    title = "MIFNetwork: Multi-scale Information Fusion Network for Long Traffic Prediction",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728726",
    abstract = "Traffic prediction is a critical task in the development of intelligent transportation systems (ITS) and smart cities. Current methods mainly rely on Spatial-Temporal Graph Neural Networks (STGNNs), which effectively capture spatial dependencies but require significant computational resources and limited to short-term forecasting. However, research on time-series data in the transportation field, particularly on sequence prediction across multiple time scales, remains underexplored. To leverage the multi-scale characteristics of time-series data, as well as its seasonal and periodic features, we introduce two solutions based on DLinear model: multi-scale decomposition and cross-scale information fusion, and propose a traffic prediction model named MIFNetwork. We conduct comparative experiments on several traffic datasets, selecting transformer-based models with strong time-series modeling capabilities for comparison. The results demonstrate that our model outperforms other approaches, especially in handling long time spans and complex trend changes.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "1–6",
    numpages = "6"
}

@inproceedings{cons108,
    author = "Chang, Can and Yao, Li and Zhao, Xiaojie",
    title = "TRCA-GAN: Tumor Representation Consistency Alignment for Cross-Subject Multimodal MRI Synthesis",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734939",
    doi = "10.1145/3734921.3734939",
    abstract = "Multimodal MRI synthesis is crucial for clinical diagnosis and treatment planning, particularly in glioma segmentation. However, cross-subject synthesis faces significant challenges due to the variability in brain structures and tumor morphology across individuals. Existing methods often fail to preserve tumor region fidelity, limiting their practical utility. To address these limitations, we propose the Tumor Representation Consistency Alignment Generative Adversarial Network (TRCA-GAN), a novel framework designed to enhance tumor region fidelity in cross-subject multimodal MRI synthesis. TRCA-GAN introduces two key innovations: the Region-Aware Perturbation Module (RAPM), which enhances tumor structure preservation through adaptive perturbation and joint attention mechanisms, and the Local Contrast Discriminator Module (LCDM), which improves tumor contrast fidelity via a dual physical-feature constraint mechanism. Extensive experiments on the BraTS2021 dataset demonstrate that TRCA-GAN significantly outperforms comparison methods in terms of image generation quality and tumor segmentation accuracy. The results highlight the effectiveness of TRCA-GAN in addressing the challenges of cross-subject MRI synthesis, making it a powerful tool for clinical applications.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "111–117",
    numpages = "7",
    keywords = "Brain tumor segmentation, Cross-subject multimodal MRI synthesis, Generative adversarial networks",
    location = "",
    series = "GADM '25"
}

@inbook{cons109,
    author = "Lv, Hao",
    title = "Aircraft Detection Based on Improved DETR",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728835",
    abstract = "With the wide application of deep learning in computer vision, Transformer-based target detection methods, especially DETR, have become a research hotspot. However, DETR still faces low detection accuracy and efficiency problems when dealing with small objects and complex backgrounds. In order to enhance the performance of DETR in aircraft detection, this paper proposes an aircraft detection method based on an improved DETR architecture, which mainly consists of two innovative improvements: first, an ECA attention mechanism is introduced after CNN feature extraction to enhance the model's adaptive learning ability for important features; second, Swin Transformer is used to replace the encoder in the original DETR -decoder structure in the original DETR, using its local windowing self-attention mechanism to improve the computational efficiency and accuracy of the model. The experimental results show that the method proposed in this paper improves the detection accuracy and speed compared with the traditional DETR in the aircraft detection task, especially in the complex background with better robustness and generalization ability. The research in this paper provides an effective improvement idea for the Transformer-based target detection method and provides new technical support for high-precision target detection tasks in practical applications.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "691–697",
    numpages = "7"
}

@inbook{cons110,
    author = "Wan, Xing and Johari, Juliana and Ruslan, Fazlina Ahmat",
    title = "Transformed Variational Color Shift Algorithm for Interfering Text Image Recognition",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728801",
    abstract = "One common data augmentation method used in text image recognition is color shift transformations. A widely used method is the Variational Color Shift (VCS), which can automatically predict a range of color shifts for each image. The algorithm has significant overfitting when applied to text images that are highly interfered with and contain noise, which hinders further improvements in text recognition accuracy. In this study, we submit a new transformed layer inside the VCS framework using cyclic boundary shifts over the text images. A new module, Transformed Variational Color Shift (TVCS) is proposed. This method integrates a generalized set of colors (the original dataset) in a manner that can transform the input dataset. The experimental results show that TVCS has superior recognition accuracy than VCS and has better robustness against interference. The algorithm proposed is innovative as the data augmentation of text images, especially in a noisy environment.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "486–490",
    numpages = "5"
}

@inbook{cons111,
    author = "Wang, Jingsi and Li, Xiaobin and Zhu, Pengyu and Chen, Zhuoyi",
    title = "Identification of personnel identity in unmanned aerial vehicle video gait recognition based on 3Dresidual network",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728782",
    abstract = "An improved adaptive 3D ResNet-18 residual network gait recognition method is proposed for the problem of recognizing people's identity in videos captured by UAVs. Using a combination of gait feature extraction and deep learning models, human silhouettes are separated from complex backgrounds for modeling, and their gait features are extracted for identification.3D ResNet-18 residual network learns spatio-temporal features to extract temporal and spatial features in the sequence of video frames and introduces a cross-entropy loss function to optimize the model and improve the prediction accuracy. When dealing with the challenges of motion blurring in the video captured by drones and shadows and noise interference in background modeling, the improved MOG2 background separation algorithm detects pedestrian gait and models it, and adaptive variance thresholding improves the background detection capability and improves the spatio-temporal feature extraction and optimization, which significantly improves the robustness of the model. The experiments use the Walking category in the KTH public dataset, and the results show that the model exhibits good recognition results in different backgrounds. This approach effectively improves the performance of UAVs in applications such as security surveillance.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "354–358",
    numpages = "5"
}

@inbook{cons112,
    author = "Yang, Chenming",
    title = "Three-Dimensional Path Planning for Unmanned Aerial Vehicles Based on a Hybrid Strategy of Dung Beetle Optimization Algorithm and Grey Wolf Optimization Algorithm",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728824",
    abstract = "This paper presents a novel UAV three-dimensional path planning method by integrating the Dung Beetle Optimization (DBO) algorithm and the Grey Wolf Optimization (GWO) algorithm. Aiming at the problems of traditional algorithms in UAV path planning, such as local optima trapping and low convergence accuracy, this hybrid algorithm combines the advantages of both algorithms. The Fuch and Logistic chaotic maps are used for population initialization to enhance the global search ability. During the optimization process, the DBO algorithm's strong local exploitation ability and the GWO algorithm's global search characteristics are coordinated. A B\'{e}zier curve is employed to smooth the planned path. Simulation results demonstrate that the proposed hybrid algorithm outperforms traditional algorithms in terms of path length, convergence speed, and path smoothness, validating its effectiveness in UAV three-dimensional path planning.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "626–631",
    numpages = "6"
}

@inbook{cons113,
    author = "Cai, Xinyu and Dai, Wenbo and Lu, Jingyu",
    title = "Loan Default Prediction Based on Machine Learning Approaches",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728813",
    abstract = "To address the credit risk losses incurred by commercial banks due to loan defaults, this study utilizes the loan default prediction dataset from the Alibaba Tianchi platform to develop machine learning models for predicting customer defaults, aiming to mitigate credit risk. Given the characteristics of class imbalance and high dimensionality of loan data, data preprocessing and exploratory data analysis are conducted. Based on a comparative analysis of various models, seven machine learning algorithms that demonstrate superior performance are selected for experimental comparison, including Decision Tree, Random Forest, AdaBoost, Bagging, XGBoost, LightGBM, and CatBoost. The results indicate that ensemble learning algorithms exhibit higher accuracy and predictive performance compared to single algorithms, with the CatBoost model performing best across various indicators, including AUC. The study identifies key features highly correlated with loan defaults, including loan grade, annual income, loan amount, credit history length, and debt-to-income ratio.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "557–564",
    numpages = "8"
}

@inbook{cons114,
    author = "Liu, Tingting and Li, Rongbin and Yin, Jun",
    title = "Color image authentication and encryption algorithm based on dual random phase encoding and dual chaotic system",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728735",
    abstract = "Initially, an improved piecewise Logistic chaotic map is proposed, which is combined with a novel four-dimensional hyperchaotic system to form a dual-chaos system. By introducing dual random phase encoding and leveraging the dual-chaotic system along with Arnold transformation, the authentication image is encrypted. The authentication and encrypted images are combined, and the dual-chaos system along with DNA dynamic encoding and computation methods are employed to perform encryption and decryption on the combined image, thereby achieving both image encryption and authentication. In the performance analysis of the encrypted images, the algorithm proposed in this paper not only provides authentication functionality but also demonstrates strong security, with advantages such as high decryption quality and fast encryption speed. Furthermore, its authentication feature makes it suitable for most encryption scenarios.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "58–65",
    numpages = "8"
}

@inbook{cons115,
    author = "Yuan, Yufeng and Han, Peng and Qiu, Jian and Liu, Dongmei and Peng, Li and Chen, Miao and Luo, Kaiqing",
    title = "SLP-SLAM: A Multifeature Fusion Stereo SLAM Based on Structural Lines and Structural Planes",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728834",
    abstract = "Accurate positioning and pose estimation of mobile robots in structured environments have persistently presented considerable challenges. This paper proposes SLP-SLAM, a multifeature fusion stereo simultaneous localization and mapping (SLAM) system that combines both structural lines and structural planes. We have enhanced the effectiveness of the method for extracting structural lines using the Manhattan World Assumption (MWA) and have suggested utilizing these lines to construct structural planes, which is different from the existing plane extraction methods. Furthermore, we develop the state estimator by minimizing the visual residuals of points, structural lines, and structural planes. As far as we know, this represents the inaugural stereo SLAM that concurrently employs points, structural lines, and structural planes for integrated optimization. An appraisal of our system on difficult public datasets has been conducted. The trajectory error associated with SLP-SLAM has been diminished by 15\% in comparison to contemporary state-of-the-art (SOTA) SLAM.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "685–690",
    numpages = "6"
}

@inbook{cons116,
    author = "Guo, Penggang and Liu, Yunfan and Li, Longfei and Liu, Changyuan",
    title = "Improved Semantic Segmentation of Urban Road Scenes with Deep Dual-Resolution Network",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728732",
    abstract = "In response to the requirements for efficiency and accuracy in segmentation models in autonomous driving scenarios, an improved urban road semantic segmentation algorithm based on the Deep Dual-Resolution Network (DDRNet) has been proposed. Firstly, a Channel Residual Attention Module (CRAM) based on standard attention mechanisms is introduced at the end of two parallel branches of the DDRNet to focus on important channel features. Secondly, the backbone network incorporates Depthwise Over-parameterized Convolution (DO-Conv) to boost feature extraction performance. Finally, a Deep Aggregation Pyramid Pooling Module (DAPPM) with Hybrid Dilated Convolution (HDC) is designed to capture multi-scale feature information, and Group Normalization (GN) is utilized to mitigate the impact of reduced batch size. The experimental results demonstrate that the proposed method achieves a Mean Intersection over Union (MIoU) of 77.0\% on the Cityscapes dataset, representing an improvement of 1.1\% over the baseline model. Additionally, the segmentation speed reaches 106 Frames Per Second (FPS), achieving an optimal balance between segmentation accuracy and computational efficiency.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "37–42",
    numpages = "6"
}

@inbook{cons117,
    author = "Li, Chengxuan and Yang, Wei and Sun, Chang",
    title = "UVD-ATrack: UAV-based Vehicle Detection and Adaptive Tracking",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728831",
    abstract = "In recent years, the increasing number of vehicles has led to heightened traffic congestion. Traditional surveillance is limited to monitoring fixed locations. However, unmanned aerial vehicle (UAV) photography provides advantages such as convenience and a wide perspective, gradually replacing these conventional techniques for traffic video collection. Nonetheless, challenges including complex scenes, varying scales and frequent occlusions result in issues such as false positives, missed targets, and identity switches (IDSW). To tackle these, we developed the UVD detection algorithm based on YOLOv8-n and the AByteTrack tracking algorithm derived from ByteTrack. The integration of these two components forms the UVD-ATrack algorithm. In the backbone of the detection section, we introduced the RFAConv and designed RF\_C2f to enhance feature extraction capabilities. For the neck component, the adaptive weight fusion module (AWFM) was developed to effectively combine multi-scale local information. During the tracking phase, we optimized the motion model. Additionally, camera motion compensation (CMC) was implemented to adaptively mitigate the effects of sharp perspective changes. Test results utilizing the Visdrone dataset indicate that mAP@0.5 and mAP@0.5:0.95 improved by 4.4\% and 3.6\% respectively in the detection section. In the tracking test, IDF1, HOTA, MOTA and MOTP also exhibited significant enhancement while IDSW decreased by 77\%. Compared with state-of-the-art methods, our proposed algorithm demonstrates exceptional performance.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "673–679",
    numpages = "7"
}

@inbook{cons118,
    author = "Wu, Chunyang",
    title = "Pneumonia Detection and Classification Using Lightweight ShuffleNetV2 Based on Transfer Learning",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728823",
    abstract = "Pneumonia, a severe respiratory infection, is commonly caused by either viral or bacterial pathogens. Timely identification of pneumonia is essential for effective patient care and treatment. Chest X-ray imaging is widely utilized for both diagnosing and detecting pneumonia, though interpreting these images presents certain difficulties. This research leverages transfer learning to evaluate and compare the performance of various convolutional neural networks (CNNs) in the context of chest X-ray image classification and detection. The results of the experiment demonstrate that the lightweight ShuffleNetV2 model excels in minimizing computational burden and memory consumption, while preserving high accuracy and effectiveness in classification tasks.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "621–625",
    numpages = "5"
}

@inbook{cons119,
    author = "Tian, Jihao and Wei, Yan",
    title = "Sleep Spindle Auto Detection Based on U-Net with Label Optimization Module",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728786",
    abstract = "The automatic spindle detection algorithm based on deep learning technology requires high consistency of sleep spindle annotation, which crowdsourcing can significantly enhance through collective intelligence. To best of our knowledge, few studies have explored auto detection of sleep spindles based on crowdsourced datasets. MODA is the only crowdsourcing spindle annotation open access dataset until now, and this study utilized the MODA dataset to further enhance the automatic detection of sleep spindles using conventional neural network (CNN) and innovative label optimization module. To evaluate our model, we proposed and conducted two analysis methods including analysis by sample-event and by subject. Meanwhile, to validate our performance of our model, SUMO and EXP were considered as control and gold standard methods respectively; and various metrics related to by sample-event and by subject were compared among our model, SUMO and EXP. The results from analysis by sample-event showed that F1 score, Matthew's correlation coefficient (MCC), and Cohen's Kappa coefficient in our model were significantly higher than in SUMO under all overlap thresholds. Specifically, under a higher threshold of 0.6, F1, MCC and Kappa reached 0.82, 0.81, 0.81 in our model, 0.75, 0.74, 0.74 in SUMO, respectively. For analysis by subject, all spindle features extraction of our model were comparable to the EXP, including density (4.48 in our model vs 3.80 in EXP), duration (0.79 vs 0.84), amplitude (29.91 vs 30.09) and frequency (13.04 vs 12.92). However, the spindle density extracted by SUMO was significantly different from EXP (9.04 in SUMO vs 3.80 in EXP). In conclusion, our results suggested that the crowdsourced public dataset and label optimization module can further enhance the spindle detection capability of the convolutional neural network.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "382–391",
    numpages = "10"
}

@inbook{cons120,
    author = "Li, Wang",
    title = "Improvements to the Apriori Algorithm and Its Application in Educational Decision-Making Systems",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728784",
    abstract = "The Apriori algorithm is among the traditional algorithms that are mainly employed to mine the educational data. Regrettably, the Apriori algorithm is not only the most classical algorithm, but also has some weaknesses, for instance, it has high computational complexity, generates too many candidate itemsets, which in turn leads it to be mainly used in small-scale educational data scenarios only. In this paper, the authors propose a modified version of the Apriori algorithm which aims to the rule generation process and the computational operation more efficient through data preprocessing phase information improvement and using the dynamic thresholding adjusting component as well as a not-so-well-known intelligent technique. The usefulness of the improved algorithm is tested by an experiment with actual course performance assessments, and the algorithm is also applied in the educational decision support system which comprises the course recommendation, teaching strategy optimization, and academic risk prediction the students. The results of the study suggest that there are no gains in script execution speed, generalization rate, or memory usage while there are with great advantage in the run time of the proposed algorithm. Consequently, the proposed algorithm is superior to the traditional one as it provides higher efficiency and thus, could be the best choice for educational data mining.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "367–373",
    numpages = "7"
}

@inbook{cons121,
    author = "Zuo, Mengxue",
    title = "Infringement and Protection in Personal Information on Data Mining",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728797",
    abstract = "Different from the personal information processing stage such as collection and analysis, the infringement of personal information by Data Mining is based on the mining process and mining results. On the basis of analyzing the operation mechanism and technical characteristics of Data Mining, there are four forms of infringement of personal information Data Mining. Specific manifestations are as follows: manifested as data labeling and unfavorable evaluation, information cocoons and passive autonomy, social sorting and data discrimination, information association and personal privacy infringement. The automatic decision-making and black box of Data Mining, the constructiveness and hiding of mining infringement behaviors, and the difficulty and challenge of infringement results pose the challenges and shortcomings of the current infringement law of personal information Data Mining in China. Finally puts forward the path to improve the legal protection of personal information, that is introducing the rules of due process, restricting the data power of Data Mining organizations, and establishing channels and procedures for effective interaction between Data Mining organizations and subjects of personal information.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "459–465",
    numpages = "7"
}

@inproceedings{cons122,
    author = "Chen, Lulu and Xu, Feifei",
    title = "Based on Consistency Prototype Learning and Multi-knowledge Distillation for Few-Shot Continual Relation Extraction",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734935",
    doi = "10.1145/3734921.3734935",
    abstract = "Few-Shot Continuous Relation Extraction (FSCRE) has been plagued by issues such as overfitting, catastrophic forgetting, and feature distortion. This paper proposes a few-shot incremental relation extraction model based on consistency prototype learning and multi-layer knowledge distillation. The model consists of data augmentation, consistency prototype learning, and dual-layer knowledge distillation. First, data augmentation is applied to the training data to alleviate common overfitting problems in few-shot scenarios. Second, consistency prototype learning is utilized to regularize the embedding space and address feature distortion. Additionally, a dual-teacher model for knowledge distillation is designed to prevent catastrophic forgetting of previously acquired knowledge. Experiments conducted on the TACRED dataset show that after completing all tasks under the 5-way-5-shot setting, accuracy improved by 2.22\%. Our model significantly outperforms other baseline methods, validating the effectiveness of our proposed approach.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "84–88",
    numpages = "5",
    keywords = "Incremental learning, Incremental relation extraction, Knowledge distillation",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons123,
    author = "Liu, Rongrong and Idzwan bin Ismail, Adzrool and Lu, Ye",
    title = "Research on Enhancing the Generalization Ability of Generative AI Based on K-means Clustering Algorithm: Text-to-Image Task for Wind-Responsive Passive Building Facade",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734943",
    doi = "10.1145/3734921.3734943",
    abstract = "In recent years, as AI has grown fast, generative AI has been used a lot in building design.But when generative AI tries to create Wind-Responsive Passive Building Facades, it doesn't understand the moving look of the facade very well. This makes it bad at telling the important features and not good at working with different design cases.This study tries to make generative AI better at designing Wind-Responsive Passive Building Facades by using the K-means clustering algorithm.First, this study built a dataset with facade images, weather conditions, material types, and size info. Then, using the K-means clustering algorithm, we picked out key features and grouped the buildings by type. The goal is to give generative AI a better kind of visual data to learn from.Based on that, we made a three-level prompt structure to help generative AI work better with different design tasks.This study not only builds a clear method between finding building features and making prompts, but also gives ideas and steps for using generative AI more in sustainable building design.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "140–148",
    numpages = "9",
    keywords = "Architectural Design, Generative AI, K-means Clustering, Prompt Optimization, Wind-Responsive Passive Building Facade",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons124,
    author = "Li, Jiarui and Zhou, Chen and Li, Yutong and Wei, Xiong",
    title = "AI-Driven VR Design: Design of an Educational Game for Aesthetic Ambience in Ancient Chinese Poetry",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734922",
    doi = "10.1145/3734921.3734922",
    abstract = "The present study proposes a new approach to enhancing students' comprehension of the mood in classical Chinese poetry. The new approach integrates artificial intelligence and virtual reality (VR) technology for the development of an interactive VR learning game. The use of AI facilitates the development of a picture library that is thoughtfully crafted to match the distinctive linguistic and thematic characteristics inherent in classical poetry. This machine-generated system creates atmospheric drawings with respect to the text of the poem, giving designers a series of idea visualisations. The drawings are utilized as a basis for the subsequent design of VR scenes, in which sensory experiences and avatars are employed to immerse the user in the poetic environment. The system takes full advantage of user interactivity and imagination, providing an active platform for exploring poetic moods. The integration of virtual reality and artificial intelligence in this study is of paramount importance in enhancing the instruction of classical poetry, developing deep cultural affinities, and promoting the continuation and innovation of classical Chinese culture and poetry.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "1–6",
    numpages = "6",
    keywords = "Chinese classical poetry, and virtual reality, interactive design, spatial perception",
    location = "",
    series = "GADM '25"
}

@inbook{cons125,
    author = "Han, Zijian and Hou, Changbo",
    title = "Multimodal Knowledge Graph Inference Method Based on Cross-Attention Mechanism",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728740",
    abstract = "Existing multimodal knowledge graph reasoning methods often rely on simple weighted averaging or attention mechanisms for multimodal feature fusion, which frequently results in the loss of modality-specific information and fails to fully exploit the complementary relationships between modalities. To address these issues, this paper proposes a multimodal knowledge graph reasoning method based on a cross-attention mechanism. The model employs the BERT model to encode textual information, introduces a VGG-16 model with a multi-scale attention module to encode visual information, and utilizes a graph attention mechanism to extract the structural information of the knowledge graph. Additionally, a contrastive learning framework is introduced to reduce semantic inconsistencies between modalities, and a cross-attention mechanism is used to achieve dynamic feature fusion across modalities. To validate the effectiveness of the proposed model, comparative experiments were conducted on the FB15k-237 and DB15K datasets. The results show that the proposed model significantly outperforms existing benchmark models on key evaluation metrics such as MRR, Hit@1, Hit@3, and Hit@10, demonstrating its effectiveness and robustness in multimodal knowledge graph reasoning.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "94–100",
    numpages = "7"
}

@inbook{cons126,
    author = "Ma, Xuening and Chen, Xin and Yuan, Chunhong",
    title = "Crossroads of AI and Tourism: Enhancing Destination Management and Traveler Engagement",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728731",
    abstract = "The swift progression of artificial intelligence (AI) technology is transforming the tourist industry by redefining decision-making processes, augmenting operational accuracy, and elevating user experience. This study examines the transformative influence of AI through a comprehensive analysis of its application in destination management and traveler engagement. This study combines traditional survey methods with advanced heatmap analysis to reveal the complex impact of AI on traveler behavior, preferences, and decision-making efficiency. The results indicate that AI-powered tailored suggestions, and predictive analytics markedly improve customer satisfaction and decision-making, while optimizing operational procedures for tourism enterprises. The study emphasizes the necessity for more algorithmic transparency and trust-building measures to alleviate visitors' apprehensions regarding fairness and relevance. This research integrates theoretical frameworks with practical applications, offering significant insights for enhancing AI systems to foster innovation and growth in the tourism sector.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "31–36",
    numpages = "6"
}

@inbook{cons127,
    author = "Zhu, Qifei and Tang, Jiangang and Cao, Haoshun",
    title = "An Improved LSTM Crime Prediction Model Based on Environmental Factors",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728816",
    abstract = "Crime prediction serves as a fundamental basis for preventing crime, maintaining social stability, and ensuring public safety. Current crime prediction models commonly suffer from issues such as low accuracy, unstable predictions, or weak generalization capabilities. Therefore, we constructed an improved LSTM crime prediction model based on environmental factors, integrated the data of various environmental factors such as economy, culture and climate, improved the LSTM network structure and optimization method, and enhanced the prediction ability of crime in the region. Empirical evidence shows that the MAPE predicted by the model is 0.0491 and R2 is 0.9229. Compared with the traditional model, the accuracy, stability and generalization ability of the prediction are significantly improved, which can provide a basis for the formulation of crime prevention and control strategies, improve the level of social security management, and promote social stability.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "577–584",
    numpages = "8"
}

@inproceedings{cons128,
    author = "Zhang, Shizhan and Liu, Sheng and Wang, Shijie and Du, Sidan",
    title = "Prediction of future action start in untrimmed videos based on diffusion",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734940",
    doi = "10.1145/3734921.3734940",
    abstract = {In recent years, Online Detection of Action Start has attracted considerable interest owing to its diverse applications in areas like healthcare and smart transportation. However, the inherent limitation of detection tasks—"detection can only occur after an event has happened"—prevents us from obtaining responses and issuing warnings before certain events, particularly emergencies, occur. In order to mitigate this constraint, this paper introduces the Prediction of Action Start (PAS) task based on ODAS. The PAS task aims to predict the start times and categories of future actions (if any) in untrimmed streaming videos containing substantial background footage, based on recently observed video information. Our\&nbsp;experimental results on two standard datasets demonstrate that the proposed prediction method even outperforms some current action detection methods.},
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "118–125",
    numpages = "8",
    keywords = "Action Start, Generative Models, Prediction",
    location = "",
    series = "GADM '25"
}

@inbook{cons129,
    author = "Wang, Jie and Tong, Xinyu and Ma, Xiaoya and Kong, Mengying and Zhang, Haifei and Yuan, Hailei",
    title = "A recommendation algorithm model based on the fusion of group behavior and temporal feature",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728809",
    abstract = "With the rapid development of the Internet and the exponential growth of network information resources, how to help users quickly obtain valuable information has become a major challenge. As the key technology of this problem, recommendation algorithm has become an important tool in the information age. However, most existing recommendation systems, such as traditional deep learning recommendation algorithms, still have problems such as cold start of new users and improper handling of dynamic changes in user behavior. To solve these problems, this paper proposes a fusion Group behavior characteristics and time series characteristics of the recommendation algorithm model Group-Temporal Recommendation Fusion (GTRF). Based on deep learning algorithm, the model extracts group behavioral characteristics by using graph attention network to deal with the problem of cold start, obtains time series characteristics by using gated convolution and GRU to deal with the problem of dynamic changes in user behavior, and finally uses cross-attention mechanism to effectively integrate these two types of features to achieve high-precision prediction of recommended content. GTRF not only solves the problems such as cold start of new users and dynamic change of user behavior, but also significantly improves the comprehensive performance of recommendation algorithm, showing the indispensable and great potential of recommendation algorithm in information retrieval.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "532–537",
    numpages = "6"
}

@inbook{cons130,
    author = "Ding, Yuze and Zhang, Shibin",
    title = "Dynamic Semantic-Constrained Adversarial Training and Defensing: A Reinforcement Learning Framework for LLM-Generated Fake Information Detection",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728762",
    abstract = "With the development of Large Language Models (LLMs) such as DeepSeek and GPT-4, the cost of generating false information has decreased dramatically, making detection more difficult to recognize. Traditional approaches, such as GPT-4o and chain-of-thought (CoT) frameworks, having low accuracy or efficiency. To better solve these problems, this paper introduces Dynamic Semantic Structure Rule Constrained Adversarial Training (DSC-AT), which uses balanced semantic fidelity and steganography to enhance adversarial sample optimisation, achieving an 82\% deception rate. Meanwhile, the Semantic-Robust Unified Architecture (SRUA) scheme integrates text classification layer, logical verification layer and uncertainty detection layer to improve accuracy. Besides, to better train the model, we provide the Content Reinforcement Learning-based Tactical Adversarial Defence (RL-TAD) model simulates the interaction between the attacker and the defender, improves the training strategy by using backpropagation descent. Experimental results show that contrast to CoT, SRUA improves the detection accuracy to 92.1 percent and reduces the false alarm rate by 65 percent, which provided an efficient and flexible solution for identifying LLM-generated misinformation.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "237–241",
    numpages = "5"
}

@inbook{cons131,
    author = "Fu, Lin",
    title = "A Method for Discovering Ancient Chinese Neologisms Based on the Combination of Information Entropy - Mutual Information and BI-LSTM-CRF Model",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728745",
    abstract = "Traditional new word discovery often relies on the information entropy-mutual information (IM) algorithm. In this study, we propose a joint IM algorithm and bidirectional long short-term memory conditional random field (BI-LSTM-CRF) neural network model, referred to as IM-BI-LSTM-CRF. This model retains the advantages of the IM algorithm while leveraging the BI-LSTM model to capture contextual dependencies and the CRF layer to model label dependencies. Using this hybrid approach, we conducted new word discovery experiments on a self-annotated dataset, utilizing word embedding vectors and different word position annotation sets. The results demonstrate that the IM-BI-LSTM-CRF model surpasses traditional LSTM and BI-LSTM models in new word discovery and exhibits strong generalization capabilities.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "125–131",
    numpages = "7"
}

@inbook{cons132,
    author = "Wan, Guofeng",
    title = "Research and Application of Generalized Predictive Control Algorithm in ATO System",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728807",
    abstract = "Aiming at the safety guarantee of the train in the process of operation, whether it can arrive on time and comfort in the process of riding. In this paper, generalized predictive control algorithm is applied to automatic train operation system. First of all, the structure and function of the ATO system of the train are studied and analyzed, and then the force analysis of the train operation is carried out and the transformation of each working condition is understood and the situation is applicable. Secondly, the GPC algorithm is studied in detail, and its prediction model, rolling optimization and online identification are recognized respectively, and the train speed controller is designed. Finally, the ATO system is simulated and designed based on GPC algorithm, and the train model is analyzed. Moreover, it can be verified by simulation that under the GPC algorithm, the train can track the set target curve well during operation, ensuring the safety, comfort, energy saving and accuracy of the train operation.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "522–525",
    numpages = "4"
}

@inbook{cons133,
    author = "Yao, Xiongfei",
    title = "Demand Forecasting for Cross-border Retail Commodities in the New Retail Era: A Hybrid Model Integrating Temporal Granularity and Categorical Dynamics",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728803",
    abstract = "Through the lens of the Temporal-Synergic Cross-Correlation (TSCC) framework, this study fills important gaps in cross-border demand forecasting. Overall, analyzing 9,754 transactions (2022–2024) our approach captures multi-scale temporal decomposition synergized with SHAP-based feature engineering and outperforms the LSTM-RF hybrids by 22\% precision and discovers 14.7\% YoY revenue growth. Notably, the innovations tackled temporal-categorical disconnects and 92\% holiday prediction precision — 18.4\% on global metrics. The framework bridges theoretical models and operational logistics, harvesting trials and errors to overcome cross-border commerce lead-time preserves.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "498–504",
    numpages = "7"
}

@inbook{cons134,
    author = "Sun, Fuyue",
    title = "The Fan Anomaly Detection Method Based on an Improved CBAM Attention Mechanism with MobileNetV3",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728796",
    abstract = "In factories, fans is an important part in production. However, how to ensure the safe and stable operation of it is always a difficult problem. In order to solve this problem, this study presents a fan anomaly detection method based on an improved CBAM attention mechanism using the MobileNetV3-Small model. In this model, the conventional SE module is replaced with an optimized CBAM, which uses dilated convolutions to enhance the model's sensitivity to anomalous sounds. At the same time, the model incorporates CutMix and Focal Loss as the loss function, further improving the model's robustness to imbalanced data. Additionally, to strengthen the nonlinear representation capacity of the architecture, we implement CELU activation functions as substitutes for conventional ReLU units within residual modules. According to experimental results, we can find that the proposed model achieves a classification accuracy of 97\% in a -6dB noise environment, which is an improvement of 1.07 percentage points over the original MobileNetV3 model, demonstrating the effectiveness of this approach in fan anomaly detection.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "453–458",
    numpages = "6"
}

@inbook{cons135,
    author = "Yi, Jingyuan and Xu, Zeqiu and Huang, Tianyi and Yu, Peiyang",
    title = "Challenges and Innovations in LLM-Powered Fake News Detection: A Synthesis of Approaches and Future Directions",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728739",
    abstract = "The pervasiveness of the dissemination of fake news through social media platforms poses critical risks to the trust of the general public, societal stability, and democratic institutions. This challenge calls for novel methodologies in detection, which can keep pace with the dynamic and multi-modal nature of misinformation. Recent works include powering the detection using large language model advances in multimodal frameworks, methodologies using graphs, and adversarial training in the literature of fake news. Based on the different approaches which can bring success, some key highlights will be underlined: enhanced LLM-improves accuracy through more advanced semantics and cross-modality fusion for robust detections. The review further identifies critical gaps in adaptability to dynamic social media trends, real-time, and cross-platform detection capabilities. Future directions underline the development of style-agnostic models, cross-lingual detection frameworks, and robust policies with a view to mitigating LLM-driven misinformation. This synthesis thus lays a concrete foundation for those researchers and practitioners committed to reinforcing fake news detection systems with complications that keep on growing in the digital landscape.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "87–93",
    numpages = "7"
}

@inproceedings{cons136,
    author = "Wang, Shuo and Lu, Yuqi and Luo, Ruijue and Li, Boxuan and Zhang, Yingjie and Xiao, Liang",
    title = "A BERT-based sentiment analysis model for depressive text",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734934",
    doi = "10.1145/3734921.3734934",
    abstract = "Depression is a big public health problem around the world. Like the traditional methods of screening, clinical assessments, and self-rating scales are among the limits. These methods are based on the subjectivity of patient reports and the experience of doctors and clearly can have bias. In addition, they do not permit real-time monitoring of changes in mood. For this reason, this field of mental health is challenged with accurately and efficiently detecting probable mood changes in individuals at risk for depression. To resolve these challenges, we then propose a BERT-based sentimental analysis model adapted for depression-related text. Current methods for screening for traditional depression and established sentiment analysis models are hindered by data scarcity, data imbalance, and the problems of deriving emotional changes in a dynamic and clean manner. To leverage the strengths of BERTs in our model, we train the last layer of BERTs and then construct a classification layer tailored to the depressive emotion, which is more sensitive to the semantic information of the mood. Moreover, we also present data augmentation in its simplest form, which is the rearrangement of positive samples to increase the diversity of samples while still preserving the semantic meaning. To tackle data imbalance, we introduce a dynamic weight mechanism to the BCEWithLogitsLoss function by adjusting the weight of the positive samples with data distribution. The model effectively captures the complex emotional changes by combining global and local semantic dynamic representations. In our empirical study, we analyze the open-source dataset of interview transcripts of 162 volunteers. Our model is evaluated using the experimental results, and the precision, the recall rate, and the F1 score obtained are 0.667, 0.667, and 0.667, respectively. Our model has achieved 2.62 higher in terms of precision and F1 score as compared to the existing models. The results indicate that our model provides a big benefit in identifying screened individuals at risk for depression.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "76–83",
    numpages = "8",
    keywords = "BERT model, Depression screening, medical text processing, sentiment analysis, text classification",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons137,
    author = "Wei, Han and Qu, Dan and Zhang, Wenlin and Niu, Tong and Peng, Sisi and Guo, Zhigang",
    title = "Recommendation Algorithm Based on Large Language Model: Consideration on Algorithm Governance and User Rights Protection",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734930",
    doi = "10.1145/3734921.3734930",
    abstract = "With the rapid development of big data and artificial intelligence technology, recommendation systems play a crucial role in improving user experience, increasing platform revenue, and optimizing content distribution. However, the wide application of recommendation system also brings about problems such as filter bubble, algorithm black box, labor rights protection, the big data-enabled price discrimination and so on. By processing massive data, the large language model can accurately construct and predict user interests and preferences, process and generate diverse content, thus improving the relevance and fairness of recommendation, enhancing the diversity and transparency of recommendation system, protecting the rights and interests of workers, preventing price discrimination, and realizing algorithm governance and the protection of user rights and interests. This paper designs a recommendation algorithm framework based on a large language model, aiming to build a fair and transparent recommendation system, which can reduce information bias, improve the transparency of the list, protect the rights and interests of workers, prevent price discrimination, and promote social equity.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "52–57",
    numpages = "6",
    keywords = "Algorithm governance, Large language model, Recommendation algorithm, User rights and interests",
    location = "",
    series = "GADM '25"
}

@inproceedings{cons138,
    author = "Sun, Hanwen and Cui, Jiale and Meng, Dezhi",
    title = "The method of cultural product design and translation in Henan region under the intervention of artificial intelligence technology",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734923",
    doi = "10.1145/3734921.3734923",
    abstract = {This study examines the potential of regional cultural creative design in enhancing the effectiveness of cultural communication and interactive experience through deep cultural translation, with a particular focus on integrating cutting-edge computer technology. China's Henan Province is used as a case study to examine the contemporary expression and application of traditional cultural elements in cultural creative product design. The study reports the use of Generative Adversarial Networks (GAN) and Variational Autocoders (VAE) in artistic style extraction from a large number of datasets and generating innovative images with regional cultural features. The study draws from cultural anthropology's "Three Elements of Culture Theory" in examining the material, organizational and spiritual dimensions. The study identifies three methods of cultural translation: direct translation, consecutive translation, and indirect translation. The study utilizes these frameworks in examining innovative solutions to expressing Henan's regional culture in modern cultural products. It demonstrates how to achieve cultural dissemination and inheritance and enhance cultural identity and global influence in the context of globalization. The study also examines the potential of AI-based image generation in cultural creative design, thus offering a new framework for perceiving and examining the role of computer technology in cultural translation and innovation.},
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "7–13",
    numpages = "7",
    keywords = "Cultural and creative, Cultural translation, Henan culture, Regional",
    location = "",
    series = "GADM '25"
}

@inbook{cons139,
    author = "Li, Yang and Chen, Chi and Li, Yong",
    title = "Pos-PCFG: A Password Guessing Method Incorporating Character Positions",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728829",
    abstract = "Due to its easy-to-use characteristic, passwords are still the main way to authenticate a person online. However, as the increasing number of websites, users now often come across the issues of password overload. Such repeated use of one's passwords or choosing simple passwords such as names or dates could lead to serious security risks. Password-guessing simulations could effectively prevent these vulnerabilities. Nowadays, most modern websites request passwords with special characters to enhance their complexity. This study emphasizes the special characters within passwords. By using t-SNE visualization and KL divergence, we have analyzed the distribution of these characters among different passwords visually and quantitatively. As the result shows, special characters present a unique distribution mode in t-SNE visualization, with a higher KL divergence value than alphabetic and digit segments. Based on our findings, a password-guessing approach that classified the special character segments into four types according to the position named the Pos-PCFG model has been proposed. The model has improved the guessing accuracy of multiple datasets. In the Rockyou dataset test, accuracy was achieved with a notable 0.98\% increase when guessing passwords consisting of special characters.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "659–666",
    numpages = "8"
}

@inproceedings{cons140,
    author = "Ye, Jianbing and Lin, Chaowen and Li, Qi",
    title = "Line Detection Based on Hough Transform and its Application",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728774",
    doi = "10.1145/3728725.3728774",
    abstract = "Line detection is an important task in computer vision, which is widely used in fields such as automated driving and remote sensing image processing. As a classical image processing method, Hough transform has strong robustness and anti-interference ability in line detection. In this paper, line detection based on Hough transform is implemented and accelerated to hardware implementation on High-Level Synthesis (HLS) platform. By performing edge detection on the input image, the Hough transform maps the image from Cartesian space to parameter space to detect line features in the image. Experimental results show that the method can accurately detect lines in the image while exhibiting strong noise rejection. The implementation not only improves the efficiency of line detection, but also provides an effective solution for hardware acceleration applications based on the Hough transform.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "307–311",
    numpages = "5",
    keywords = "Edge Detection, Hardware Acceleration, High-Level Synthesis, Hough Transform, Line Detection",
    location = "",
    series = "GAIIS '25"
}

@inbook{cons141,
    author = "Li, Shulei and Meng, Bo and Wang, Dejun",
    title = "Event Extraction Methods for Government Hotline Domains",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728826",
    abstract = "Event extraction for government hotlines is crucial for improving scheduling efficiency and optimizing resource allocation, but varying text lengths and diverse event types increase the extraction difficulty. To this end, we propose a method that fuses the spanning mechanism with machine reading comprehension to first extract trigger words and predict event types, and then extract event arguments using customized problem templates. Experimental results show that the method outperforms traditional methods in terms of precision, recall, and F1 value, and can effectively identify public service demands and emergency events, providing support for government information integration and decision optimization.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "643–647",
    numpages = "5"
}

@inbook{cons142,
    author = "Li, Chan and Guo, Wenjing and Qin, Jikai",
    title = "Backward automatic screening feature selection algorithm based on multi-evaluation criterion fusion",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728781",
    abstract = "In view of the tedious problem that the feature selection algorithm based on multi-evaluation criterion fusion needs to manually set the feature threshold repeatedly to obtain the optimal feature subset, a backward automatic selection feature selection algorithm based on multi-evaluation criteria fusion is proposed in this paper. In this algorithm, the feature evaluation value is calculated using multi-evaluation criteria fusion algorithm, then the discrimination performance of Support Vector Data Description (SVDD) is used as the screening criterion, and finally the optimal feature subset is obtained by backward automatic screening algorithm. The experimental results show that the feature selection algorithm has the advantages of automatic screening, noise robust, clutter robust, low feature dimension, high discrimination rate and low deterioration of discriminative performance for small sample problems.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "347–353",
    numpages = "7"
}

@inbook{cons143,
    author = "Sun, Minghai and Cheng, Yufan",
    title = "Research and application of K-means clustering based on the color characteristics of woodblock prints of Zhuxianzhen",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728778",
    abstract = "Objective This study aims to quantitatively analyze the color composition of woodblock prints of Zhuxianzhen, explore its color combination patterns, and provide a theoretical basis for the color design of cultural and creative products, so as to more accurately inherit and present the visual characteristics of this traditional Chinese folk art. Methods In this study, K-means clustering algorithm is used to extract color features from selected sample images of woodblock prints of Zhuxianzhen, and a color association network model based on the priority of the main color is constructed by calculating the proportion of color distribution and its combination frequency. Based on the results of the analysis of the color matching law of this model, the practice of innovative visual design and cultural and creative product development of Zhuxianzhen woodblock prints is carried out. Conclusion The results of the research present the color matching and color matching law of Zhuxianzhen woodblock prints in the form of icons, which can reflect the color characteristics of Zhuxianzhen woodblock prints in a more objective way, provide the designers with scientific and rich color matching solutions, improve the efficiency of designers' work, and at the same time, promote the re-design application of the traditional Chinese folk art.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "332–336",
    numpages = "5"
}

@inbook{cons144,
    author = "Jin, Yujun and Luo, Tao",
    title = "DPRS: Distributional Perspective Modeling for LLM-Enhanced Recommendation Systems",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728749",
    abstract = "Existing recommender systems mainly rely on ID embedding to model user behavior sequences. However, this approach ignores the large amount of semantic information embedded in the textual descriptions of items, resulting in low performance. The ability to utilize large-scale language models to understand and reason about textual content offers a promising avenue for recommender system development. To this end, we propose a recommender system model, DPRS, which models textual representations of large-scale language models from a data distribution perspective and incorporates them into traditional recommendation models. We utilize pre-trained LLMs as item encoders to introduce textual representations to the recommender system. To address the heterogeneity between the LLM representations and the original recommender system, we propose to model user behavior sequences from a data distribution perspective by converting them into similarity score sequences. By conducting experiments on two public datasets, we verify the superiority of the proposed model.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "152–156",
    numpages = "5"
}

@inbook{cons145,
    author = "Han, Ze and Su, Yu and Mo, Qi and Nie, Xinyu",
    title = "Neural Network Student Cognitive Diagnosis Model Based on Multi-Relational Graph",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728806",
    abstract = "The Internet has enabled online learning to become an important means for students to acquire knowledge, and student cognitive diagnosis models have played a key role in this process. These models can evaluate students' learning behaviors and knowledge mastery, providing support for personalized learning. Unfortunately, traditional models have their limitations when dealing with complex relational data related mainly to the relationship between students and problems, while the characteristics as well as potential relationships among students are almost left neglected. In response, this paper proposes a Neural Network Student Cognitive Diagnosis Model Based on Multi-Relational Graph (MGNCD) that brings together the powers of Graph Attention Network (GAT) and Relational Graph Convolutional Network (RGCN) to model multi-dimensional heterogeneous nodes such as students, classes, problems, and skills. The introduction of various edge types and random edge connection strategies allowed the model to tackle data sparsity and heterogeneity. Experimental results indicate that the proposed model outperforms traditional methods in accuracy (ACC) and area under the curve (AUC), which provides an encouraging novel insight into cognitive diagnosis.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "515–521",
    numpages = "7"
}

@inbook{cons146,
    author = "Liu, Yang and Jin, Guanghu and Zhang, Jinji and Xue, Xiyue",
    title = "Green quality perception of urban streets: a study combining semantic segmentation and multimodal noise enhancement techniques",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728800",
    abstract = "In recent years, the quantitative analysis of the green quality of urban streets has become a hot spot in the cross-research of computer vision and urban environment. In this paper, we propose a semantic segmentation method based on a dynamic multimodal noise addition technique combined with the SegFormer model to improve the robustness of street view image segmentation in complex environments. The study takes five major roads (West Beijing Road, North Taiping Road, Changjiang Road, Yihe Road, and Central Road) in Nanjing as objects, and based on the streetscape and remote sensing data of the vegetation growth season from 2017 to 2022, the Gaussian noise, motion blur, and weather effects are simulated by the multimodal noise addition technique, which effectively improves the adaptability of the model to the dynamic interference. The experiments showed that the Green View Index analysis revealed a general upward trend of street greening (average increase of 0.94\%). Furthermore, the Kendall rank correlation analysis reveals the positive correlation between environmental factors and green visualization rate, and the influence law of environmental factors on green perception is verified. This study provides a high-precision computer vision analysis framework for urban greening planning and promotes the application of semantic segmentation models in complex urban scenes.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "480–485",
    numpages = "6"
}

@inbook{cons147,
    author = "Lei, Zhongxia and Zhang, Caixia and Gui, Junzhen",
    title = "Applications and Comprehensive Evaluation of Commodity Reconstruction based on NeRF",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728737",
    abstract = "NeRF, as an implicit 3D scene generation algorithm, has attracted widespread attention in the field of 3D reconstruction. However, its application in the field of small commodity 3D modeling has not been fully evaluated. To offer specific technical guidance for the application of Nerf in the e - commerce field, we perform detailed experiments and comparisons from multiple aspects such as the complexity of the background, lighting conditions, the number of images, and the surface texture of the experiment.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "72–79",
    numpages = "8"
}

@inbook{cons148,
    author = "Zhang, Xiaofeng and Gao, Xianming and Tao, Peilin and Feng, Tao",
    title = "GraphSynth: Synthesis of Network Configuration Templates Using Large Language Models",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728742",
    abstract = "We investigate whether Large Language Models can synthesize correct network configuration templates in a simpler and more efficient way with limited prompts. The experimental results demonstrate that the LLM's shortcomings in command relation understanding can be supplemented by external models to generate promising templates. We do not rule out the contribution of validators to property-specific consistency. However, our framework aims to preserve the large language model generation capability while focusing on the implicit relationships in configurations. By introducing a hierarchical command graph, we follow a top-down matching to generate templates, reducing feedback interactions in generation and bring potential solutions for automated provisioning. We process template generation under different scenarios, including establishing BGP basic connections on multiple routers and imposing restrictions such as route redistribution at specific locations. Human involvement is restricted to providing critical information. Experiment shows that expected templates can be generated in the first iteration, particularly for the basic task. The advanced task is influenced by multiple factors, however, it still shows considerable potential in terms of coverage with possibly feasible templates.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "108–114",
    numpages = "7"
}

@inproceedings{cons149,
    author = "Li, Yanhong and Zhang, Min and Zhang, Shaofan and Zheng, Maoran and Gu, Yayun and Tang, Wuchen and Gao, Ming",
    title = "Research on Quality Assessment and Report Generation of Power Grid Fault Datasets Based on Prompt Engineering",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734925",
    doi = "10.1145/3734921.3734925",
    abstract = "This study proposes an automated quality assessment method for power grid fault datasets based on large language models (LLMs) and prompt engineering, along with the automatic generation of quality assessment reports. By leveraging the semantic understanding capabilities of LLMs and the flexibility of prompt engineering, the method efficiently analyzes and accurately detects multidimensional issues such as missing values, duplicate entries, outliers, and irregular time intervals within the datasets. Experimental results demonstrate that the prompt-engineering-based approach achieves an overall accuracy of 86\% in data quality assessment and 100\% accuracy in outlier detection. Furthermore, the method can automatically generate detailed assessment reports in Word format, including visual analytical charts. This approach enhances the automation and accuracy of dataset quality assessments, providing reliable data support for intelligent operation and maintenance of power systems.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "19–25",
    numpages = "7",
    keywords = "Automated report generation, ChatGPT, Data quality evaluation, Large language models, Prompt engineering",
    location = "",
    series = "GADM '25"
}

@inbook{cons150,
    author = "Cao, Yu and Du, Xuehui and Zhang, Lulu and Wang, Shihao",
    title = "An Efficient Zero-Knowledge Range Proof Scheme Based on Multibit Split Square Decomposition",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728791",
    abstract = "With the continuous development of blockchain technology, an increasing number of scholars have begun to consider the harm of data leakage during on-chain transactions and the requirement for privacy data protection. Zero-knowledge range proof, as a cryptographic technology, can perform legitimacy verification of data while hiding private data, effectively realizing the protection of private data on the blockchain, so it is increasingly used to protect blockchain privacy. The mainstream construction methods for range proofs can be mainly divided into two categories: n-ary decomposition and square decomposition. This paper introduces and analyzes the advantages and disadvantages of these construction methods in detail. Then, based on these two methods, a zero-knowledge range proof scheme based on multibit split square decomposition (ZKRPMSSD) is proposed, which requires no trusted third-party setting and can achieve range proofs for arbitrary ranges. The proposed ZKRPMSSD scheme processes the original data based on the multibit split idea, and the acquisition method of secret value components is optimized so that the acquisition of components does not depend on the scale of the original problem. Additionally, the algorithms for proof generation and verification in the ZKRPMSSD scheme are redesigned based on the (Sigma ) protocol and Pedersen commitments, effectively reducing the computational cost of the proof generation and verification process. Finally, typical n-ary decomposition and square decomposition zero-knowledge range proof construction schemes are taken for comparative analysis. Under 256-bit security and the same problem scale, experimental results indicate that ZKRPMSSD has advantages in proof and verification time costs.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "417–426",
    numpages = "10"
}

@inbook{cons151,
    author = "Rong, Minxi and Sun, Qi and Guo, Xiaoli and Zhang, Guipeng and Qi, Huijing and Hu, Fuyang",
    title = "Imbalanced Graph Classification based on Graph-of-Graph Neural Networks and Augmented Graph Generator",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728755",
    abstract = "Graph classification has significant applications in various domains, including chemical molecular structure prediction, social network analysis, recommendation systems, and biological network analysis, and has received considerable attention in recent years. However, real-world graph datasets often exhibit class imbalance, where the disproportionate distribution of classes can cause models to favor the majority class, reducing prediction accuracy for minority classes. Notably, minority or anomalous classes often hold unique value in many practical scenarios. This paper proposes a framework for graph classification under category imbalance named Generator Imbalanced Graph Classification(GIGC). GIGC employs a set of learnable augmented graph generators orchestrated by an automated augmentation strategy to enhance minority-class graphs. This approach increases the diversity of minority-class samples, balances the dataset's class distribution, and improves the model's generalization capabilities. Simultaneously, k-reciprocal nearest neighbors are utilized to capture inter-graph relationships more effectively, leveraging the properties of symmetry and reciprocity. Subsequently, Graph-of-Graph Neural Networks are used to model inter-graph relationships, capturing global associations between graphs at a higher level. This enables the model to better capture and utilize inter-graph information. By leveraging the latent connections between minority-class graphs and other graphs, GIGC enriches the representation of minority-class graphs, mitigating the negative effects of class imbalance on classification performance. Extensive experiments on five real-world datasets demonstrate that GIGC outperforms baseline methods in graph classification. Specifically, F1-macro and F1-micro are improved by at least 1.12\% and 2.62\%, respectively. These results validate the effectiveness of GIGC in addressing class imbalance in graph classification tasks.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "190–195",
    numpages = "6"
}

@inbook{cons152,
    author = "Dong, Benchang and Chen, Zhili",
    title = "PPQformer: Privacy-Preserving Quantized Transformer for Efficient and Secure Inference.",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728743",
    abstract = "In the context of the popularity of Transformer model services, the issue of privacy protection has gradually gained attention. However, the primary issues with existing private inference solutions lie in memory constraints and suboptimal computational performance. In this work, we introduce PPQformer, a framework that leverages Replicated Secret Sharing (RSS) and quantization techniques to enable efficient and secure inference of Transformer models in a Multi-Party Computation (MPC) setting. By integrating quantization into the MPC protocols, PPQformer significantly reduces memory footprint and enhances computational performance while preserving data and model privacy. Experimental results demonstrate the effectiveness of our approach, achieving competitive accuracies with reduced communication cost and inference time compared to existing methods.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "115–119",
    numpages = "5"
}

@inbook{cons153,
    author = "Zhou, Chenglin and Huang, Cheng and Luo, Xiangyu",
    title = "Synthesis of Real-time Linear Dynamic Logic over Finite Traces",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728795",
    abstract = "Reactive synthesis, or simply synthesis, is primarily used to automatically generate control-intensive programs. Applications of reactive synthesis span various domains, including robot motion planning, autonomous system control, and communication protocol development. This paper investigates the reactive synthesis for formulas expressed in Real-Time Linear Dynamic Logic over finite traces (RTLDLf). RTLDLf is more expressive than Linear Temporal Logic over finite traces (LTLf). While RTLDLf and Linear Dynamic Logic over finite traces (LDLf) share equivalent expressive power, RTLDLf offers greater simplicity in its logical constructs compared to LDLf. Existing synthesis methods for LDLf predominantly rely on automata-based approaches. In this paper, we propose an RTLDLf synthesis method based on temporal testers. We first translate an RTLDLf specification into a temporal tester, a non-deterministic transducer. The tester is then transformed into a graph game between the system and the environment. We finally propose a symbolic algorithm to solve the game to derive a winning strategy for the system player. The proposed method has two advantages: (1) high composability, enabling convenient and efficient synthesis of complex RTLDLf formulas, and (2) symbolic representation of the tester's transition relations and state space, which facilitates the use of efficient symbolic algorithms based on Ordered Binary Decision Diagrams.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "447–452",
    numpages = "6"
}

@inbook{cons154,
    author = "Chen, Jian and Li, Guangao and Wang, Jun and Sun, Siluo and Sun, Shoudao and Zhao, Yuntao",
    title = "CBAM-EANet: Convolutional Block Attention Module Enhanced Efficient Network for Detection on Distributed Denial of Service Attacks",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728794",
    abstract = "With the emergence of numerous DDoS attack methods, traditional detection techniques can no longer accurately and swiftly detect DDoS attacks. Furthermore, deep learning-based traffic image classification models often become overly complex in their pursuit of higher accuracy. In the paper, we propose a deep learning model-based method for the visual detection of DDoS malicious traffic. In response to the issue of model complexity, this article has made improvements based on the EfficientNet model, especially in resource constrained environments. This article introduces CBAM into the original model to improve its ability to process global information. By replacing the loss function in the final Softmax layer of the EfficientNet model, the ability to extract image features for binary classification problems has been enhanced, resulting in improved model performance. The experimental results show that this method can effectively identify various DDoS attacks. Compared with the EfficientNet model, this method has improved accuracy, training time, and single image prediction time.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "440–446",
    numpages = "7"
}

@inbook{cons155,
    author = "Liu, Shani and Wang, Shan and Zhao, He",
    title = "Realization and Experimental Research on Immersive Visual Communication System Based on Real-Time Rendering",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728814",
    abstract = "Aiming at the problems of low image processing efficiency and insufficient rendering quality in virtual reality content creation, a real-time rendering system based on deep learning is designed and realized. An improved U-Net network structure is used for image processing, and a rendering speed of 112fps is realized in a standard test environment, with the end-to-end delay controlled within 12ms. The system achieves a task completion rate of 95.8\% and a satisfaction score of 4.6 in a test with 1000 users. The experimental results show that the system significantly improves the rendering efficiency and interactive experience, and provides reliable technical support for virtual reality content creation.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "565–569",
    numpages = "5"
}

@inproceedings{cons156,
    author = "Wang, Rongfu and Huang, Peibin",
    title = "Application and Design of Wi-Fi Ad Hoc Network Technology in Intelligent Agricultural Ecosystem",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728772",
    doi = "10.1145/3728725.3728772",
    abstract = "This paper presents an intelligent agriculture system scheme based on Wi-Fi Ad Hoc networking technology. By arranging Wi-Fi routing nodes in the farmland, and using UDP protocol, the wireless transmission of farmland data is realized. To improve the reliability and stability of the data connection, this study designed the autonomous encryption sending and decryption receiving process and introduced the antenna technology. The system realizes the data monitoring and control of the whole agricultural planting process and improves the accuracy and efficiency of agricultural cultivation. Through the implementation of the new scheme and the comparison with the traditional agricultural planting methods, this study demonstrates the important advantages of the new scheme in improving agricultural production efficiency and reducing production costs. The system is used in agricultural intelligent planting. Through the data monitoring and control of the wireless sensor nodes, the real-time monitoring, data collection, and real-time control of the agricultural production environment are realized. This paper focuses on the application of this system in wireless smart farms and improves the efficiency and quality of agricultural production through the analysis and processing of the data.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "295–301",
    numpages = "7",
    keywords = "Ad Hoc network technology, Data monitoring and control, Intelligent agricultural system, Wi-Fi",
    location = "",
    series = "GAIIS '25"
}

@inproceedings{cons157,
    author = "Liu, Quan and Song, Yunkui",
    title = "Optimization of Price Strategy by Machine Learning in E-commerce",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728770",
    doi = "10.1145/3728725.3728770",
    abstract = "Machine learning algorithms can monitor market dynamics, user behavior and competitor prices in real time, and dynamically adjust commodity prices based on this information to maximize profits. By analyzing historical sales data, market price data, user behavior data, etc., machine learning models can predict the demand and price sensitivity of goods to develop optimal pricing strategies. This study takes Pinduoduo and Taobao as examples to analyze the application of machine learning in E-commerce price strategy optimization, in order to provide useful reference for the E-commerce platforms.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "284–288",
    numpages = "5",
    keywords = "E-commerce, Machine learning, Pinduoduo, Price strategy, Taobao",
    location = "",
    series = "GAIIS '25"
}

@inbook{cons158,
    author = "Wei, Letian and Zhang, Zhiman and Zheng, Junhua",
    title = "Privacy distillation: Collaborative privacy protection for Transformer",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728733",
    abstract = "Transformer have been widely used in the field of natural language processing due to their excellent performance, but the high computational cost and large parameter scale limit the efficiency of actual deployment. As an effective model compression technique, model distillation constructs small-scale student models from large models through knowledge transfer, significantly reducing resource requirements. However, there is a risk of information leakage during the distillation process of the model. This article deeply analyzes the potential mechanisms of information leakage in the distillation process of Transformer, including data reproduction attacks, reverse inference attacks, and other issues. In response to the above risks, a method combining differential privacy technology with secure multi-party computation was proposed for protection, and its effectiveness was verified through experiments. Research has shown that this method can significantly reduce the risk of information leakage while ensuring model performance.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "43–49",
    numpages = "7"
}

@inproceedings{cons159,
    author = "Zhang, Yingzi",
    title = "Multimodal Medical Image Generation and Classification via Generative Adversarial Networks",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734945",
    doi = "10.1145/3734921.3734945",
    abstract = "Medical image analysis is essential for accurate disease diagnosis, with multimodal imaging offering complementary information to enhance diagnostic precision. However, current GAN architectures exhibit limitations in feature fusion efficiency, synthesized image quality, and classification accuracy. In this study, a GAN-based multimodal medical image generation and classification model was constructed. First, features are extracted using multi-scale receptive fields, key channels are enhanced by combining the channel attention mechanism, and the cross-enhanced fusion module realizes the fusion of MRI and PET features. In addition, Generator 3D is responsible for generating realistic medical images and classifying diseases through the classification header. Discriminator 3D is used to discriminate the realism of the images. Meanwhile, a comprehensive loss function is designed to optimize the generator's performance by combining adversarial loss, correlation loss, mean loss, and classification loss. The experimental results show that the proposed method can generate high-quality medical images and perform well on the classification task. It effectively improves the performance of medical image analysis and provides strong support for clinical diagnosis.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "157–161",
    numpages = "5",
    keywords = "Generative adversarial networks, feature fusion, image generation and classification, multimodal medical images",
    location = "",
    series = "GADM '25"
}

@inbook{cons160,
    author = "Li, Shuaicheng",
    title = "EEG Emotion Recognition Based on TQWT-features and Multiscale Convolution Superimposed Transformer",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728758",
    abstract = "Emotional recognition can help machines to capture the emotional state of human beings, which is an indispensable technology for human-computer interaction and the realization of artificial intelligence. Electroencephalogram (EEG) has been applied to emotion recognition due to its good temporal and spatial resolution. How to capture the correlation of long-distance time-series EEG signal data from both temporal and spatial dimensions and directly affect the effect of emotion recognition is a difficulty in the BCI research. Transformer model can extract long-term correlations of time-series signals. In this paper, a new electroencephalogram emotion recognition method based on spatiotemporal fusion Vision Transformer is proposed. The feature of EEG signals is reconstructed by the tunable Q-factor wavelet transform (TQWT) method. The spatiotemporal correlation between the acquisition channel and the temporal signal is established by position coding for the convolved features. The hybrid model of multiscale convolutional and Vision Transformer (MC-ViT) is utilized for feature extraction and emotion classification. The EEG emotion recognition method based on spatio-temporal fusion vision transformer proposed in this paper has achieved good EEG emotion classification effect on the SEED dataset, which outperforms state-of-the-art deep learning methods.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "213–218",
    numpages = "6"
}

@inbook{cons161,
    author = "Wang, Yawen and Jin, Yuanyuan",
    title = "Knowledge-Enhanced Event Prediction of Carrier-Based Aircraft Emergencies",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728729",
    abstract = "Shipboard emergencies can easily induce secondary events because of any time and space transition. Carrier-based aircraft emergencies have complexity, tight coupling and strong real-time characteristics. Therefore, it is of great significance to reasonably predict the development trend of the incident in the emergency treatment to reduce the harm. Due to the sudden and random nature of naval battlefield accidents, some incidents are not covered by the historical case base. Traditional retrieval approaches to event prediction using case knowledge are limited by the sparsity of events and the cold-start problem. To address these challenges, this paper proposes a multi-graph neural network for event development trend prediction, which disassembles events into event features and introduces the shipboard aircraft domain knowledge graph. We produce a data set around the event features of carrier-based aircraft on the simulation platform. The results show that the graph neural network with knowledge graph is superior in modeling the higher-order semantic association between event features. Compared to state-of-the-art baseline methods, our approach exhibits significant improvements.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "20–25",
    numpages = "6"
}

@inbook{cons162,
    author = "Cai, Litao and Liu, Mingmei and Feng, Youbing and Xiong, Feng",
    title = "Research on fall detection algorithm based on improved YOLOv8",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728821",
    abstract = "Aiming at the traditional fall detection algorithms that suffer from low detection accuracy and poor real-time performance in dealing with small targets and multi-scale features in complex scenes, this study proposes a fall detection algorithm based on an improved YOLOv8 model. First, the SCConv module is utilized to combine with the C2f module in the YOLOv8 backbone network to construct the C2fSC module, which enhances the feature extraction capability of the model while reducing the computational complexity. Second, the SPPF module is integrated with the BAM attention mechanism to weaken the influence of background interference. Finally, WIoU is used to replace the original loss function to optimize the positioning accuracy of the bounding box and enhance the overall performance of the model. The experimental results show that compared with the original YOLOv8 model, the improved model improves 4.9\%, 4.2\%, and 4.4\% in P, R, and mAP metrics, respectively, and the number of parameters and FLOPs are only 2.8M and 7.7G, which proves that the improved model has excellent robustness and effectiveness.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "610–615",
    numpages = "6"
}

@inbook{cons163,
    author = "Xiong, Botao",
    title = "Audio-driven Talking-face Synthesis based on 3D Gaussian",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728752",
    abstract = "Audio-driven talking-face synthesis is of significant importance in various application scenarios, such as remote meetings, AR/VR, and digital humans. Currently, the work in this field can be broadly divided into two categories: implicit representation-based methods and explicit representation-based methods. Implicit representation-based methods often use neural network models to represent human face. For example, NeRF (Neural Radiance Field) uses MLP (Multi-Layer Perceptron) to represent human face, and by inputting the camera pose, NeRF renders a face image from that viewpoint. When training with audio features, it can render face images with different facial movements. However, due to the lack of editability and slow rendering speed of implicit representations, the industry has been exploring new representation methods. Explicit representation-based methods commonly use 3D Gaussian representations of the face, which offers high editability and nearly real-time rendering speed, making these methods surpass implicit-based approaches in many metrics. However, it is difficult to incorporate other signals during the rendering optimization process. To address this issue, this paper combines 3D Gaussian representations with the 3D head model FLAME (Faces Learned with an Articulated Model and Expressions). The FLAME model represents the face's shape and facial movements with a set of parameters. In this paper, audio signals are first transformed into parameters representing facial movements, which are used to initialize the 3D model generated by the parameters, followed by rendering optimization. This paper proposes a 3D Gaussian-based audio-driven lip-sync video generation system. It consists of two main modules: the audio-to-facial movement module and the 3D Gaussian rendering module. The audio-to-facial movement module uses the extracted audio features to generate parameters that control the FLAME model, converting the audio input into natural and reasonable lip shapes and facial movements. The 3D Gaussian rendering module initializes the 3D Gaussian with the FLAME model, optimizes the rendered image from coarse to fine, and finally stitches the generated images together to create a continuous video. Experiments show that this system can generate lip-synchronized, accurate, high-fidelity videos.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "171–177",
    numpages = "7"
}

@inbook{cons164,
    author = "Li, Hao and Zhao, Jiahui and Gu, Daixuan",
    title = "HoloDiT: Exploring 3D Diffusion Transformer Models Using 2D Images",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728727",
    abstract = "Recently, Transformer-based diffusion models have produced impressive results in 3D shape generation. However, at this stage, they can only be trained using 3D point cloud data to generate simple 3D shapes based on point cloud representations. Building on this, we propose HoloDiT. It uses a set of real-world 2D images and corresponding camera poses as input, generating 3D auxiliary samples that are fed into a Transformer-based 3D diffusion model for training in 3D shape generation. By training the rendering function to generate color and density, we can restore the color details of object surfaces. This enables HoloDiT to generate realistic 3D shapes from 2D images. We trained on the real-world CO3Dv2 dataset, and the generated results demonstrate competitive quality and consistency compared to existing 3D generation models.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "7–11",
    numpages = "5"
}

@inbook{cons165,
    author = "Zhao, Weidong and Jiang, Xuan and Qiu, Liqing",
    title = "WWR-CS: Chinese Spelling Error Correction Based on Whole Words Replacement fusing Confusion Set",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728765",
    abstract = "Chinese Spelling Error Correction, which aims to detect and correct spelling mistakes in Chinese text, is an essential branch of Natural Language Processing (NLP) field. However, the similarity of character sounds and shapes poses considerable challenges in Chinese spelling correction. Although significant progress has been made in the BERT-based Masked Language Models (MLMs) incorporating phonological and morphological information, further research is needed on improving correction accuracy in multiple error scenarios. Therefore, the paper proposes the Chinese Error Correction based on Whole Words Replacement fusing Confusion Set (WWR-CS) model which utilizes the whole words replacement method, incorporating confusion set in the noise generation module. Furthermore, due to the fact that most spelling errors stem from phonetic misuse, the model incorporates the pronunciation of Chinese characters and comprehensively considers character correction and pinyin prediction to obtain the final correction result. The experimental results on the Sighan datasets exhibits improved performance compared to the models proposed in recent years, verifying the effectiveness of the proposed model.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "251–257",
    numpages = "7"
}

@inbook{cons166,
    author = "Fang, Yong",
    title = "Wasserstein GAN-Based Android Certificate Validation Vulnerability Detection Framework",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728761",
    abstract = "This paper presents an Android certificate validation vulnerability detection framework that integrates static analysis, adversarial sample training, and optimization via large language models. Centered around the Wasserstein Generative Adversarial Network, the framework aims to enhance the robustness and generalization ability of static detection models against complex and obfuscated attack patterns. Static analysis is performed on 2,000 popular Android applications from the androzoo dataset, with code and configuration features extracted, focusing on certificate-related API usage, permission declarations, and network security settings. Among them, 110 APKs are identified as containing high-risk certificate misconfigurations. Based on these features, a Transformer-based model is constructed for feature vectorization and vulnerability identification. To further improve model robustness, WGAN is employed to generate adversarial samples that mimic real-world evasive vulnerabilities, which are used for adversarial training. Additionally, large language models are used to perform In-Context Learning, enabling semantic filtering, sample refinement, and iterative generator feedback. This results in a closed-loop, self-improving detection pipeline that combines detection, optimization, and feedback. Experimental results across standard, adversarial, and cross-domain scenarios demonstrate that the proposed framework achieves an F1 score of 0.91 and reduces the false positive rate to 7.2\%, significantly outperforming traditional static detection tools in both accuracy and resilience.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "231–236",
    numpages = "6"
}

@inproceedings{cons167,
    author = "Li, Ruihang and Li, Tao and Li, Hong and Li, Shijian and Pan, Zhijie",
    title = "Perception Data Generation via Synthesized 3D Scenes and Closed-Loop Optimization in Autonomous Driving Simulation",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734928",
    doi = "10.1145/3734921.3734928",
    abstract = "Simulation is crucial for developing autonomous driving systems, where AI algorithms process sensor data to perceive environments. However, training these algorithms require vast, diverse data, and existing methods face limitations. Manual scene construction in simulation platforms is slow and lacks scalability, while rendering-based approaches often produce inconsistent image sequences, failing to support high-quality algorithm training. Additionally, such methods cannot synthesize multi-modal data essential for perception models. To alleviate these problems, this paper proposes an automated system to generate multi-modal perception data (image, point cloud, vehicle status) by synthesizing diverse 3D scenes within a simulation platform. By directly constructing 3D scene models, the system eliminates perspective inconsistencies inherent in rendering-based methods. Experimental validation showing the system generates consistent, high-quality data for autonomous driving.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "41–46",
    numpages = "6",
    keywords = "3D Scene Generation, Autonomous Driving, Data Closed-Loop Optimization, Driving Patterns, Perception Data Generation",
    location = "",
    series = "GADM '25"
}

@inbook{cons168,
    author = "Liu, Sihan",
    title = "VideoDreamBooth: Subject-Driven Video Editing with Guided Multi-Path Fusion",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728766",
    abstract = "Diffusion models have gained popularity for generating content in various domains, including text, image, and video. In particular, Text-to-Image(T2I) models have emerged as an innovative tool for artistic expression. They also spurred growth in other associated areas, such as personalized subject generation and one-shot video editing. This paper presents VideoDreamBooth, a novel framework for real video editing with personalized subject. Inspired by the coarse-to-fine denoising nature of diffusion, we propose a multi-path fusion technique to preserve temporal consistency with original video. We also propose a metric (CLIP score ) to guide which denoising steps will conduct fusion. Our framework has proven to be effective and successful for video editing in various experimental settings.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "258–265",
    numpages = "8"
}

@inbook{cons169,
    author = "Li, Wei and Zhang, Kangwei and Li, Penglin and Yan, Keyang",
    title = "DAT-YOLO: Small Object Detection Model from the Perspective of Drones",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728810",
    abstract = "A DAT-YOLO model incorporating deformable attention is proposed to address the challenges of dense target distribution, small pixel size, and uneven sample size in object detection from the perspective of unmanned aerial vehicles. This model is based on YOLOv8s and optimizes the Backbone and Neck structures, allowing the model network to be shallower in depth while being more focused on small targets; Using RepNCSPELAN4 structure instead of C2f structure to better adapt the model to different computing and hardware requirements; The deformable attention mechanism DAT is integrated into the spatial pyramid pooling layer, allowing the network to capture more effective features while expanding the receptive field; The use of inner-ShapeIoU loss function improves the algorithm's localization and classification performance for small targets in complex environments. The experimental results of DAT-YOLO on the VisDrone dataset show that with a 57.5\% reduction in parameter count, the mAP@50 and the mAP@50:95 has also increased by 6.7\% and 5.0\% respectively, making it suitable for drone target detection tasks.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "538–545",
    numpages = "8"
}

@inbook{cons170,
    author = "Yang, Tonghui and Xu, Yamei",
    title = "Super-resolution Reconstruction of Remote Sensing Images with Improved SwinIR Transformer",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728750",
    abstract = "Aiming at the problem of large differences in feature information between different targets in remote sensing images and the complexity of the scene, an improved SwinIR Transformer remote sensing image super-resolution reconstruction algorithm is proposed, combining residual hybrid attention and spatial-gate feed-forward network. First, a new residual hybrid attention module (RHAB) is constructed, which is serially combined with multiple self-attention (MSA) to enhance feature extraction by mixing channel attention (CA), spatial attention (SA), and MSA, and to improve the model's ability in modeling locally and globally relevant information. Second, a spatial-gate feed-forward network (SGFN) is used instead of the multilayer perceptron (MLP) in the original network to effectively reduce redundant channel information, overcome the limitations of the MLP in dealing with local spatial features, and enhance the feature expression efficiency. The experiments use NWPU-RESISC45 and UCMerced\_LandUse as the training set, RSOD-Dataset, RSSCN7 Data Set, and WHU-RS19 Data Set as the test set, and the model performance is evaluated by PSNR and SSIM metrics. The experimental results confirm that the model in this paper shows excellent performance in both objective evaluation and subjective visualization.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "157–162",
    numpages = "6"
}

@inbook{cons171,
    author = "Zheng, Jiamin and Song, Yunuo and Song, Shaoyi and Zhao, Xuan and Zhou, Yipeng",
    title = "Prediction based on multi - model agricultural assistance recommendation algorithms",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728777",
    abstract = "Against the backdrop of a prominent information asymmetry problem in the agricultural product market, algorithms for promoting agricultural product sales are of great significance. However, they face challenges such as poor data quality. This study aims to improve the algorithm performance. By optimizing the Latin hypercube sampling method, a distance - metric - based strategy is introduced to optimize the distribution of sampling points and set adaptive parameters, enhancing the uniformity and representativeness of samples. A prediction model is constructed by combining the powerful non - linear mapping and self - learning capabilities of the BP neural network. The research obtains data from multiple channels, conducts sampling and feature extraction after pre - processing, sets network parameters to train the model, and then evaluates it.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "326–331",
    numpages = "6"
}

@inbook{cons172,
    author = "Gong, Jiangchuan and Wang, Yang",
    title = "Research on Distributed Training Architecture for Large Scale Models for Natural Language Processing",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728812",
    abstract = "Large-scale language models are critical for natural language processing, and efficient distributed learning is needed to train such models. In this paper, a distributed training scheme is developed to improve the efficiency and scalability of training large-scale language models. This training scheme is divided into a three-layer structure, and also incorporates an autotuned gradient compression method and a load balancing mechanism to improve training efficiency at any time. Experiments show that this scheme is highly efficient in terms of computation and resource utilization for large-scale training tasks, is much faster than current open systems, and offers new ideas for faster training of large-scale language models.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "551–556",
    numpages = "6"
}

@inproceedings{cons173,
    author = "Ren, Zhiyang and Jin, Guangri",
    title = "Artificial neural network-based model for predicting compressive strength of cemented gravels",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734932",
    doi = "10.1145/3734921.3734932",
    abstract = "In order to study the compressive strength of cemented gravel, a compressive strength prediction model was established; with 142 groups of in-house uniaxial compressive strength test data of cemented gravel with different mixing ratios as the object of study, the 11 influencing factors in the samples were downscaled by using the principal component analysis method, and the downscaled principal components were used as the input layer of the BPNN, so as to establish the compressive strength prediction of cemented gravel based on the PCA-BPNN model. The results show that when the number of principal components is 3, the cumulative contribution rate of the principal components reaches 86.483\%, and the contribution rates of the three principal components are 65.084\%, 11.702\%, 9.097\%, and the eigenvalues of the three principal components are all greater than 1. Then the three principal components are used as the input layer to build the compressive strength model of cemented gravel based on PCA-BPNN, and the RMSEs of the training set and test set are 0.253 and 0.28, respectively. The RMSE of the training set and the test set are 0.253 and 0.286, and the R2 is 0.947 and 0.942, which are not much different from the BPNN model with the number of nodes in the input layer of 6 and 11 before dimensionality reduction, and they are obviously better than the BPNN model in the convergence speed and training time. It can be seen that the PCA-BPNN model has good prediction effect and prediction efficiency, especially drastically reducing the training time, which provides a new idea for the prediction research of the mechanical properties of cemented gravel.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "63–70",
    numpages = "8",
    keywords = "Artificial neural network, Cemented Gravels, Compressive Strength, PCA",
    location = "",
    series = "GADM '25"
}

@inbook{cons174,
    author = "Wang, Xiaoyu and Zhao, Weidong and Qiu, Liqing",
    title = "Building Specialized Adversarial Examples for Improved Spelling Error Correction",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728734",
    abstract = "Pre-trained language models based on deep neural networks have achieved superior performance in Chinese spelling correction. However, these models are heavily dependent on the size and quality of the training corpus and exhibit poor performance when faced with unknown errors. Inspired by adversarial learning, this paper focuses on Chinese character input scenarios and propose an effective attack strategy to generate more valuable training examples in these scenarios. This strategy jointly utilizes the attention mechanism and the logit output to determine the attack position and generates misspelling instances in a perturbed pinyin manner. The generated adversarial samples are then gradually added to the training set to train the model. Further, this paper explores the effect of the proportion of samples in the adversarial training process on model performance. The effectiveness of the proposed strategy are demonstrated on three different architectural baseline models.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "50–57",
    numpages = "8"
}

@inbook{cons175,
    author = "Huang, Zhiyu and Wu, Zhen",
    title = "Malicious Traffic Identification Based on Composite Sampling",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728787",
    abstract = "In response to the problem of insufficient attack traffic samples in network intrusion detection datasets, a hybrid sampling data augmentation method (S-VAE) that combines SMOTE and VAE is proposed. Firstly, train corresponding VAE models for different types of attack traffic samples; Secondly, the SMOTE algorithm is used to extract the original samples and their neighboring samples from the dataset and store them in pairs; Then, the paired samples are fed into the trained VAE model to learn their latent representations separately, and the latent representations of the original and neighboring samples are linearly interpolated; Finally, the results of linear interpolation are fed into the trained VAE decoder to expand the new samples. In this way, a balanced dataset can be established to enable deep learning models to fully learn the features of a small number of samples. The experimental results showed that using convolutional neural network models for multi classification experiments on the NSL-KDD and UNSW-NB15 datasets, S-VAE increased the classification recall by 3.75 and 3.06 percentage points, respectively, and the F1 score by 6.49 and 4.29 percentage points, respectively, compared to the baseline model.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "392–398",
    numpages = "7"
}

@inbook{cons176,
    author = "Liu, Chengyu and Liu, Jing",
    title = "Research on Load Monitoring and Regulation of Human Movement Training Assisted by Intelligent Algorithms",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728779",
    abstract = "A unique sports-based heavy load state monitoring approach is intended to understand human exercise monitoring and management science with intelligence algorithms. Wireless sensor network nodes are used to collect the state of unlimited sports, and use the joint information to achieve the integration and coordination. The detection and analysis of the characteristics of the model of the sports heavy load state abnormal characteristics is designed together with the ZigBee IoT network and RF address recognition method, which can be achieved spectral characteristic analysis and observation of non-competitive characteristics in the state in real-time sports conditions. Based on the results, sports performance can be monitored in time and health can be determined. The results show that the sports load monitoring system has high accuracy in monitoring the sports load and can avoid the sports load due to excessive exercise.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "337–341",
    numpages = "5"
}

@inbook{cons177,
    author = "Chen, Jian and Wang, Lei and Jiang, Jun and Liu, Ruitong and Ji, Heng and Zhao, Yuntao",
    title = "A Knowledge Reasoning Modeling for security vulnerability databases based on Gaussian-SVM hybrid clustering",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728793",
    abstract = "At present, network security becomes more and more important, but the security vulnerability data in various databases are relatively dispersed and it is difficult to establish the connection between them, network security knowledge graph can associate the security vulnerability data of different databases together, and it can be updated in real time with the latest security vulnerabilities. This paper establishes network security knowledge graph based on CAPEC, CWE and other security libraries. Aiming at the problem that TransR model cannot utilize entity semantic information, TransR-Roberta model is proposed, and splicing layer, attention layer and convolutional layer are added on the basis of TransR model. And for the problem that the quality of negative samples generated by Bernoulli negative sampling is too low, a clustering-based negative sampling optimization method is proposed. Firstly, the clustering task is accomplished with the help of Gaussian hybrid clustering algorithm on the entities in the security vulnerability knowledge graph to label the entities with clusters. In the next step, the clustered vulnerability entities are reclassified using support vector machine. Finally, a classifier combined with Facolloss function is added to the loss function of the TransR model, which is used to improve the ability of the knowledge inference model to distinguish between positive and negative samples. The experimental results show that the improved model improves the hit@N, MR and MMR metrics for the knowledge reasoning task.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "435–439",
    numpages = "5"
}

@inbook{cons178,
    author = "Yu, Ze and Miao, Quanqiang",
    title = "Cybersecurity Survivability Testing Technology Based on ATT\&amp;CK and D3FEND",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728768",
    abstract = "In the context of the continuous evolution of current network threats, organizations urgently need advanced cybersecurity defense strategies to deal with complex and changeable network attacks. Survivability testing is usually implemented by simulating real hacker attacks, but this kind of testing and evaluation method depends on the professional level of testers to a large extent. There are problems such as incomplete testing and low testing efficiency. This paper comprehensively utilizes the ATT\&amp;CK (Adversarial Tactics, Technologies, and Common Knowledge) and D3FEND (Defensive Tactics, Technologies, and Common Knowledge) frameworks of MITRE, aiming to propose a new cybersecurity survivability testing technology. Through in-depth analysis of the attack tactics, techniques and procedures (TTPs) in the ATT\&amp;CK framework, combined with the defense strategies and measures in the D3FEND framework, this paper designs a cybersecurity survivability evaluation program. This scheme not only evaluates the protection, detection, response and recovery capabilities of the system against network attacks, but also provides a scientific and perfect defense measures for the system. The case study further verifies the effectiveness of the proposed scheme, and shows how to conduct survivability testing against attacks on the Linux operating system. This study provides a new perspective and practical guidance for the development of cybersecurity defense technology.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "272–277",
    numpages = "6"
}

@inbook{cons179,
    author = "Zhao, Wei and Han, Shaolong and Wang, Xiang",
    title = "Based on visual model and LSTM cyclic convolutional neural network Automatic recognition method for instrument readings",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728764",
    abstract = "In order to achieve automatic acquisition of instrument readings, a recognition method based on visual model and Long Short Term Memory Network (LSTM) is proposed. This method introduces an attention mechanism model to find the location of the feature that has the greatest impact on the final prediction result in the feature map. Once the dial position is determined, this method utilizes Long Short Term Memory Network (LSTM) to recognize text within that position. The experimental results show that compared to traditional methods, this method avoids the character cutting and a large number of manual modeling operations required by traditional pointer reading recognition methods, significantly improving recognition accuracy.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "247–250",
    numpages = "4"
}

@inbook{cons180,
    author = "Xia, Weiyi and Zhang, Yinggang and Zhao, Ben and Liu, Wei and Han, Linjie and Ye, Qifu",
    title = "Intelligent PLC Code Generation in HCPS 2.0: A Multi-dimensional Taxonomy and Evolutionary Framework",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728757",
    abstract = {The manufacturing industry is accelerating towards the New-Generation Intelligent Manufacturing, where the automatic generation of Programmable Logic Controllers (PLCs) code serves as a key technology, crucial for enhancing the intelligence and efficiency of manufacturing systems. Traditional manual programming has become increasingly inadequate to meet the demands for flexibility and real-time performance in intelligent manufacturing. This paper reviews the integration of intelligent manufacturing and PLC technologies, highlighting the core role of Human-Cyber-Physical Systems (HCPS) and demonstrating how it effectively guides theoretical research and engineering practices in new-generation intelligent manufacturing. We innovatively classify automatic PLC code generation methods through multiple dimensions and propose a new framework for Structured Text (ST) code generation. Finally, this paper discusses future trends in controller code generation, identifying multimodal-driven intelligent generation, adaptive learning and real-time optimization, and cloud-edge collaborative intelligent generation as significant directions, forming a technical roadmap of "parallel promotion and integrated development" to support comprehensive intelligent transformation and upgrading of manufacturing.},
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "202–212",
    numpages = "11"
}

@inbook{cons181,
    author = "Wu, Keyu and Fu, Jingyi and Zhang, Wenfang",
    title = "Aspect-based Capsule Neural Networks for Sentiment Analysis of Sensitive Information",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728756",
    abstract = "To address the need for accurate sentiment masking of sensitive words in sensitive information, traditional sentiment analysis methods can only assess the overall polarity of a sentence, while existing Aspect-Based Sentiment Analysis (ABSA) mostly focuses on the field of commodity reviews, and insufficiently handles phenomena such as complex contexts and irony. To this end, this paper proposes the CapABSA model, which takes sensitive words as aspects, combines capsule neural networks to capture multidimensional semantic features, and migrates document-based sentiment analysis (DBSA) to ABSA through transfer learning to improve classification performance. Experiments show that the model performs effectively in sentence datasets containing sensitive words, providing a more fine-grained solution for sensitive information filtering.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "196–201",
    numpages = "6"
}

@inbook{cons182,
    author = "Sun, Qinhui and Gao, Bin",
    title = "Emotion-enhanced Cross-modal Contrastive Learning for Fake News Detection",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728754",
    abstract = "This paper proposes a fake news detection model based on emotion-enhanced cross-modal contrastive learning (ECC-FND), which aims to fully utilize the information from images, text, and user comments in social media news to improve the accuracy and efficiency of fake news detection. ECC-FND combines cross-modal contrastive learning and sentiment analysis methods to effectively explore the semantic associations between multimodal information and dynamically weights features from different modalities using an attention mechanism. Experimental results demonstrate that ECC-FND significantly outperforms existing state-of-the-art methods on the Weibo dataset, which validates its effectiveness and generalization ability in fake news detection tasks. This study provides new insights for multimodal fake news detection and offers valuable references for future research.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "184–189",
    numpages = "6"
}

@inbook{cons183,
    author = "Xu, Xintao",
    title = "Exploration of Multi-modal Translation Resource Processing Modes under Computer Graphics: A Case Study of Visionbank",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728828",
    abstract = "The rapid development of computer technology has brought computer graphics a qualitative leap in graphic images and visual communication. Computer graphics transforms digital information into image information while conducting digital processing and visualization of graphic images. Combining with the development process of computer graphics, this paper considers the application field of computer graphics, discusses the connotation deduction of multi-modal translation resource. Through case analysis of the Visionbank, this paper validates and advances computer graphics technology to optimize multi-modal translation resource, and realizes the comprehensive utilization of multi-modal translation resource.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "654–658",
    numpages = "5"
}

@inproceedings{cons184,
    author = "Zhu, Qifei and Tang, Jiangang and Cao, Haoshun",
    title = "An Internet Public Opinion Monitoring Model Based on Stacked Ensemble Learning",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728818",
    doi = "10.1145/3728725.3728818",
    abstract = "With the rapid development of social media, internet public opinion has a profound impact on social stability and economic development. At present, common monitoring models generally have problems such as insufficient accuracy or weak generalization ability. Therefore, This paper proposes an internet public opinion monitoring model based on stacked ensemble learning, which aims to realize the real-time monitoring. The model selects combines random forest (RF), logistic regression (LR), support vector machine (SVM) group as the base learner. And integrates the prediction results of the base-learners through the meta learners (GBM) to monitor public opinion in real time. The experimental results show that the empirical model achieves 0.940 accuracy and an F1 score of 0.896, which significantly outperforms other ensemble methods. It can effectively monitor the scale and trend of public opinion of internet comments, and provide strong support for decision makers.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "591–597",
    numpages = "7",
    keywords = "Empirical Research, Internet Public Opinion Monitoring, Stacked Ensemble Learning",
    location = "",
    series = "GAIIS '25"
}

@inbook{cons185,
    author = "Li, Yuanhao and Zhao, Huilin and Lin, Jiayu and Zhou, Zijun and Zhang, Yuanchao",
    title = "Research on Personalized Insurance Intelligent Customer Service Dialogue Generation Based on Large Language Models",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728753",
    abstract = "Artificial intelligence is challenging many areas, including insurance. Insurers who want to secure the highest customer satisfaction level and service quality can no longer ignore the necessity of personal intelligent customer service. But, on the flip side, these existing systems still have problems with comprehensive knowledge, human-like dialogue, and actual estimation. This paper presents a technique for developing personalized dialogue in intelligent customer service applications to the insurance business. Our model establishes an insurance knowledge base and utilizes the retrieval-augmented generation approach. In addition, we create dynamic memory by connecting the long short-term memory module, allowing the system to retrieve and modify customer's information while interacting with them in real time. As a result, intelligent models offer much more natural and engaging conversations, adjusting to specific tones and retaining individual emotions. These virtual assistants customize the responses according to the customer profiles. Hence, they give appropriate, professional, and personalized insurance advice.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "178–183",
    numpages = "6"
}

@inproceedings{cons186,
    author = "Ma, Xiaoqian",
    title = "The potential legal risks of artificial intelligence",
    year = "2025",
    isbn = "9798400717260",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3691422.3691471",
    doi = "10.1145/3691422.3691471",
    abstract = {ChatGPT, as a typical application of generative artificial intelligence, means that human society is moving towards the "era of high knowledge revolution". From the perspective of functionalism, generative artificial intelligence will certainly have an important impact on the reshaping of legal society at the level of "instrument" and "Tao". However, while generative AI is deeply embedded in Chinese society, it also impacts personal information security on a large scale, challenges national security, causes intellectual property rights disputes, and academic ethics irregularities. Therefore, it is necessary for the national regulatory authorities to exercise careful governance, formulate accurate and fair market access guidelines and mechanism accountability systems, improve the public's awareness of risk prevention, and gradually improve the generative AI governance system.},
    booktitle = "Proceedings of the 2024 15th International Conference on E-Business, Management and Economics",
    pages = "366–370",
    numpages = "5",
    keywords = "ChatGPT, Generative artificial intelligence, Legal regulation, Risk management",
    location = "",
    series = "ICEME '24"
}

@inbook{cons187,
    author = "Wang, Liangjie and Wang, Zhongyong and Zhai, Huipeng and Hu, Po and Wang, Wei",
    title = "Spectrum anomaly detection and defense algorithm based on attention mechanism residual neural network",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728788",
    abstract = "Spectrum anomaly detection involves identifying abnormal signals within the electromagnetic spectrum. Most existing methods focus on traditional abnormal signals and can achieve high detection rates through training and testing of neural network models. However, the presence of adversarial samples greatly reduces the performance of existing network models. To address this issue, a spectrum anomaly detection algorithm based on attention mechanism residual neural network is proposed, which can significantly improve the robustness of network models without adversarial training. This method integrates the attention mechanism module and the Residual Network (ResNet), using ResNet18 to process spectrogram data, avoiding gradient vanishing and overfitting during iteration, and using attention mechanism to enhance the model's attention to local information in spectrogram data. The experimental results show that the predictive performance of the proposed algorithm is superior to the compared algorithms. Compared with ResNet18 and feature transformation based image retrieval adversarial defense algorithms, the new algorithm has increased the AUC value for abnormal signal detection by approximately 47\% and 24\%, respectively, effectively improving the robustness of the network model and reducing the negative impact of adversarial samples on the neural network model. The experimental results verify the effectiveness and superiority of the residual neural network model based on attention mechanism.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "399–404",
    numpages = "6"
}

@inproceedings{cons188,
    author = "Zhang, Anxin",
    title = "DyLF: Introducing Longformer for More Efficient Dynamic Graph Learning",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728771",
    doi = "10.1145/3728725.3728771",
    abstract = "In scenarios with fixed time intervals, discrete-time dynamic graph (DTDG) is used to represent dynamic networks, such as social networks, traffic networks and biological networks. Existing models introduce self-attention mechanism for structural representation learning on discrete-time dynamic graph and demonstrate good performance in this field. However, temporal encoder in these models focuses on the entire time domain, introducing noise and limiting the model's ability to extract critical information. To address this issue, we propose the DyLF model based on Longformer mechanism. By incorporating the Longformer-based self-attention mechanism, DyLF can flexibly adjust the range of visible time domain while encoding temporal features of nodes in dynamic graphs and efficiently capture temporal dependencies between snapshots, thereby enhancing the ability to extract more effective temporal information. Extensive experiments show that DyLF achieves an average improvement of 4.28\% in AUC and 6.87\% in F1\_score with the existing baseline, demonstrate that it is better suited for handling DTDGs.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "289–294",
    numpages = "6",
    keywords = "Discrete-time Dynamic Graph, Graph Representation Learning, Longformer, Self-attention",
    location = "",
    series = "GAIIS '25"
}

@inbook{cons189,
    author = "Zhu, Minghua",
    title = "Solving Class Imbalance in Medical Image Classification Based on Federated Learning",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728811",
    abstract = "Federated Learning (FL) has excellent privacy-preserving characteristics and is widely used in the medical field. However, medical data often suffer from class imbalance, which can affect the performance of models. In this paper, we first introduce a novel privacy-preserving federated learning scheme that addresses the class imbalance problem through both feature learning and classifier learning. In the feature learning stage, two feature extraction networks are used in parallel and optimized. Finally, in the classifier learning stage, multiple loss functions are designed to ensure balanced learning across all classes. Experimental results on a publicly available skin dataset with simulated multi-source medical image data demonstrate outstanding performance in handling class imbalance. The model achieves balanced classification accuracy, overall accuracy, and F1 score of 87.02\%, 88.27\%, and 87.33\%, respectively. Compared to other models, the balanced accuracy, overall accuracy, and F1 score are improved by 8.71\%, 3.61\%, and 8.23\%, respectively.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "546–550",
    numpages = "5"
}

@inbook{cons190,
    author = "Shen, Qianwen and Ma, Zeyu and Chen, Mingang",
    title = "From Chart to QA Pairs: A Context-Aware Generation Framework for Chart-Containing Documents",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728741",
    abstract = "While Large Language Models (LLMs) and Vision Language Models (VLMs) have demonstrated impressive capabilities across various general tasks, developing domain-specific model remains an urgent need. This requires fine-tuning with high-quality data. Extraction of question-answer (QA) pairs from domain knowledge documents is a crucial prerequisite for fine-tuning, especially when these documents containing complex charts and unstructured data. This paper introduces a framework for extracting QA pairs from charts, which combines OCR and VLM to fully leverage contextual information in the documents and generate deep, contextually relevant questions. Our method first uses OCR for initial chart recognition, followed by a VLM-based “Caption-Reflection'' paradigm to reduce misrecognition. We then design a context localization module which combines local and global contexts to generate relevant QA pairs. Additionally, we construct a specialized chart knowledge base to guide the generation of QA pairs. Experimental results show significant improvement in both chart recognition performance and QA pairs generation quality: the average precision increases from 0.52 to 0.90, the average F1 Score improves from 0.64 to 0.94, the average FPR decreases from 0.55 to 0 respectively. The generated QA pairs perform well in terms of statistical relevance and contextual consistency.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "101–107",
    numpages = "7"
}

@inbook{cons191,
    author = "Chen, Hongfu and Jin, Minghui and Gao, Feng and Zhai, Yujia",
    title = "Research and Implementation of Access Control Strategy Based on Apriori and Collaborative Filtering Techniques",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728805",
    abstract = "This paper presents an automated method for generating access control policies by combining the Apriori algorithm and collaborative filtering technology. This approach solves the complex access control challenges arising from data sharing and large number of users in power grid regulation systems. First, the Aprior algorithm is used to mine strong association rules from the user authority relationship to reveal the potential relationship between resources. Then, the user rights relationship is enhanced, resource similarity is calculated, and collaborative filtering is used to generate recommended values for unauthorized resources. Finally, the access control policy is classified and authorized according to the recommended value, and the automatic generation of the policy is realized. The experimental results show that this method can not only generate access control policies automatically, but also assign new permissions effectively and ensure the privacy of resource data.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "509–514",
    numpages = "6"
}

@inbook{cons192,
    author = "Luo, Lei and Zhan, Hualin and Jiang, Weinan and Zhang, Ziqian",
    title = "Enhanced Session-Based Recommendation with Global Context and Dynamic Memory",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728830",
    abstract = "Session-based recommendation systems predict what a user might be interested in next based on their current behavior. However, many existing methods face issues, such as insufficient use of overall context and difficulty in extracting key features due to noise interference. To address these challenges, this paper introduces a model called GC-DMRec. This model combines global context with gated slot attention mechanisms, effectively integrating local session graphs with global context graphs to track item changes both within and across sessions. By using gated slot attention, GC-DMRec focuses on critical time points, extracting more representative features while reducing noise. Experimental results on datasets such as Diginetica, Tmall, and Nowplaying demonstrate that GC-DMRec outperforms other existing methods in terms of accuracy and reliability.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "667–672",
    numpages = "6"
}

@inproceedings{cons193,
    author = "Li, Mingyang and Li, Pengpeng and Wang, Rui and Mou, Weihua",
    title = "Residual Neural Network with Attention Mechanism for Direction-of-Arrival Estimation in Low SNR",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728819",
    doi = "10.1145/3728725.3728819",
    abstract = "In this paper, we propose an improved residual neural network (ResNet) based on an attention mechanism for estimating the direction of arrival (DOA) of linear arrays. The real, imaginary, and phase components of the covariance matrix are used as inputs to an auto-encoder (AE), whose output is then introduced into a cascaded ResNet for DOA estimation. To enhance estimation accuracy, an attention mechanism is integrated into the ResNet, effectively assigning greater weight to the most relevant features. Experimental results demonstrate the proposed method's superior DOA estimation performance compared to existing methods, especially in low SNR.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "598–604",
    numpages = "7",
    keywords = "Direction of arrival estimation, attention mechanism, auto-encoder, residual neural network",
    location = "",
    series = "GAIIS '25"
}

@inbook{cons194,
    author = "Lan, Hongxu",
    title = "Comparing the accuracy and efficiency of a single machine learning agent with multiple coordinating agents in a chat environment",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728792",
    abstract = "This paper aims to design a chatbot application to help people find an appropriate restaurant based on users' preferences and transportation modes. It also aims to explore whether a machine learning-based chat agent is capable of accomplishing all the tasks precisely, or whether it could be optimized by collaborating with other simple agents. This paper establishes a chatbot environment along with a series of agents (machine learning agent, grammar checker agent, spelling checker agent, restaurant searcher), designed to assist users in finding a restaurant mainly based on what transportation they use and if a restaurant is found, the chatbot could display the route to this place in the prompt also with map details by employing the Google map API. The machine learning agent acting as the brain of this chatbot, could not only be able to evoke other agents corresponding to users’ input but also could directly store what kinds of transportation are taken by users and pass to Google map API to search appropriate restaurants instead of fully relying on a restaurant searcher agent (rule-based agent). To examine whether multiple agents coordinate with each other could outperform a single agent. A contrast experiment is conducted to conclude the result, which involves 15 participants who run through this program under two different setups (with and without spelling and grammar checkers) and each of them would give a query to this chatbot but this query would be dealt with and without spelling and grammar checker respectively. The result would be quantitatively evaluated by two metrics: Success Rate: successfully finding a restaurant and showing the map; the Total of Queries. Results suggest that pre-processing input with spelling and grammar checkers significantly improves the chatbot's performance, achieving an 80\% success rate (12 out of 15 queries). In contrast, when input is not pre-processed, the success rate drops to 46.66\% (7 out of 15 queries). This indicates that the involvement of spelling and grammar checker agents enhances the accuracy and efficiency of restaurant searches, making the collaborative multi-agent setup more effective. Moreover, it could demonstrate that this chatbot environment is well constructed since it could successfully provide suitable restaurants given users’ requirements.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "427–434",
    numpages = "8"
}

@inbook{cons195,
    author = "Feng, Lei and Yu, Jiong and Li, Shu and Jiu, Shicheng",
    title = "VAE-SMOTE Augmented Diffusion for Anomaly Detection",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728751",
    abstract = "Most current generative models for anomaly detection, which rely on reconstruction methods, primarily use either Variational Autoencoders or Generative Adversarial Networks. However, VAEs tend to suffer from poor reconstruction quality, while GANs face challenges related to training stability and limited pattern coverage. Additionally, due to privacy and security concerns, the available training data for anomaly detection is often limited, whereas generative models typically require large datasets to avoid the risk of overfitting. To overcome these challenges, we introduce an unsupervised anomaly detection model utilizing diffusion techniques, designed specifically for tabular data, using a reconstruction-based approach. We adopt the diffusion model as the backbone for anomaly detection, aiming to enhance reconstruction quality and ensure training stability. To further improve reconstruction quality and accelerate inference, we employ a truncated diffusion strategy during inference. What's more, to overcome the challenge of insufficient training data, we introduce a SMOTE-based data augmentation method optimized for feature space in tabular data, incorporating a VAE to address the limitations of the original SMOTE algorithm in capturing complex data structures and handling nonlinear relationships. Experimental results on real-world datasets validate that our method achieves higher detection accuracy compared to conventional methods, demonstrating its effectiveness.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "163–170",
    numpages = "8"
}

@inproceedings{cons196,
    author = "Zheng, Jiamin and Zhang, Qilin and Song, Shaoyi and Zhao, Xuan and Zhou, Yipeng",
    title = "Research on Deep Prediction of Agricultural Product Quality Based on Multi Model Fusion: A Case Study of Eel",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728776",
    doi = "10.1145/3728725.3728776",
    abstract = "This study focuses on the prediction of eel meat quality storage. Given the urgent need for quality control of agricultural products in the agricultural industry, key indicators such as water content, malondialdehyde content, carboxyl content, and colony index were covered using the 1-120 day eel meat quality data provided by A. After a rigorous data cleaning process and removal of outliers, the advantages of CNN-LSTM Transformer model fusion are utilized. CNN extracts local features, LSTM captures long-term dependencies, and Transformer processes global dependencies, effectively improving prediction accuracy. Through in-depth analysis of 1-120 day data, key indicators of eel meat quality changes from 121-180 days were successfully predicted. This study provides a powerful tool for the quality control of eel meat, promotes sustainable development of the agricultural industry, and is of great significance for ensuring the quality of agricultural product market supply and reducing losses.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "320–325",
    numpages = "6",
    keywords = "CNN-LSTM-Transformer, Eel quality, prediction of agricultural product quality indicators, vacuum packing",
    location = "",
    series = "GAIIS '25"
}

@inbook{cons197,
    author = "Lin, Zhenyang",
    title = "Metal Level Measurement and Compensation Based on the MiDas Model",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728780",
    abstract = "Accurate measurement of liquid metal levels is critical to the safety and efficiency of industrial process monitoring and automation. Traditional contact-based measurement methods face significant limitations in high temperature and extreme environments, such as safety risks, inaccurate measurements due to interference with the environment, and short equipment life. To address these challenges, this study proposes an innovative non-contact measurement method using a visual depth estimation technique based on deep learning. The MiDaS model captures an image of a liquid metal surface by a monocular camera in an industrial environment. A deep neural network then estimates their depth by processing these images. By calculating the vertical distance between the liquid metal level point and a predefined reference point, real-time and accurate monitoring of the liquid level height is realized. This study not only introduces a new non-contact solution for measuring the height of liquid metal surfaces, but also enhances the potential applications of deep learning in industrial vision measurement and depth estimation.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "342–346",
    numpages = "5"
}

@inbook{cons198,
    author = "Liu, Shiqing",
    title = "MGF-GNN: A Multi-Granularity Graph Fusion-based Graph Neural Network Method for Network Intrusion Detection",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728822",
    abstract = "With the increasing complexity and diversity of network attacks, Graph Neural Networks (GNNs) have been employed to address network intrusion detection challenges. However, the performance of these models is constrained by their reliance on a single graph construction approach. To enhance detection accuracy and adaptability to intricate attack patterns, this paper introduces a Multi-Granularity Graph Fusion-based Graph Neural Network (MGF-GNN) model. The model resolves the issue of a single granularity graph structure failing to fully capture the complex relationships and covert attack strategies in network traffic. It constructs three heterogeneous graphs at different granularities to capture traffic relationships from host-level, port-level, and protocol-level perspectives. The model employs hierarchical message passing, aggregation, and cross-graph information fusion mechanisms to strengthen its ability to learn multi-level information, thereby improving detection performance against complex attacks. MGF-GNN outperforms traditional machine learning methods and single-graph-based GNN models on the CIC-IDS2017 and UNSW-NB15 datasets, achieving significant improvements across multiple evaluation metrics, including accuracy, precision, recall, and F1 score. Its effectiveness is primarily attributed to MGF-GNN's ability to comprehensively learn multi-dimensional perspective information through multi-granularity graph fusion.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "616–620",
    numpages = "5"
}

@inproceedings{cons199,
    author = "Wang, Zhenyu and Zhang, Xiangchun and Zhang, Xiaoqing and Zeng, Zhaoyang and Peng, Wensheng and Yan, Jia",
    title = "Study of Bi-loop BERT-based Corner Tagging Joint Event Extraction",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734927",
    doi = "10.1145/3734921.3734927",
    abstract = "A Bi-loop BERT-based Corner Tagging (Bi-BCT) joint event extraction model is introduced to enhance aviation accident report analysis by addressing cascading errors and redundancy. Leveraging pre-training models, triggers are identified. Context and features are merged to compute argument confidence. Corner tagging matrix is used for triples decoding. Textual specifics of aviation accidents are analyzed to expand the Aviation Accident Report (AAR) dataset, boosting its quality by 7.05\%. Experimental results on the AAR dataset reveal Bi-BCT outperforms the Onerel model with a 9.2\% accuracy, 7.2\% recall, and 8.2\% F1 value improvement, showcasing its efficacy in aviation accident information extraction.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "32–40",
    numpages = "9",
    keywords = "Aviation accidents, Datasets, Deep learning, Event extraction, Large Language models",
    location = "",
    series = "GADM '25"
}

@inbook{cons200,
    author = "Song, Haocheng and Yu, Pengfei and Ou, Jiayi and Li, Wei and Gu, Jingjing",
    title = "A Convolutional Neural Network Reinforcement Framework Based on Neural Network Interpretability",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728817",
    abstract = "With the wide deployment of deep learning models in various applications, the reliability problem of neural networks has gradually become a research hotspot. Computer systems are susceptible to single-particle effects, electromagnetic interference, and other factors in complex environments, resulting in frequent bit-flipping faults. Among them, Silent Data Corruption (SDC), as an imperceptible fault, cannot be detected by the system, which ultimately destroys the output results of neural network models. Current SDC detection techniques mainly focus on the system instruction stream level, and lack efficient methods to implement detection reinforcement at the model level. In addition, due to the black-box weight update mechanism of neural networks, traditional selective redundancy methods cannot provide a reliable explanation of which important weights to fix. To address these issues, this paper proposes a Convolutional Neural Network Reinforcement Framework Based on Neural Network Interpretability (RFNI). RFNI explores the redundancy ratio of convolutional kernels by performing layer-by-layer search in convolutional neural networks through SAC (Soft Actor-Critic) agent; secondly, the importance of each convolutional kernel in the current layer is calculated by combining with neural network interpretability algorithms; and finally, the importance of each convolutional kernel in the current layer is calculated based on the total Floating Point Operations Per Second (FLOPS). Second, the importance of each convolutional kernel in the current layer is calculated by combining with the neural network interpretable algorithm; finally, the granularity configurable redundancy reinforcement is implemented based on the total floating point operations per second (FLOPS). The experimental results show that RFNI on multiple neural network architectures significantly improves the recognition accuracy in case of SDC over existing methods, and can effectively enhance the robustness of the model.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "585–590",
    numpages = "6"
}

@inbook{cons201,
    author = "Xiong, Yuzhu and Du, Hongwei and Zhang, Daikun",
    title = "A Guided-learning Network for Brain Tumor Segmentation with Missing Modalities",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728759",
    abstract = "Accurate segmentation of brain tumors is essential for clinical assessment and treatment planning, as it leverages multiple MRI modalities to provide complementary diagnostic information. However, missing modalities are frequently en- countered in clinical practice due to factors such as image degradation, artifacts, protocol inconsistencies, or patient con- traindications to contrast agents. While certain unified models are designed to accommodate various missing modality scenarios, their performance declines markedly when multiple modalities are absent, particularly in cases where only a single modality is available. To tackle this challenge, we introduce a Guided- learning Network that leverages dynamic FFT filters. This network trains multiple specialized models designed for different missing modality scenarios, achieving outstanding performance. The architecture comprises two distinct learning paths: one dedicated to capturing multimodal information and another focused on generating modality-specific representations for the missing modality. A guided-learning strategy connects these two paths. Initially, the multimodal path is trained and its parameters are locked, enabling the missing modality path to learn under its guidance. The training process incorporates several key com- ponents: adversarial learning to align high-level features across paths, frequency-domain adaptive filtering using dynamic FFT filters to extract global features, and mutual information transfer to ensure critical information is retained even when modality data is missing. Experiments conducted on the BraTS2018 dataset demonstrate that our model outperforms comparable state-of- the-art methods in all missing modality cases.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "219–225",
    numpages = "7"
}

@inbook{cons202,
    author = "Chen, Xunlin and Li, Xiaoju and Chen, Ziyong",
    title = "Research on Weed Identification Based on Deep Learning",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728820",
    abstract = "In the intricate environment where crops and weeds grow intermingled, an effective solution to this problem is to precisely spray herbicides on weeds while accurately avoiding crops. The technical reliance in this process is the focus of this paper, which involves classifying, identifying, and locating weeds and crops. Currently, deep learning is widely used for image recognition and classification. However, the complex characteristics of the intermingled growth of weeds and crops are the main factors affecting the extraction of weed features. Based on an extensive review of domestic and foreign literature, and combining the research progress and methods of deep learning in the field of image recognition, this paper designs a method that can identify weeds with complex characteristics, effectively improving the accuracy of weed image recognition. This provides a favorable reference for the rapid and precise targeted spraying of herbicides in agricultural intelligent equipment or other devices beneficial to human life.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "605–609",
    numpages = "5"
}

@inbook{cons203,
    author = "Li, Fengdi",
    title = "MH-PEFT: Mitigating Hallucinations in Large Vision-Language Models through the PEFT Method",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728747",
    abstract = "Large vision-language models (LVLMs) have achieved significant progress and been widely applied across various industries. However, a series of significant challenges have also been posed, such as the hallucination, where the generated attributes of a target are inconsistent with the information in the image. Recent works have primarily focused on improving generation performance by training the multimodal alignment module of the model with additional data. However, this approach incurs higher costs and introduces redundant information due to the reliance on large amounts of additional data. To address these challenges, we propose a novel multimodal mitigation framework, termed MH-PEFT. Specifically, we introduce an effective data augmentation strategy that leverages existing data to generate additional attribute-related information, thereby enhancing the model's generative capabilities. Furthermore, we develop a PEFT-based training approach specifically tailored to mitigate multimodal hallucination in LVLMs. Notably, our framework features a plug-and-play design, which enhances its robustness and facilitates its deployment in real-world scenarios. Extensive experiments demonstrate that our method achieves state-of-the-art performance across multiple benchmark datasets.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "137–142",
    numpages = "6"
}

@inbook{cons204,
    author = "Fang, Heng",
    title = "ColKGC: Collaborative Enhancement using Large Language Model for Knowledge Graph Completion",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728736",
    abstract = "Knowledge Graph Completion (KGC) aims to address incomplete facts in Knowledge Graphs (KGs). As a mainstream approach for KGC, text-based methods are limited in performance due to insufficient knowledge caused by constraints in fine-tuning data. To incorporate broader external knowledge, some researchers explored KGC approaches based on large language models (LLMs), but general-purpose LLMs lack direct awareness of knowledge graph domain knowledge, making it challenging for them to independently perform KGC tasks. To balance the dependence of text-based methods on knowledge graph domain knowledge and LLMs on external knowledge, we propose Collaborative Enhancement using Large Language Model for KGC (ColKGC). We define the prompt template to implement the interaction between the text-based model and the LLMs, and divide the knowledge graph completion process into two stages. In the concept enhancement stage, we supplement the fine-tuning data by interacting with the prompts of the LLMs to enrich the graph domain knowledge learned by the text-based model. In completion inference stage, we adopted the iterative interaction strategy, taking the text-based model output as the prompt and taking the interaction content of the previous stage as the context to enhance the inference, which improved the LLMs' understanding of the KGC task. Our experiments demonstrate that ColKGC achieves superior results across various standard knowledge graph benchmarks. Extensive experiments also bear out ColKGC's efectiveness in generated data and the iterative interaction framework in assisting LLMs reasoning.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "66–71",
    numpages = "6"
}

@inproceedings{cons205,
    author = "Chen, Duan and Wang, Yining and Zhang, Junyi",
    title = "Research on the Mechanism between Public Opinion Transmission and Capital Market Response of Artificial Intelligence Technology Innovation Events: A Multilevel Network Analysis Study",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734942",
    doi = "10.1145/3734921.3734942",
    abstract = "In the contemporary flourishing digital economy, advancements in artificial intelligence are incessantly reconfiguring the capital market landscape. This study commences with the industry perturbation instigated by the DeepSeek large - model to explore the interactive mechanisms between financial public opinion and capital markets during technological innovation events. Through the comprehensive utilization of methods such as literature review, case analysis, social network analysis, and regression analysis, and drawing on 12,329 Weibo public opinion data points and high - frequency trading data from 16 A - share DeepSeek concept stocks, a novel “technology decoding – market response” dual - path model is constructed. The study reveals that technology - related public opinion gradually infiltrates the financial domain via a three - stage progression: “professional decoding – industry restructuring – investment decision - making.” Technology bloggers assume a pivotal role in information dissemination, as evidenced by an intermediary centrality of 0.29. The data further indicate that for each one - standard - deviation increment in public opinion intensity, the excess return of concept stocks surges by 1.8\% after 36 hours (p = 0.03), whereas the impact of sentiment polarity on stock prices is not statistically significant (β = 0.04, p = 0.41).Adopting an integrated perspective from journalism and behavioral finance, this research elucidates the propagation patterns of technology - related public opinion and its inherent connections with capital markets, and it formulates a “technology–finance” public opinion governance framework. These findings provide crucial theoretical underpinnings and practical guidelines for the prevention of financial risks associated with technology - related public opinion, thereby having far - reaching implications for optimizing financial market regulation and enhancing public opinion management systems.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "133–139",
    numpages = "7",
    keywords = "financial contagion, multi-level network, public opinion governance, social network analysis, technology-related public opinion",
    location = "",
    series = "GADM '25"
}

@inbook{cons206,
    author = "Wang, Xin and Ma, Zhizhen and Zhang, Lu",
    title = "Research on Privacy Protection Evaluation System Based on the Internet Connectivity Characteristics of Intelligent Vehicles",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728798",
    abstract = "This paper aims to establish an evaluation system based on objective assessment methods in the field of privacy protection testing and evaluation for intelligent vehicles. By applying the Delphi method and the Analytic Hierarchy Process (AHP), the selection of privacy protection evaluation objects, the establishment of a hierarchical evaluation index system, and the allocation of weights were completed. This paper selected 15 mainstream models on sale and conducted experimental verification based on the established privacy protection evaluation system. The loss points were analyzed from the overall dimension and the hierarchical index dimension according to the evaluation results.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "466–472",
    numpages = "7"
}

@inproceedings{cons207,
    author = "Zhou, Wanzhen and Guo, Haohao and Wang, Jianxia",
    title = "Development of a Child-Adult Binding Access Control System Using Face Recognition",
    year = "2025",
    isbn = "9798400713460",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3734921.3734929",
    doi = "10.1145/3734921.3734929",
    abstract = "Aiming to address the need for child supervision in closed public spaces, this paper proposes an intelligent access control system based on face recognition. The system adopts lightweight MTCNN and MobileFaceNet algorithms to dynamically bind the identities of children and adults by generating unique ID codes (timestamp + random six-digit number). During entry, an adult generates an ID code via face detection and associates it with the child's information. During exit, a child can only pass if their ID code matches the associated adult's ID. Experimental results demonstrate that the system achieves a recognition accuracy of 99.93\%, a single binding time of 2.8 seconds, and a database response time of less than 10 ms under high concurrency (1000 QPS). This system enables accurate guardianship without pre-registration and effectively reduces the risk of children getting lost or being taken by unauthorized individuals.",
    booktitle = "Proceedings of the 2025 International Conference on Generative Artificial Intelligence and Digital Media",
    pages = "47–51",
    numpages = "5",
    keywords = "Child protection, Dynamic identity binding, Face recognition, No pre-registration",
    location = "",
    series = "GADM '25"
}

@inbook{cons208,
    author = "Zhang, Feng and Xu, Haonan and Yuan, Shuai",
    title = "Unsupervised Homography Estimation Method Based on Edge Detection and Feature Fusion",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728789",
    abstract = "Traditional homography estimation uses methods such as SIFT and ORB in feature extraction but suffers from problems such as feature sparsity in large baseline scenes with large viewing angles and low overlap, causing inaccurate homography estimation. This paper proposes an unsupervised method that combines edge detection and feature fusion to solve the above problems. Firstly, three layers of image features are extracted by the feature pyramid; secondly, the edge detection module extracts the edge features of the input image and feature map; then, the features are fused by adaptive feature fusion and attentional feature fusion; finally, correlation is computed layer-by-layer using the fused features to estimate the homography. In this paper, experiments have been conducted to verify the method's effectiveness by calculating the PSNR and SSIM metrics. Experimental results show that this method can estimate homography more accurately than other related methods when stitching large baseline images.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "405–410",
    numpages = "6"
}

@inbook{cons209,
    author = "Liu, Xiaomeng and Liu, Jia and Li, Jiayuan and Zhou, Yong and Xiang, Shengchang",
    title = "Research on the Application of LLM in Institutional Compliance and Early Warning",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728738",
    abstract = "Enterprise compliance management faces various challenges in today's business operations. This article proposes a new method for institutional compliance inspection and early warning based on LLM, which aims to focus on enterprise compliance and early warning monitoring as the core, using intelligent LLM technology, combined with artificial intelligence, machine learning and natural language processing technologies, to empower enterprise institutional revision, dynamic management, and execution, establish intelligent tools that adapt to the dynamic and efficient management needs of the system, realize the intelligence of institutional-related business and management, and promote the improvement of the institutional management system, promote lawful and compliant operation, and achieve high-quality development.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "80–86",
    numpages = "7"
}

@inproceedings{cons210,
    author = "Li, Hong",
    title = "Research and application of neural network algorithm based on Water supply and drainage pipeline network",
    year = "2024",
    isbn = "9798400709562",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3665348.3665410",
    doi = "10.1145/3665348.3665410",
    abstract = "The explosion/leakage problem of the water supply and drainage pipeline network is the main hidden danger problem in the current domestic water supply and drainage system. GIS technology for equipment management and algorithm research in the water supply and drainage pipeline network to solve this problem. This article provides an evaluation method for the leakage problem of underground pipeline networks based on BP neural network algorithm and genetic algorithm, which is based on historical accident type data, time data, and regional feature data of accident points. The data is then processed and transformed into neural network model data, which is then trained and verified by the neural network model. The results have shown that this method can not only make predictions before water pipe leakage or even explosion accidents occur, but also provide accurate and effective guidance for daily pipeline inspections, and improve work efficiency. This solution can be applied to various pipeline networks and has strong application and economic value in avoiding water resource loss.",
    booktitle = "Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security",
    pages = "364–369",
    numpages = "6",
    location = "Kuala Lumpur, Malaysia",
    series = "GAIIS '24"
}

@inbook{cons211,
    author = "Yang, Wangfeng and Li, Zhongyang",
    title = "Research on the Development and Application of Digital Twin Technology in the Field of Aircraft Maintenance and Support",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728832",
    abstract = "With the development of science and technology, the modernization of equipment is accelerated, the application of digital twin technology in the field of aircraft maintenance and support has been moving from concept to reality and showing its unique and broad prospect. The combination of digital twin technology and intelligent maintenance technology can realize equipment failure prediction, rapid positioning and maintenance in order to increase the production efficiency and reduce the production cost. This paper introduces the research status of digital twin technology and its characteristics, discusses the obvious advantages in the field of aircraft maintenance and support and the possible development trend in the future. For aircraft, the application of digital twin in maintenance support is realized, the digital twin framework is constructed, and the simulation model of aircraft is established. The efficiency and reliability of maintenance support for aircraft are improved. This case has been applied in outfield aircraft support and can be further extended to the other equipment.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "680–684",
    numpages = "5"
}

@inbook{cons212,
    author = "Bao, Qiaozhi and Chen, Yanlin and Ji, Xusheng",
    title = "Research on evolution and early warning model of network public opinion based on online Latent Dirichlet distribution model and BP neural network",
    year = "2025",
    isbn = "9798400713453",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3728725.3728748",
    abstract = "Online public opinion is increasingly becoming a significant factor affecting the stability of the internet and society, particularly as the frequency of online public opinion crises has risen in recent years. Enhancing the capability for early warning of online public opinion crises is urgent. The most effective approach is to identify potential crises in their early stages and implement corresponding management measures. This study establishes a preliminary indicator system for online public opinion early warning, based on the principles of indicator system construction and the characteristics and evolution patterns of online public opinion. Subsequently, data-driven methodologies were employed to collect and preprocess public opinion indicator data. Utilizing grey relational analysis and the K-Means clustering algorithm, we classified online public opinion events into three levels: slight, warning, and severe. Furthermore, we constructed an online topic evolution model using the online Hierarchical Dirichlet Process model to analyze the thematic changes of online public opinion events across different warning levels. Finally, we developed an online public opinion early warning model using a Backpropagation (BP) neural network. The test results of early warning samples show that the model achieves high accuracy. Thus, in practical early warning applications, the BP neural network can be effectively utilized for predicting online public opinion events.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security",
    pages = "143–151",
    numpages = "9"
}

@inproceedings{cons213,
    author = "Sikorski, \L{}ukasz and Matulewski, Jacek and Czerwonka, Ma\l{}gorzata",
    title = "On the Attitudes of GameDev Industry Artists towards GenAI. Preliminary Results",
    year = "2025",
    isbn = "9798400714979",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3716489.3728432",
    doi = "10.1145/3716489.3728432",
    abstract = "The rapid development of generative artificial intelligence over the past two years has significantly impacted the video game development industry. Surprisingly, this impact extends beyond technical aspects such as software creation and testing, but primarily influences its creative side, including music preparation, 2D and 3D graphics, and game design. Due to its substantial effect on team efficiency, this new technology has been swiftly adopted. This study explores the attitudes towards generative AI of artists working in the video game development industry and fine arts students interested in this field. It examines both the creative aspects and the perceived threats to creators' jobs posed by this technology.",
    booktitle = "Proceedings of the 2025 Computers and People Research Conference",
    articleno = "2",
    numpages = "6",
    keywords = "Artists' attitudes towards AI, Generative artificial intelligence, Video game industry",
    location = "",
    series = "SIGMIS-CPR '25"
}

@inproceedings{cons214,
    author = "Cuervo-Rosillo, Roberto and Zarraonandia, Telmo and D\'{\i}az, Paloma",
    title = "Using Generative AI to Support Non-Experts in the Creation of Immersive Experiences",
    year = "2024",
    isbn = "9798400717642",
