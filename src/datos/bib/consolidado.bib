    author = "Matos, Tomás and Santos, Walter and Zdravevski, Eftim and Coelho, Paulo Jorge and Pires, Ivan Miguel and Madeira, Filipe",
    title = "A systematic review of artificial intelligence applications in education: Emerging trends and challenges",
