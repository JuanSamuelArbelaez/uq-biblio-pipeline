    author = "Medicherla, Raveendra Kumar and Rajbhoj, Asha and Patwardhan, Manasi and Sanagavarapu, Lalit Mohan and Sharma, Vibhu Saujanya and Naik, Ravindra and Aggarwal, Pooja",
