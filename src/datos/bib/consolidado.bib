    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3756423.3756512",
    doi = "10.1145/3756423.3756512",
    abstract = "As the core of the manufacturing industry, industrial mother machines are undergoing a transformation from digitalization to intelligence, with AI and big data models playing a crucial role. This paper explores the cutting-edge technologies in AI and big data models for industrial mother machines. By defining and classifying industrial mother machines and highlighting their importance in modern industry, this paper uses a literature analysis tool to analyze the trend of technology integration between AI and industrial mother machines. It explains the advantages and challenges of applying AI and big data models to industrial mother machines. Based on the problems of data security, quality, and technology integration that need to be solved in the current intelligent transformation of industrial mother machines, this paper studies the application scenarios and industry impact of industrial mother machines after integrating AI technology deeply into the entire life cycle of the industrial mother machine industry, thereby fundamentally improving production efficiency.",
    booktitle = "Proceedings of the 2025 International Conference on Artificial Intelligence and Smart Manufacturing",
    pages = "536–543",
    numpages = "8",
    location = "",
    series = "ICAISM '25"
}

