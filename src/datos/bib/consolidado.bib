    url = "https://www.sciencedirect.com/science/article/pii/B9780323955041003690",
    keywords = "Applied linguistics, Language education, Language learning, Language teaching, Research methods",
    abstract = "This article offers an overview of research methods in language education. It begins by defining research and introducing major research approaches: quantitative, qualitative, and mixed methods. Common research designs such as experimental, survey, case study, ethnographic, and action research are then discussed. Critical considerations for empirical studies and essential research techniques are also introduced. The article presents research quality criteria, including validity, trustworthiness, reliability, and ethics."
}

@article{cons3166,
    author = "Chen, Jun and Li, Zhou and Kar-Narayan, Sohini and Luo, Dan and Wang, Xudong and Wu, Wenzhuo and Liu, Chaoran",
    title = "Nanogenerators for self-powered wearable devices",
    journal = "Cell Reports Physical Science",
    volume = "6",
    number = "6",
    pages = "102656",
    year = "2025",
    issn = "2666-3864",
    doi = "https://doi.org/10.1016/j.xcrp.2025.102656",
    url = "https://www.sciencedirect.com/science/article/pii/S2666386425002553",
    abstract = "Over the past few decades, researchers have developed a diverse array of nanogenerators capable of converting ambient mechanical energy—such as breezes, body movements, or even subtle breathing—into electrical power. This technology not only reduces reliance on conventional batteries but also enables the development of lightweight, flexible, and eco-friendly wearable devices. In this Voices article, we gather insights from a global panel of experts to explore the latest breakthroughs and remaining challenges in this rapidly evolving field."
}

