@article{cons3180,
    author = "Martin, U. and ’keeffe, N. O and Irudayaraj, B. and Mcsharry, P. and Reynolds, L. and Goff, P. and Boyd, P.",
    title = "AB1582-HPR “ LIVING YOUR BEST LIFE, A SIMPLE GUIDE TO LIVING WITH ARTHRITIS”, DESIGN AND DEVELOPMENT OF A BOOKLET BASED ON THE SIX PILLARS OF LIFESTYLE MEDICINE",
    journal = "Annals of the Rheumatic Diseases",
    volume = "83",
    pages = "2165-2166",
    year = "2024",
    issn = "0003-4967",
    doi = "https://doi.org/10.1136/annrheumdis-2024-eular.5059",
    url = "https://www.sciencedirect.com/science/article/pii/S0003496724182350",
    keywords = "Lifestyles, Patient information and education",
    abstract = "Background: Health systems globally are facing huge challenges to deal with the ever-growing numbers of non-communicable diseases (NCD’s), the majority of which are lifestyle associated. In the Irish context, 1.07million people have one or more chronic diseases, 76\% of deaths are attributed to chronic disease and there is a 4\% increase in chronic disease each year (Healthy Ireland Survey 2015: Summary of findings, 2021).Patients with RA have co-morbidities such as cardiovascular disease and hypertension (Pranata et al 2020). Lifestyle choices such as smoking have been shown to reduce treatment response (Aimer et al 2020). Cornelissen et al (2021) exploring what matters to patients with RA when facing medical decisions, patients emphasised the value of healthy lifestyle and keeping up their physical fitness. Objectives: To produce an evidence based booklet to support the patient and the clinician to incorporate lifestyle medicine into rheumatology clinical care. Methods: Funding was secured via a nursing bursary award. The project lead, brought together a team of seven experts including nursing, physiotherapy, occupational therapy, dietetics, substance misuse, health coaching and patients. The group collaborated with a design expert to conceptualize the booklet, key messages, tone and brand. Each healthcare professional created content for each lifestyle pillar according to their expertise. Patient feedback informed change through the process. Results: The booklet facilities lifestyle changes with a range of tools to activate patient participation to identify and address small changes in each pillar and their relationship with arthritis. Bridges self-management tools and language is a theme through all six pillars offering person centred techniques to facilitate and guide individual behaviour change meaningful to each patient. Conclusion: Lifestyle changes can have a significant impact on health and arthritis. By using the principles of lifestyle medicine patients have the potential to adapt and sustain positive lifestyle changes and live their best life with arthritis. REFERENCES: NIL. Acknowledgements: RCSI Faculty of Nursing and Midwifery. Disclosure of Interests: Una Martin Abbvie Ireland, Nicole O’Keeffe: None declared, Bindu Irudayaraj: None declared, Patsy McSharry: None declared, Louise Reynolds: None declared, Paul Goff: None declared, Peter Boyd: None declared. Figure 1 Figure 2"
}

@article{cons3181,
    author = "Koçak, Toprak and Danış, Nilay and Döngelli, Hüseyin and {Aysal Ağalar}, Anıl and Bengi, Goksel and Akarsu, Mesut",
    title = "Serum fibrosis scores as predictors of liver fibrosis and long-term outcomes in metabolic dysfunction-associated steatotic liver disease, including cirrhosis",
    journal = "Revista de Investigación Clínica",
    volume = "77",
    number = "4",
    pages = "100016",
    year = "2025",
    issn = "0034-8376",
    doi = "https://doi.org/10.1016/j.ric.2025.100016",
    url = "https://www.sciencedirect.com/science/article/pii/S0034837625004723",
    keywords = "Fibrosis scores, Liver cirrhosis, MASLD, Prognosis",
    abstract = "Background Metabolic dysfunction-associated steatotic liver disease (MASLD) is commonly linked to liver fibrosis, which may progress to cirrhosis. FIB-4, APRI, and NFS are used to predict fibrosis severity, but their accuracy and role in long-term outcomes remain unclear. Objectives This study evaluates the predictive value of these scores for fibrosis and assesses the incidence of de novo cirrhosis and survival outcomes in MASLD patients. Methods This retrospective, single-center study included 175 MASLD patients in our university medical center. The diagnostic performance of FIB-4, APRI, and NFS for advanced fibrosis (stage 3–4) was assessed using receiver operating characteristic (ROC) analysis. Cox regression analysis was performed to evaluate factors associated with de novo cirrhosis and survival outcomes. Results The mean age was 49.9±14.1 years, and 54.9\% were female. The median follow-up was 78 months. ROC analysis showed FIB-4 (AUC: 0.77) was the best predictor of advanced fibrosis, followed by APRI (AUC: 0.74) and NFS (AUC: 0.74). Multivariate analysis identified fibrosis stage (HR: 3.045, p=0.001) and hypertension (HR: 4.096, p=0.047) as independent predictors of de novo cirrhosis. Age (HR: 1.070, p=0.031), albumin (HR: 15.151, p<0.001), and HbA1c (HR: 1.589, p<0.001) were independently associated with survival. Conclusion FIB-4 was the most accurate predictor of advanced fibrosis. Fibrosis stage and hypertension were the strongest predictors of de novo cirrhosis. These findings highlight the importance of fibrosis staging and comorbidity management in MASLD."
}

@article{cons3182,
    author = "L., Bagley and J., Wilson and A., Kime",
    title = "The story so far………- current opinion in the use and applications of interactive storytelling in physiology and clinical education",
    journal = "Current Research in Physiology",
    volume = "8",
    pages = "100142",
    year = "2025",
    issn = "2665-9441",
    doi = "https://doi.org/10.1016/j.crphys.2025.100142",
    url = "https://www.sciencedirect.com/science/article/pii/S2665944125000045",
    abstract = "Physiology and clinical practice are subjects of study which demand integration of multiple sources of systems working knowledge and information on the performance of those systems to come to meaningful conclusions. This is made more complex by the interpretation and actions as a result of this conclusion having direct impact on the sum of the component systems, the human, thereby integrating significant social and psychological considerations into an already complex situation. As higher education educators, it is a significant challenge to provide our learners with training and most importantly, practice, in these knowledge, skills and behaviours in the classroom. There has been a significant interest in recent years in providing active learning opportunities which allow learners to apply subject knowledge to multi-faceted, immersive, continuously evolving stories which reflect a graduate's professional aspirations. This review highlights practices from the literature of storytelling education which the higher education educator can utilise in promoting “meaning making” in the classroom. Here, the case for interactive storytelling in physiology and clinical education is argued, as well as presenting commonly utilised techniques and practices with which educators can embed storytelling into their pedagogy as well as highlighting future directions in this field."
}

