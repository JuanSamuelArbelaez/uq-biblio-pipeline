}

@inproceedings{cons820,
    author = "Chang, Le",
    title = "Reconstruction of Writing instruction with Generative AI in SAMR Framework: A Multimodal Empirical Study",
    year = "2025",
    isbn = "9798400713811",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3746469.3746605",
    doi = "10.1145/3746469.3746605",
    abstract = "As a case of education digital transformation, traditional English writing pedagogy is difficult to truly encourage the interest of the students on writing and develop writing ability. A joint of generative AI and SAMR model offers innovation potential to writing teaching, but fewer studies exist on its implementation in vocational English writing teaching. This study enlisted students from two comparable classes of writing courses in a vocational school. The control group was instructed in generative AI supported writing instruction based on the SAMR model, while the control group was instructed in traditional writing instruction. Writing tests were given before and after teaching, and score data were collected and analyzed in terms of several aspects. The test results showed that the experimental group students' writing scores improved significantly with a dense distribution of scores and the number of students scoring high. The improvement in the control group was smaller, with a diffuse distribution and wide fluctuation. Independent sample t-tests also confirmed the effectiveness of the new teaching method. The study provides strong evidence for the reform of English writing education in vocational colleges.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area Education Digitalization and Computer Science International Conference",
    pages = "877–881",
    numpages = "5",
    keywords = "Generative AI, Multimodal empirical research, SAMR framework, Writing instruction",
    location = "",
    series = "EDCS '25"
}

@inproceedings{cons821,
    author = "He, Ping and Yang, Yin",
    title = "Future Education: Freedom and Comprehensive Human Development in the Age of Artificial Intelligence",
    year = "2025",
    isbn = "9798400712692",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3722237.3722374",
    doi = "10.1145/3722237.3722374",
    abstract = "Artificial intelligence has a powerful database and language generation function, which can be used as an extension of the human brain to a certain extent. Its application in the field of education has brought about a double-sided effect. On the one hand, AI promotes the great enrichment of material and spiritual wealth and makes it possible to liberate people's hands, which are the basis and conditions for human's freedom and all-round development. On the other hand, AI also brings some hidden worries to education: reshaping people's values, exacerbating the gap in educational resources, and triggering ethical controversies. Based on the Marxist theory on the freedom and comprehensive development of human beings, this paper focuses on the hidden worries of future education under the influence of artificial intelligence to explore the reform paths of future education. The reform paths including establishing correct value concepts to correctly understand the value of education; focusing on independent and diversified learning to cultivate students’ ability of independent critical thinking; breaking down technological barriers to build a technology development platform and share AI technology; sounding ethical rules as well as strengthening institutional regulations and technological protection support to shape the concept of science and technology for good and enhance people's awareness of digital security and self-protection. Promoting future education's reformation in the age of artificial intelligence with correct values, fair educational resources and sound ethical rules can play a good role in educating and cultivating autonomous, diversified and comprehensive new-age talents.",
    booktitle = "Proceedings of the 2024 3rd International Conference on Artificial Intelligence and Education",
    pages = "780–787",
    numpages = "8",
    keywords = "Artificial Intelligence, Educational Worries, Freedom and Comprehensive Human Development, Future Education, Reform Paths,",
    location = "",
    series = "ICAIE '24"
}

@inproceedings{cons822,
    author = "Hesenius, Marc and Bachert, Marvin",
    title = "Does My Data Fit? Assessing the Compatibility Between New and Existing Data",
    year = "2024",
    isbn = "9798400706516",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3660515.3662840",
    doi = "10.1145/3660515.3662840",
    abstract = "With the widespread use of Machine Learning within interactive applications, high-quality data is key to ensuring an acceptable User Experience. This applies to training data as well as runtime data used for inference. Also, with the increasing demand for training data, data synthesis is interesting, but synthetic data must be similar to real data. Software Engineers thus need methods to assess data quality. This tutorial equips participants with techniques to check whether new data aligns with existing data. We offer practical insights and techniques to address the challenges in validating synthetic data, e.g., for test automation, and verifying if runtime data conforms to training data. Focusing on gesture recognition, participants will learn to differentiate between data suitable for the trained gesture recognizer and data that will potentially yield wrong results and thus lead to an undesirable User Experience.",
    booktitle = "Companion Proceedings of the 16th ACM SIGCHI Symposium on Engineering Interactive Computing Systems",
    pages = "113–114",
    numpages = "2",
    keywords = "Data Synthesis, Human-Computer Interaction, Out-of-Distribution Testing",
    location = "Cagliari, Italy",
    series = "EICS '24 Companion"
}

@inproceedings{cons823,
    author = "Schier, Florian and Senechal, Nathalie and Badeja, Daniel and McGinity, Matthew",
    title = "Evoking Emotions in Virtual Reality: A Comparative Study of Simulation Methods",
    year = "2025",
    isbn = "9798400715822",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3743049.3748559",
    doi = "10.1145/3743049.3748559",
    abstract = "Virtual Reality Exposure Therapy (VRET) has proven effective for treating anxiety disorders, yet little is known about how different Virtual Reality (VR) simulation methods compare in their ability to evoke emotional responses. This study examined three methods – binaural-audio-based, 180° stereoscopic video-based, and computer-generated VR – to determine their effectiveness in eliciting fear and joy. Twelve participants experienced all methods, each presenting dogs exhibiting friendly, neutral, and aggressive behaviors. Emotional responses and sense of presence were measured after each behavior block and retrospectively. Results indicate that computer-generated and video-based VR elicit significantly higher levels of fear and joy compared to audio-only, with computer-generated VR producing higher fear responses in aggressive scenarios. Despite similar effectiveness, production requirements differed substantially: computer-generated VR required approximately six times longer than video-based VR. These findings suggest that while computer-generated VR may offer optimal emotional engagement for VRET, video-based approaches provide a resource-efficient alternative with comparable emotion elicitation.",
    booktitle = "Proceedings of the Mensch Und Computer 2025",
    pages = "560–564",
    numpages = "5",
    keywords = "Virtual Reality, Emotion Elicitation, Exposure Therapy, Single User, VR Modalities",
    location = "",
    series = "MuC '25"
}

@inproceedings{cons824,
    author = "Yang, Lixue and Qiu, Sijia",
    title = "BLEU Function Analysis of Machine Translation Based on Transformer Model",
    year = "2025",
    isbn = "9798400712845",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3726010.3726046",
    doi = "10.1145/3726010.3726046",
    abstract = "The internal structure and functions of the encoder and decoder of the Transformer model are reviewed, and the applications of self-attention mechanism, feed forward neural network, residual connection, and layer normalization are analyzed in the field of natural language processing. The Transformer model is introduced into machine translation as an engine, then the translation experiment is conducted, and the translation quality of the Transformer model is evaluated with the BLEU function. The findings reveal that, within the similar Transformer architecture, translations generated by GPT-4o as the translation engine exhibit higher quality compared to those produced by Youdao translation engine. However, the BLEU scores for both engines are relatively low, indicating a significant gap from the reference translation. This underscores the necessity for expert post-editing to further enhance quality, highlighting that human-machine interaction is currently an essential pathway for improving machine translation quality.",
    booktitle = "Proceedings of the 2024 International Conference on Artificial Intelligence, Digital Media Technology and Interaction Design",
    pages = "230–236",
    numpages = "7",
    keywords = "BLEU function, Machine translation, Neural network, Transformer model",
    location = "",
    series = "ICADI '24"
}

@inproceedings{cons825,
    author = "Isachi, Victor and Nadalini, Alessandro and Gallotta, Riccardo Fiorani and Garofalo, Angelo and Conti, Francesco and Rossi, Davide",
    title = "FractalSync: Lightweight Scalable Global Synchronization of Massive Bulk Synchronous Parallel AI Accelerators",
    year = "2025",
    isbn = "9798400715280",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3719276.3725203",
    doi = "10.1145/3719276.3725203",
    abstract = "The slow-down of technology scaling and the emergence of Artificial Intelligence (AI) workloads have led computer architects to increasingly exploit parallelization coupled with hardware acceleration to keep pushing the performance envelope. However, this solution comes with the challenge of synchronization of processing elements (PEs) in massive heterogeneous many-core platforms. To address this challenge, we propose FractalSync, a hardware accelerated synchronization mechanism for Bulk Synchronous Parallel (BSP) systems. We integrate FractalSync in MAGIA, a scalable tile-based AI accelerator, with each tile featuring a RISC-V-coupled matrix-multiplication (MatMul) accelerator, scratchpad memory (SPM), and a DMA connected to a global mesh Network-on-Chip (NoC). We study the scalability of the proposed barrier synchronization scheme on tile meshes ranging from 2 \texttimes{} 2 PEs to 16 \texttimes{} 16 PEs to evaluate its design boudaries. Compared to a synchronization scheme based on software atomic memory operations (AMOs), the proposed solution achieves up to 43 \texttimes{} speedup on synchronization, introducing a negligible area overhead ((lt 0.01\%)). FractalSync closes timing at MAGIA’s target 1GHz frequency.",
    booktitle = "Proceedings of the 22nd ACM International Conference on Computing Frontiers",
    pages = "84–87",
    numpages = "4",
    keywords = "Barrier Synchronization, Bulk Synchronous Parallel, Massively Parallel systems, Many-core architectures, AI Hardware Acceleration",
    location = "",
    series = "CF '25"
}

@inproceedings{cons826,
    author = "Gou, Pingzhang and Li, Wenqing and Wang, Chuxun",
    title = "Innovative Research on Theory-Practice Integrated Teaching Models Driven by Digital-Intelligence Fusion",
    year = "2025",
    isbn = "9798400713811",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3746469.3746521",
    doi = "10.1145/3746469.3746521",
    abstract = "Traditional theory-practice integrated teaching models in secondary vocational education encounter various challenges. Theoretical content often appears overly abstract, and teacher-student interaction tends to be one-side,practical resources are usually scattered, and teaching evaluations frequently fall behind. To address these issues, this study proposes a teaching model driven by intelligent-digital integration, aiming to unify theory and practice effectively. The integration of AR/VR interactive learning systems, modular digital training systems, and intelligent classroom analytics systems constructs a closed-loop teaching framework. This framework follows the sequence of theory, practice, and evaluation. A case study on the course Microcontroller Application Technology verifies the effectiveness of this implementation. Findings indicate that the proposed model significantly improves learning outcomes. It also raises the frequency of classroom interaction and enhances the efficiency of completing practical tasks. The model gathers data in real time and evaluates it from multiple dimensions. This optimizes the teaching process across its entire cycle. It provides technical methods and practical models. These can be replicated for the digital transformation of vocational education.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area Education Digitalization and Computer Science International Conference",
    pages = "313–317",
    numpages = "5",
    keywords = "Education's digital transformation, Educational technology, Microcontroller application technology, Secondary vocational education, Teaching that integrates theory and practice",
    location = "",
    series = "EDCS '25"
}

