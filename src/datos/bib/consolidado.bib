@article{cons2918,
    author = "{de Oliveira}, Déborah",
    title = "Assessing ChatGPT in digital education: A case study on student perception",
    journal = "Digital Engineering",
    volume = "7",
    pages = "100067",
    year = "2025",
    issn = "2950-550X",
    doi = "https://doi.org/10.1016/j.dte.2025.100067",
    url = "https://www.sciencedirect.com/science/article/pii/S2950550X25000330",
    keywords = "Education, Undergraduate, Engineer, Machining, AI, ChatGPT",
    abstract = "Recent advances and the widespread availability of Artificial Intelligence (AI) technologies have revolutionized students’ approaches to task resolution and have been increasingly recognized as important learning tools in recent research. To contribute to this understanding, the objective of this work was to assess students’ perceptions of the widely diffused chatbot ChatGPT and its use as a learning tool. A mixed methodology was employed, combining quantitative and qualitative analyses in a repeated cross-sectional study with an intervention. Data was collected from undergraduate students in Mechanical and Mechatronic Engineering across three different semesters. The qualitative evaluation indicated that the course level had no impact on students’ perceptions, and gender only influenced prior knowledge of ChatGPT, without affecting satisfaction or perceived usability. The strongest correlation was found between the perceived quality of the responses and overall satisfaction. Response quality was also a central theme in the qualitative data, with about 45 \% of respondents noting that ChatGPT should be used cautiously due to its lack of accuracy in more complex tasks. The study also evaluated ChatGPT's specific applicability as a learning tool in courses focused on machining. In this context, students viewed its use positively when applied as a complementary aid. Ultimately, the results suggest that, regardless of students' prior familiarity with ChatGPT, most were able to use it effectively, demonstrated critical thinking regarding its use, and expressed willingness to adopt it as a complementary learning tool."
}

@article{cons2919,
    author = "Patel, Pratham D. and Simpson, Ethan A. and Acker, Jason P.",
    title = "Irradiation and beyond: mitigating TA-GVHD in transfusion",
    journal = "Transfusion and Apheresis Science",
    volume = "64",
    number = "5",
    pages = "104237",
    year = "2025",
    issn = "1473-0502",
    doi = "https://doi.org/10.1016/j.transci.2025.104237",
    url = "https://www.sciencedirect.com/science/article/pii/S1473050225001752",
    keywords = "Irradiation, Graft vs host disease, Transfusion, Red blood cell, Adverse reactions, Leukoreduction",
    abstract = "Transfusion-associated graft-versus-host disease (TA-GVHD) is a rare but often fatal complication of allogeneic transfusion, caused by the activation and expansion of donor T lymphocytes in susceptible recipients. Prevention focuses on reducing these immune cells through leukoreduction and irradiation. While leukoreduction of blood components decreases white blood cell content and improves overall transfusion safety, it does not fully prevent TA-GVHD, as viable T cells may persist. Irradiation using gamma or X-ray methods remain the most effective strategy, inactivating donor T cells by inducing DNA damage and suppressing proliferation. However, it also compromises red blood cell quality by increasing hemolysis, oxidative injury, membrane damage, extracellular potassium, and reducing storage duration. As an alternative, hypothermic storage of leukoreduced red blood cells is gaining attention. Evidence suggests that extending storage beyond 21 days significantly reduces T cell viability and proliferation without compromising red blood cell integrity. Further research is needed to directly compare the efficacy of hypothermic storage to irradiation."
}

