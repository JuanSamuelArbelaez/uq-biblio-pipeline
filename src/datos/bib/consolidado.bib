@article{cons2956,
    author = "Fiorezi, Juliane Neves and Molz, Patrícia and {da Silva Schlickmann}, Diene and {dos Santos}, Caroline and Prá, Daniel and Berger, Sâmara Bittencourt and Renner, Jane Dagmar Pollo and Franke, Silvia Isabel Rech",
