@inproceedings{cons906,
    author = "Abir, Mushfiqur and Hosain, Md. Tanzib and Jubair, Md Abdullah Al and Mridha, M. F.",
    title = "IMVB7t: A Multi-Modal Model for Food Preferences based on Artificially Produced Traits",
