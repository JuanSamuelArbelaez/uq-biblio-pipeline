@article{cons2909,
    author = "Perry, Megan L. and Varney, Kristen M. and Tiwary, Pratyush and Weber, David J. and Hernández-Ochoa, Erick O.",
    title = "Unveiling the intricate role of S100A1 in regulating RyR1 activity: A commentary on “Structural insights into the regulation of RyR1 by S100A1”",
    journal = "Cell Calcium",
    volume = "123",
    pages = "102947",
    year = "2024",
    issn = "0143-4160",
    doi = "https://doi.org/10.1016/j.ceca.2024.102947",
    url = "https://www.sciencedirect.com/science/article/pii/S0143416024001052",
    keywords = "RyR1, S100A1, CaM, Ca1.1, Muscle contraction, Calcium release, Cryo-EM, modulation",
    abstract = "S100A1, a calcium-binding protein, plays a crucial role in regulating Ca2+ signaling pathways in skeletal and cardiac myocytes via interactions with the ryanodine receptor (RyR) to affect Ca2+ release and contractile performance. Biophysical studies strongly suggest that S100A1 interacts with RyRs but have been inconclusive about both the nature of this interaction and its competition with another important calcium-binding protein, calmodulin (CaM). Thus, high-resolution cryo-EM studies of RyRs in the presence of S100A1, with or without additional CaM, were needed. The elegant work by Weninger et al. demonstrates the interaction between S100A1 and RyR1 through various experiments and confirms that S100A1 activates RyR1 at sub-micromolar Ca2+ concentrations, increasing the open probability of RyR1 channels."
}

@article{cons2910,
    author = "Yi, Seung-Won and Cho, A-Ra and Do, Yoon Jung and Jung, Young-Hun and Lee, Han Gyu and Bok, Eun-Yeong and Hur, Tai-Young and Lee, Sung-Lim and Kim, Eunju",
    title = "Multi-organ metastases of primary chondrosarcoma of the mammary gland of a spayed Toy Poodle",
    journal = "Journal of Comparative Pathology",
    volume = "204",
    pages = "35-38",
    year = "2023",
    issn = "0021-9975",
    doi = "https://doi.org/10.1016/j.jcpa.2023.05.005",
    url = "https://www.sciencedirect.com/science/article/pii/S0021997523002311",
    keywords = "dog, mammary gland tumour, metastatic chondrosarcoma, Toy Poodle",
    abstract = "We report the clinical and histopathological findings associated with multi-organ metastases of primary mammary chondrosarcoma in a 12-year-old spayed female Toy Poodle. At post-mortem examination, multifocal, sharply demarcated, grey–white to bright brown, round nodules of variable size were randomly distributed in the lungs, myocardium, liver, pancreas, spleen, intestinal tract and kidneys. Histologically, immature cartilage structures and primitive mesenchymal cells were seen in these organs. Neoplastic cells located in the cartilaginous basophilic extracellular matrix had cytoplasmic vacuolation and round vesicular nuclei and were stained with Safranin O and Alcian blue. To the best of our knowledge, this is the first report of a multi-organ metastatic chondrosarcoma that originated in the mammary gland of a dog."
}

