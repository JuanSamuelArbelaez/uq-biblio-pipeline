}

@inproceedings{cons900,
    author = "Moore, Hayden and Qi, Sirui and Hogade, Ninad and Milojicic, Dejan and Bash, Cullen and Pasricha, Sudeep",
    title = "Sustainable Carbon-Aware and Water-Efficient LLM Scheduling in Geo-Distributed Cloud Datacenters",
    year = "2025",
    isbn = "9798400714962",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3716368.3735301",
    doi = "10.1145/3716368.3735301",
    abstract = "In recent years, Large Language Models (LLM) such as ChatGPT, Copilot, and Gemini have been widely adopted in different areas. As the use of LLMs continues to grow, many efforts have focused on reducing the massive training overheads of these models. But it is the environmental impact of handling user requests to LLMs that is increasingly becoming a concern. Recent studies estimate that the costs of operating LLMs in their inference phase can exceed training costs by 25\texttimes{} per year. As LLMs are queried incessantly, the cumulative carbon footprint for the operational phase has been shown to far exceed the footprint during the training phase. Further, estimates indicate that 500 ml of fresh water is expended for every 20–50 requests to LLMs during inference. To address these important sustainability issues with LLMs, we propose a novel framework called SLIT to co-optimize LLM quality of service (time-to-first token), carbon emissions, water usage, and energy costs. The framework utilizes a machine learning (ML) based metaheuristic to enhance the sustainability of LLM hosting across geo-distributed cloud datacenters. Such a framework will become increasingly vital as LLMs proliferate.",
    booktitle = "Proceedings of the Great Lakes Symposium on VLSI 2025",
    pages = "929–934",
    numpages = "6",
    keywords = "Carbon emissions, Energy cost, Large language model, Water",
    location = "",
    series = "GLSVLSI '25"
}

@inproceedings{cons901,
    author = "Krumpak, Roy and Ro\v{z}anec, Jo\v{z}e M. and Molan, Martin and Angelinelli, Matteo and Bartolini, Andrea",
    title = "Predicting Compute Node Unavailability in HPC: A Graph-Based Machine Learning Approach",
    year = "2025",
    isbn = "9798350355543",
    publisher = "IEEE Press",
    url = "https://doi.org/10.1109/SCW63240.2024.00103",
    doi = "10.1109/SCW63240.2024.00103",
    abstract = "As high-performance computing (HPC) systems advance towards Exascale computing, their size and complexity increase, introducing new maintenance challenges. Modern HPC systems feature data monitoring infrastructures that provide insights into the system's state. This data can be leveraged to train machine learning models to anticipate anomalies that require compute nodes to undergo maintenance procedures. This paper presents a novel approach to predicting such anomalies by creating a graph per measurement that encodes current and past sensor readings and information related to the compute node sensors. The experiments were performed with data collected from Marconi 100, a tier-0 production supercomputer at CINECA in Bologna, Italy. Our results show that the machine learning model can accurately predict anomalies and surpass current State-Of-The-Art (SOTA) models regarding the quality of predictions and the time horizon considered to forecast them.",
    booktitle = "Proceedings of the SC '24 Workshops of the International Conference on High Performance Computing, Network, Storage, and Analysis",
    pages = "737–740",
    numpages = "4",
    keywords = "Anomalies Forecasting, Artificial Intelligence, Data Center, Graphs, HPC, Machine Learning",
    location = "Atlanta, GA, USA",
    series = "SC-W '24"
}

@inproceedings{cons902,
    author = "Zhang, Yu and Fu, Kexue and Lu, Zhicong",
    title = "RevTogether: Supporting Science Story Revision with Multiple AI Agents",
    year = "2025",
    isbn = "9798400713958",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3706599.3719888",
    doi = "10.1145/3706599.3719888",
    abstract = "As a popular form of science communication, science stories attract readers because they combine engaging narratives with comprehensible scientific knowledge. However, crafting such stories requires substantial skill and effort, as writers must navigate complex scientific concepts and transform them into coherent and accessible narratives tailored to audiences with varying levels of scientific literacy. To address the challenge, we propose RevTogether, a multi-agent system (MAS) designed to support revision of science stories with human-like AI agents (using GPT-4o). RevTogether allows AI agents to simulate affects in addition to providing comments and writing suggestions, while offering varying degrees of user agency. Our preliminary user study with non-expert writers (N=3) highlighted the need for transparency in AI agents’ decision-making processes to support learning and suggested that emotional interactions could enhance human-AI collaboration in science storytelling.",
    booktitle = "Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems",
    articleno = "462",
    numpages = "7",
    keywords = "Writing Support, Human-AI Collaboration, Science Storytelling",
    location = "",
    series = "CHI EA '25"
}

@inproceedings{cons903,
    author = "Zhang, Juan",
    title = "Innovative Practice of Smart Education under the Background of Digital-Commerce Empowerment of Agriculture: AI Integration Approach in E-commerce Data Analysis Course",
    year = "2025",
    isbn = "9798400713811",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3746469.3746558",
    doi = "10.1145/3746469.3746558",
    abstract = "The objective of this research is to innovate the teaching model of the e-commerce data analytics course by utilising artificial intelligence to address the challenges faced by traditional teaching methods. The development of a substantial model-based intelligent library system has been undertaken, integrating an AI teaching assistant, a knowledge graph, and a recommendation engine based on deep learning. The system is capable of accurately matching resources based on learners' cognitive characteristics. The proposed hybrid teaching model integrates online and offline components and is based on an “AI two-teacher collaboration” mechanism. This collaboration facilitates cognitive construction and teacher guidance for value enhancement. The model also introduces a data-driven, industry-embedded context. The data-driven, three-dimensional teaching framework encompasses industry context embedding, cognitive apprenticeship and value immersion education. A multidimensional assessment system combining formative and summative assessment was adopted, and the assessment methods were reorganized. Empirical evidence demonstrates that the model significantly enhances students' data analysis and comprehensive abilities, while concomitantly improving teaching efficacy, students' performance, competition results, and course evaluation. It can be used as a reference paradigm for the reform of business courses in the smart era.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area Education Digitalization and Computer Science International Conference",
    pages = "566–572",
    numpages = "7",
    keywords = "AI Empowerment, Ability Cultivation, E-commerce Data Analysis, Teaching Model",
    location = "",
    series = "EDCS '25"
}

@inproceedings{cons904,
    author = "Lin, Baozhu and Ran, Jie",
    title = "Quantitative Research on China's Cross-border Data Flow Policies -- A Policy Analysis Framework of “X-Y-Z”",
    year = "2025",
    isbn = "9798400712623",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3723890.3723922",
    doi = "10.1145/3723890.3723922",
    abstract = {The governance of cross-border data flows around the digital economy, data security, and data sovereignty has become a crucial global issue. Taking the ``Cybersecurity Law" and other seven key policies, related to cross-border data flow as research objects, this paper used the policy text calculation method to construct an ``X-Y-Z" analysis framework from three dimensions of ``policy external structure - policy instrument - policy semantic features", and analyzed the data cross-border security policy texts in China. Understand policy themes, policy trends, and key points. In recent years, China has gradually built a data management system with Chinese characteristics, which makes balanced use of three policy tools: supply-oriented, environment-oriented and demand-oriented. Through the analysis of keywords, it is found that ``personal information", ``important data", ``data opening", ``international cooperation" and ``responsibility and obligation" are the key points of China's cross-border data flow policy. But in practice, policy investment in capital, talent, technology and infrastructure is not enough. Therefore, it is suggested to comprehensively optimize cross-border data governance by establishing supporting ``resource boxes", using technology ``auxiliary packages" and safeguarding security ``main positions". This will help to build a mechanism to ensure efficient, safe cross-border data flow and an open and mutually beneficial landscape for international cooperation in the data sphere.},
    booktitle = "Proceedings of the 2025 4th International Conference on Cryptography, Network Security and Communication Technology",
    pages = "193–199",
    numpages = "7",
    keywords = "Cross-border data flow, Information protection, Policy text, Important data",
    location = "",
    series = "CNSCT '25"
}

@inproceedings{cons905,
    author = "Zhang, Kai and Zhang, Ting",
    title = "The Application of Artificial Intelligence in the Field of Modern Infrastructure Investment",
    year = "2024",
    isbn = "9798400717529",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3697355.3697413",
    doi = "10.1145/3697355.3697413",
    abstract = "The use of artificial intelligence can effectively assist investment decision-making and risk control in the infrastructure field and is an important direction in the field of modern infrastructure investment. This article explores the application research of artificial intelligence in the field of modern infrastructure investment. This article analyzes the advantages of artificial intelligence in data analysis and prediction, and intelligent generation of innovative content, combined with the overall trend of intensive and efficient, intelligent and green, dynamic risk control, and value-driven modern infrastructure investment, and studies how to give play to the decision-making and analysis advantages of artificial intelligence in investment decisions, project risk control, and resource allocation, as well as how to give play to the innovative value in expanding investment value, optimizing design plans, construction stages, and investment plans. Through cases, it is confirmed that the application prospects of artificial intelligence in the field of modern infrastructure investment are broad, which can bring more intelligent and efficient investment and management models to infrastructure investment projects.",
    booktitle = "Proceedings of the 2024 8th International Conference on Big Data and Internet of Things",
    pages = "355–359",
    numpages = "5",
