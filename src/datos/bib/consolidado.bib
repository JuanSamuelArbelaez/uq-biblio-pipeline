@article{cons2992,
    author = "Wu, Jintao and Pan, Yachao and Ren, Jiahui and Li, Qibin",
    title = "Exploring structure–property relationships of critical temperatures for binary refrigerant mixtures via group contribution and machine learning",
    journal = "DeCarbon",
    volume = "9",
