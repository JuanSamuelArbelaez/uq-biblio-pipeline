    year = "2025",
    note = "The 5th International Conference on Machine Learning and Big Data Analytics for IoT Security and Privacy (SPIoT2024)",
    issn = "1877-0509",
    doi = "https://doi.org/10.1016/j.procs.2025.04.246",
    url = "https://www.sciencedirect.com/science/article/pii/S1877050925013481",
    keywords = "Digital intelligence platform, learning behavior, sentiment analysis, multimodal learning, random forest, BERT model",
    abstract = "This study develops an intelligent multimodal learning path recommendation system to address the problems of lack of personalized learning paths and insufficient attention to students’ emotional impact in traditional digital education models. By integrating learning behavior analysis and sentiment analysis, the Random Forest (RF) model is used to deeply mine students’ learning behavior data, such as analyzing learning time, resource access frequency, etc., to precisely understand students’ learning patterns. At the same time, with the help of sentiment analysis technology based on BERT (Bidirectional Encoder Representations from Transformers), students’ emotional states during the learning process are monitored in real-time, including positive, negative, neutral, and other emotions. The experimental results show that by dynamically adjusting the learning path and monitoring students’ emotional states, students’ average scores increase by 6.0\%, and homework completion rate increases by 4.4\%. This study not only improves the overall quality of education, but also provides educators with more scientific decision-making support tools."
}

@article{cons2504,
    author = "Picon, Antoine",
    title = "The materiality of architecture, between the rise of the Digital Age and the advent of the Anthropocene",
    journal = "Perspectives in Architecture and Urbanism",
    volume = "1",
    number = "2",
    pages = "100019",
    year = "2024",
    issn = "2950-2675",
    doi = "https://doi.org/10.1016/j.pau.2024.100019",
    url = "https://www.sciencedirect.com/science/article/pii/S295026752400023X",
    keywords = "Materiality, Materials, Digital Age, Sustainability, Anthropocene",
    abstract = "This paper explores questions of materiality in contemporary architecture in light of emerging developments in the discipline, building on the author’s previous work on the subject. After presenting a conceptual distinction between matter, material, and materiality—here defined as a socially constructed, relational phenomenon—the paper examines ongoing and potential shifts in the materiality of buildings driven by the rise of digital design and the adaptation to the challenges of the Anthropocene. Key topics include the movement from form to process in contemporary design, the renewed centrality of materials, the “material turn” in the humanities and social sciences, and the return of ornament. In conclusion, architecture is described as both a medium and a regulator of the human relationship to the material world."
}

@article{cons2505,
    author = "Xylogiannopoulos, Konstantinos F. and Xanthopoulos, Petros and Karampelas, Panagiotis and Bakamitsos, Georgios A.",
    title = "ChatGPT paraphrased product reviews can confuse consumers and undermine their trust in genuine reviews. Can you tell the difference?",
    journal = "Information Processing \& Management",
    volume = "61",
    number = "6",
    pages = "103842",
    year = "2024",
    issn = "0306-4573",
    doi = "https://doi.org/10.1016/j.ipm.2024.103842",
    url = "https://www.sciencedirect.com/science/article/pii/S0306457324002012",
    keywords = "Large language models, ChatGPT 4.0, Fake reviews, Hospitality industry, Spam detection, Artificial intelligence",
    abstract = "Fake reviews corrode the trust between businesses and consumers and distort the online image of a service or a product. The problem of fake review contamination is only going to worsen with the introduction of Artificial Intelligence (AI) technologies such as Large Language Models (LLMs), that allow even novice users to massively produce fake reviews that can easily be mistaken for real. In this paper, we study a particular type of fake review attack, the AI-paraphrased reviews generated with ChatGPT 4.0. For this, we use an efficient pattern detection algorithm to quantify the similarity between the paraphrased and original reviews. We use a dataset that consists of 400 reviews spanning 20 hotels around the globe and 6000 fake reviews through Open AI API. Our results show that as the word length pattern increases, the mean similarity ratio between original (human) and AI paraphrased texts converge to 0 \% while it stays above 20 \% between AI-paraphrased texts. This pattern is consistent for reviews of hotels with diverse geographic locations. In this way, we introduce the importance of text similarity detection as a feature that could be incorporated to the design of future fake review detection algorithms. This method can be generalized to other applications where AI paraphrased text detection is necessary."
}

@article{cons2506,
    author = "Wang, Shaofeng and Zhang, Hao",
    title = "Generative AI in international hotel marketing: impacts on employee creativity and performance",
    journal = "International Journal of Contemporary Hospitality Management",
    volume = "37",
    number = "8",
    pages = "2601-2626",
    year = "2025",
    issn = "0959-6119",
    doi = "https://doi.org/10.1108/IJCHM-10-2024-1595",
    url = "https://www.sciencedirect.com/science/article/pii/S0959611925000087",
    keywords = "Generative AI, Employee creativity, Employee performance, Technology–organization–environment framework, Antecedents–behavior–consequences model, International hotel marketing",
    abstract = "Purpose This study aims to explore how generative AI enhances employee creativity and performance in international hotel marketing. It applies an integrated technology–organization–environment (TOE) and antecedents–behavior–consequences (ABC) framework to examine the role of technological competence, organizational support, government support and artificial intelligence (AI) strategy in fostering employee innovation and performance. Design/methodology/approach A mixed-method approach was adopted, combining survey data from 206 international hotel marketers with semi-structured interviews. The study uses partial least squares structural equation modeling to test relationships and fuzzy-set qualitative comparative analysis (fsQCA) to identify configurations leading to high employee performance. Findings Technological competence, organizational support and government support significantly influence AI-driven innovative behavior. Innovative behavior, in turn, enhances employee creativity and performance, with creativity acting as a mediator. AI strategy amplifies the impact of organizational support on employee innovation. The fsQCA results reveal multiple pathways to achieving high employee performance, demonstrating the multifaceted nature of AI-enabled outcomes. Practical implications Hotels can enhance employee innovation and performance by investing in AI training and aligning AI strategies with organizational support. Policymakers should promote AI-friendly policies and partnerships to foster adoption. Organizations can further benefit from integrating generative AI tools with workflows to boost creativity and service quality, enhancing competitive advantage in the hospitality sector. Originality/value This study contributes by integrating the TOE and ABC frameworks to explore the cognitive and behavioral mechanisms underpinning AI-driven performance. It introduces AI strategy as a boundary condition and offers new insights into the nuanced ways AI influences creativity and productivity in hospitality management."
}

@article{cons2507,
