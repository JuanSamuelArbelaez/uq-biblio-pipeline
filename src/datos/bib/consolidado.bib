@inproceedings{cons858,
    author = "Wu, Yongxing and Jiang, Jiawen and Yao, Chuanju and Zhang, Yi",
    title = "Construction of the Trauma Injury Knowledge Graph",
    year = "2025",
    isbn = "9798400713446",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3733006.3733015",
    doi = "10.1145/3733006.3733015",
    abstract = "As a leading threat to human health, trauma is the primary cause of death among individuals under 40, making its prevention and treatment undeniably important. To effectively prevent and treat trauma, it is crucial to deeply understand the patterns of trauma occurrence, key points of treatment, and the final rehabilitation status. Especially under the conditions of first - line treatment, rapid and accurate diagnosis and treatment of trauma are of vital significance for ensuring the life safety of the injured and promoting the recovery of injuries. However, the current field of trauma medicine faces issues such as information silos and insufficient level of intelligence. Therefore, this paper proposes to construct an injury knowledge graph by integrating multi - source heterogeneous data and combining medical logic, aiming to provide structured management and visual query of trauma medical knowledge, improve diagnostic efficiency and medical support capabilities, offer efficient knowledge query and reasoning capabilities, meet the needs of future intelligent on - site medical care, and provide a data basis for the recommendation of personalized treatment plans.",
    booktitle = "Proceedings of the 2025 International Conference on Health Big Data",
    pages = "49–53",
    numpages = "5",
    keywords = "Knowledge Graph, Trauma, Visualization",
    location = "",
    series = "HBD '25"
}

@inproceedings{cons859,
    author = "Pinto, Fernando and Macadar, Marie Anne",
    title = "Using Generative AI Chatbot for enhancing people's digital participation",
    year = "2024",
    isbn = "9798400717802",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3680127.3680194",
    doi = "10.1145/3680127.3680194",
    abstract = "Aiming to improve communication and increase the access to available channels and tools, chatbots, or conversational agents, are being used to support people´s digital participation and foster civic engagement. However, conversational agents attend only expected cases of participation, that is, those based on e-consulting, e-decision making and e-informing. Hence, chatbots don´t concern non mapped cases of self-mobilization, besides there are problems in human-computer communication and in the transmission of information caused by digital divide that hinder peoples ‘participation. Literature review indicates that generative AI chatbot shall be used in non-expected interactions between human and conversational agents. Therefore, this paper discusses how chatbots could interact within self-mobilizations’ types of digital participation, concerning obstacles like lack of infrastructure and digital illiteracy. Using design science research, we propose the GenPart, a generative AI-chatbot model for enhancing people´s digital participation. We claim that this artifact can be used by researchers and practitioners who want to promote the integration between people, organizations, and information in digital platforms, promoting citizen participation and civic engagement.",
    booktitle = "Proceedings of the 17th International Conference on Theory and Practice of Electronic Governance",
    pages = "36–40",
    numpages = "5",
    keywords = "Digital participation, civic engagement, e-Participation, generative AI chatbot",
    location = "",
    series = "ICEGOV '24"
}

