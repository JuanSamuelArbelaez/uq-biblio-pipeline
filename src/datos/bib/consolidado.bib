@inproceedings{cons864,
    author = "Yu, Shiqi and Lei, Na",
    title = "Characteristics and Trends of the Network Structure in AI Ethics Research of China —— An Empirical Analysis Based on the CNKI Academic Journal Database",
    year = "2025",
    isbn = "9798400709753",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3718751.3718781",
    doi = "10.1145/3718751.3718781",
    abstract = "With the rapid development and widespread application of artificial intelligence technology, the ethical issues it raises have become a global focus of attention. Based on the literature in the field of artificial intelligence ethics in China National Knowledge Infrastructure (CNKI) academic journal database from 2013-2024, this paper provides an in-depth analysis of its research hot trends using social network analysis. The research results indicate that research in the field of artificial intelligence ethics has begun to take shape, but the density of networks is relatively low, and the connections between different research topics are not close enough. Current research mainly focuses on ethical considerations at the algorithmic and technical levels, as well as their potential impact on the moral framework of human society. The research results lack innovation and tend to be repetitive. The ethical research on artificial intelligence has formed four relatively stable subgroups, reflecting the diverse paths of ethical governance in artificial intelligence and the importance of interdisciplinary collaboration. This study provides a useful reference and scientific basis for in-depth understanding of the current situation and trend of artificial intelligence ethics research in China, and improving the future research direction and policy measures.",
    booktitle = "Proceedings of the 2024 4th International Conference on Big Data, Artificial Intelligence and Risk Management",
    pages = "189–194",
    numpages = "6",
    keywords = "Artificial intelligence ethics, Centrality, Condensed subgroups, Keyword, Social network analysis",
    location = "",
    series = "ICBAR '24"
}

