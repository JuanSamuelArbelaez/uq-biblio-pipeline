@article{cons3281,
    author = "Zhou, Yan and Yang, Ye and Jiang, Haiyang and Guo, Cheng",
    title = "Self-comparison versus social-comparison: The impact of imperfection on executive function in perfectionists",
    journal = "Personality and Individual Differences",
    volume = "234",
    pages = "112965",
    year = "2025",
    issn = "0191-8869",
    doi = "https://doi.org/10.1016/j.paid.2024.112965",
    url = "https://www.sciencedirect.com/science/article/pii/S0191886924004252",
    keywords = "Perfectionism, Executive function, Social-comparison, Self-comparison, Feedback",
    abstract = "Perfectionism is closely linked to high academic achievement, yet it is uncertain whether and how this advantage is manifested in cognitive functioning. We aimed to investigate whether the subtypes of perfectionists' executive functions (EF) are more susceptible to self-comparison or social-comparison. We recruited 75 students and provided them with sequential failure feedback based on self-comparison or social-comparison, and their performance on the three components of EF was subsequently recorded. Results indicated that for the perfectionists, receiving feedback that their performance was inferior to others served as a stronger facilitator of EF than when they performed worse than their own goals. Moreover, individual differences were observed. The Mixed-perfectionism group, i.e., those high in both Perfectionism striving (PS) and Perfectionism concern (PC), were more sensitive to social-comparison feedback, whereas those in the Pure PS group were more sensitive to self-comparison feedback. Additionally, the extent of these effects varied across the three components of EF. Strategies for maximizing the facilitative effects of feedback on cognition based on individual differences are discussed."
}

@article{cons3282,
    author = "Yang, Meng and Chen, Yue and Huang, Shihan and Chen, Laijun",
    title = "Recent advances in coordination and optimization of power-transportation systems: An overview",
    journal = "Renewable and Sustainable Energy Reviews",
    volume = "220",
    pages = "115786",
    year = "2025",
    issn = "1364-0321",
    doi = "https://doi.org/10.1016/j.rser.2025.115786",
    url = "https://www.sciencedirect.com/science/article/pii/S1364032125004599",
    keywords = "Power-transportation system, Electric vehicles, Game theory, Uncertainty analysis, Coordination",
    abstract = "The proliferation of electric vehicles has notably intensified the interdependence of power and transportation systems, which are the two cornerstones of the national economy. This paper provides an insightful review of the basic models of power-transportation systems and the pivotal techniques to tackle non-convex and nonlinear terms efficiently. As the foundation of coordination, recent progress in pricing mechanisms is highlighted. The coordination between power and transportation systems is categorized into the coordinated optimization-based schemes and the game theory-based schemes. Multi-source uncertainties in the coupled system and state-of-the-art model-driven, data-driven, and hybrid model-data-driven approaches to handling these uncertainties are summarized and compared. We also list real-world pilot projects on vehicle-grid interaction in recent years. Additionally, relevant studies on long-term expansion planning, short-term system operation, resilience enhancement, and market participation are outlined. Finally, this paper provides an outlook of prospective research directions."
}

@article{cons3283,
    author = "Gu, Mingxuan",
    title = "Machine learning-based investigation of irreducible water in geological carbon storage via NMR T2 measurements",
    journal = "Fuel",
    volume = "381",
    pages = "133479",
    year = "2025",
    issn = "0016-2361",
    doi = "https://doi.org/10.1016/j.fuel.2024.133479",
    url = "https://www.sciencedirect.com/science/article/pii/S0016236124026280",
    keywords = "Geological carbon storage, NMR technology, Irreducible water, Machine learning",
    abstract = "Geological carbon storage (GCS) is a crucial technology for addressing environmental challenges caused by greenhouse gas. In the site selection phase for GCS projects, the saturation of irreducible water is a vital indicator used to calculate the storage capacity and assess the feasibility of GCS projects. Due to its high efficiency in characterizing the petrophysical properties of porous rocks, nuclear magnetic resonance (NMR) technology is an indispensable tool for analyzing irreducible water. However, limited core samples and time-consuming experiments result in scarce matched NMR data from centrifuged and saturated states, challenging the study of irreducible water for GCS projects through machine learning. Moreover, the traditional single T2 cutoff methods for determining irreducible water saturation exhibit significant errors, making precise calculation of storage capacity challenging. To overcome these obstacles, the application of Generative Adversarial Networks is proposed to enhance training data richness and lay a foundation for using machine learning to investigate irreducible water properties. When selecting the appropriate data form and network structure, amplitude variations in T2 distributions at saturated and centrifuged states were considered, and the generator and discriminator models developed with the data form of type 1 showed the best performance. Furthermore, the Random Forest algorithm is introduced to predict the tapered T2 cutoff value, further deriving the T2 distribution of irreducible water and ultimately yielding more accurate irreducible water saturation. This accurate assessment is essential for calculating both static and dynamic storage capacities, which provide critical benchmarks for project operators in source-sink matching, ensuring efficient and cost-effective storage objectives. Additionally, it enables the acquisition of the T2 distribution of free water, which is difficult to obtain with traditional methods. This extra information can provide more guidance for the site selection and injection phases of GCS projects. The proposed method, by integrating advanced machine learning techniques, offers significant improvements over traditional methods in investigating irreducible water properties, presenting a promising application outlook in GCS projects."
}

@article{cons3284,
    author = "Liu, Tengfei and Guo, Yuanyuan and Liu, Shuanhu and Dong, Peng and Chen, Jianmin",
    title = "How Does User Experience Affect User Stickiness:",
    journal = "International Journal of Electronic Government Research",
    volume = "21",
    number = "1",
    year = "2025",
    issn = "1548-3886",
    doi = "https://doi.org/10.4018/IJEGR.368252",
    url = "https://www.sciencedirect.com/science/article/pii/S1548388625000025",
    keywords = "User Experience, User Stickiness, Governmental Chatbots, Online Institutionalized Political Participation",
    abstract = "ABSTRACT This study investigates the impact of user experience on user stickiness in governmental chatbots, employing a segmented, scenario-based approach to assess variations across different user groups and technology levels. By analyzing data from groups with either practical or policy-oriented knowledge, the study explores how the integration of basic and advanced artificial intelligence technologies influences the retention of users interacting with governmental digital services. The core findings reveal that user experience significantly enhances user stickiness across all scenarios and user types, independent of the users' level of online institutionalized political participation. This study indicates that the effectiveness of user experience strategies in governmental chatbots is largely autonomous from the users' political engagement, suggesting that the intrinsic quality of the user interface is a more critical factor in promoting user retention than previously understood."
}

@article{cons3285,
    author = "Schlosser, Elizabeth G. and Lloyd, Amber and Doherty, Michael and Hincapie, Ana L. and Kim, Karissa and Hein, Brad",
    title = "Faculty and student perceptions of a co-curriculum within a doctor of pharmacy program",
    journal = "Currents in Pharmacy Teaching and Learning",
    volume = "17",
    number = "6",
    pages = "102338",
    year = "2025",
    issn = "1877-1297",
    doi = "https://doi.org/10.1016/j.cptl.2025.102338",
    url = "https://www.sciencedirect.com/science/article/pii/S1877129725000590",
    keywords = "Co-curriculum, Doctor of pharmacy, Acpe accreditation, Coepa",
    abstract = "Background Colleges and schools of pharmacy have implemented co-curricular programs that complement didactic and experiential learning within Doctor of Pharmacy programs. These programs are varied but all are directed at achieving educational outcomes, which may change based on accreditation standards. Objective The objective of this project was to describe student and faculty perceptions of the co-curricular program in one doctor of pharmacy program. Methods Two surveys were developed to assess the co-curricular program, one for faculty and one for students. Both surveys consisted of quantitative and qualitative elements, and both were comprised of three sections: overall program satisfaction, activities and reflections, and program logistics. Surveys were distributed via email to all Doctor of Pharmacy students and faculty and remained open for two weeks. Results Response rate for the faculty and student surveys was 59.3 \% (19 of 32) and 48.2 \% (131 of 272), respectively. Overall satisfaction with the co-curricular program was rated as a median of 7 (interquartile range [IQR], 6–8) for faculty and a median of 6 (IQR, 5–8) for students on a 10-point scale with 10 being the most highly satisfied and one being not satisfied at all. Qualitative results revealed that faculty and students supported the program and its intent but find room for improvements. Suggested improvements included: ensuring consistent offerings of co-curricular activities in both quantity and quality, decreasing the number of required reflections, and encouraging timeliness and quality in student submissions and in faculty reviews. Conclusion Faculty and students expressed general support for the co-curricular program and offered several ways to enhance the program. These insights will be important to improve the program in this college of pharmacy and beyond, especially with new accreditation standards and educational outcomes."
}

