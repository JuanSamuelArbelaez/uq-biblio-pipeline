    author = "Gregory, Alexander and Ender, Joerg and Shaw, Andrew D. and Denault, André and Ibekwe, Stephanie and Stoppe, Christian and Alli, Ahmad and Manning, Michael W. and Brodt, Jessica L. and Galhardo, Carlos and Sander, Michael and Zarbock, Alexander and Fletcher, Nick and Ghadimi, Kamrouz and Grant, Michael C.",
