@incollection{cons2615,
    author = "Bojčić, Karlo and Spasenovski, Nemanja",
    title = "Media studies",
    booktitle = "Reference Module in Social Sciences",
    publisher = "Elsevier",
    year = "2025",
    isbn = "978-0-443-15785-1",
