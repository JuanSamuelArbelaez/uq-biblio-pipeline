    doi = "10.1145/3732801.3732816",
    abstract = "With the development of computer hardware and software technology, driven by huge storage capacity and super computing power, artificial intelligence has made phased progress, constantly triggering people 's imagination of the future, and also triggering a global competition boom. The application of Artificial Intelligence Generate Content ( AIGC ) in art design teaching has become an opportunity and challenge for colleges and universities. Through experimental comparison, this paper is looking for the influence of AIGC on students' learning, and looks forward that the application of AIGC in art design education can improve students' learning ability and innovation ability, which is an important method to cultivate innovative art design talents. AIGC will change the learning and creation mode of art design students and improve their comprehensive creative ability.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Informatics Education and Computer Technology Applications",
    pages = "70–76",
    numpages = "7",
    keywords = "AIGC, art creation, art design, art teaching, innovative talent training",
    location = "",
    series = "IECA '25"
}

@article{cons876,
    author = "Crocetti, Giancarlo and Bak, Seonwoo and Noory, Naqib A. and Vautor-Laplaceliere, Daena D.",
    title = "Evaluating the Pedagogical Impact of Large Language Models on Programming Skills in Higher Education",
    year = "2025",
    issue_date = "April 2025",
    publisher = "Consortium for Computing Sciences in Colleges",
    address = "Evansville, IN, USA",
    volume = "40",
    number = "8",
    issn = "1937-4771",
    abstract = "This empirical study investigated the impact of Generative AI (GenAI) tools, particularly large language models (LLMs), on college students' Python programming skills in a graduate-level data science course. Using a pretest-posttest methodology and accounting for variables like prior programming experience, the research examined how guided LLM usage affected students' self-assessed programming abilities. The findings revealed that while LLMs positively influenced students' capacity to develop complex applications, work with Python libraries, and write quality code, they had no significant impact on students' grasp of fundamental Python concepts or their general comfort with the language. These results suggest that LLMs serve as effective tools for advancing practical programming skills but cannot substitute for the foundational programming knowledge that must be developed through traditional learning.",
    journal = "J. Comput. Sci. Coll.",
    month = "May",
    pages = "163–177",
    numpages = "15"
}

@inproceedings{cons877,
    author = "Lv, Qiyou and Chen, Zehong and Luo, Xuliang",
    title = "Intelligent system for illegal behavior safety supervision based on improved YoLov5 and generative visual big model",
    year = "2025",
    isbn = "9798400715884",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3759928.3759934",
    doi = "10.1145/3759928.3759934",
    abstract = "There are a large number of violations of safety regulations at the construction site of the power grid. These behaviors do not comply with safety supervision norms and can cause significant safety hazards. In response to the problem of difficulty in capturing and alerting such violations, we have designed an intelligent recognition system for violations based on enhanced YOLOv5 and generative visual big models to automatically detect violations and potential safety hazards at the construction site of the power grid. We have constructed a private dataset of violations at the construction site of the power grid. In our improved YOLOv5 model, we first added a spatial channel attention mechanism to the Neck section of Yolov5 to enhance its ability to extract spatial features and distinguish between different channel features, enabling the network to better distinguish different targets. In addition, we have added a spatial attention mechanism after the SPP of the backbone network, which enables the network to fully utilize spatial information, extract more prominent features, and improve the accuracy and recall of the model. In addition, to compensate for the lack of negative samples in the dataset, we use a generative visual model to generate a large number of negative sample images to enhance the dataset and address the issue of insufficient negative samples. We have designed a real-time safety supervision intelligent system for detecting violations on construction sites based on the above model and method, using IoT devices such as on-site real-time cameras, intermediate data servers, and routers. We conducted extensive experiments on real construction site datasets, and the results showed that our method has significantly improved compared to the original model. The MAP of the system is 94.0\%, indicating that the model has strong detection ability and robustness in identifying personnel and safety tools in power grid construction site scenarios.",
    booktitle = "Proceedings of the 2nd International Conference on Image Processing, Machine Learning, and Pattern Recognition",
    pages = "32–38",
    numpages = "7",
    keywords = "Generative Visual Large Model, Illegal behavior, Improved YoLov5, Security Supervision",
    location = "",
    series = "IPMLP '25"
}

@inproceedings{cons878,
    author = "Ye, Bowen and Sun, Guoxin",
    title = "A large language model application for aspect-based sentiment analysis of Online Sports Class Reviews",
    year = "2025",
    isbn = "9798400713811",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3746469.3746595",
    doi = "10.1145/3746469.3746595",
    abstract = "This paper addresses the challenges faced by students during the transition to university, particularly in sports education, where students’ expectations often do not align with course designs. Students typically enter university with unrealistic academic expectations and lack necessary self-regulation skills, which negatively affect their academic success. Traditional methods of evaluating sports courses, such as expert-designed questionnaires, oversimplify students’ experiences and fail to capture the complexity of their feedback. This paper proposes a new algorithm based on sentiment analysis, utilizing natural language processing (NLP) and aspect-based sentiment analysis (ABSA) to better understand students’ multidimensional evaluations of sports courses. By employing transfer learning techniques, such as fine-tuning pre-trained large language models (e.g., Qwen-2.5 3B), this method provides a more refined and detailed analysis of student feedback. The proposed system not only quantifies students’ emotional feedback on various aspects of the course but also reflects on how these insights can guide course improvements. This paper emphasizes the importance of accurately capturing student experiences to improve course content, teaching methods, and overall student satisfaction, offering valuable contributions to the field of sports management.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area Education Digitalization and Computer Science International Conference",
    pages = "807–813",
    numpages = "7",
    keywords = "Large Language Model, Online Sports Courses, Course Reviews, Sentiment Analysis",
    location = "",
    series = "EDCS '25"
}

@inproceedings{cons879,
    author = "Yu, Yongtao and Gong, Junchen and Lu, Xiaoqiang",
    title = "A Lightweight YOLOv5s-Based Target Detection Method for Railway Workers",
    year = "2025",
    isbn = "9798400714429",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3744103.3744104",
    doi = "10.1145/3744103.3744104",
    abstract = "The precise detection of workers through on-site surveillance videos is crucial for enhancing the intelligent management of construction safety. This paper introduces an improved lightweight network, Yolov5s-NSFnet, which builds upon the original Yolov5s model to effectively address the challenges associated with small object detection and real-time processing on embedded devices in surveillance settings. To mitigate the difficulties posed by long monitoring distances and the detection of workers as small targets, we enhance the Yolov5s architecture by replacing its backbone network with the more efficient FasterNet. Moreover, we have incorporated SE channel attention mechanism into the FasterNet block to enhance the feature extraction capability of critical channels. Finally, we use the Normalized Wasserstein Distance (NWD) loss function instead of the traditional loss function to improve the accuracy of small object detection in the dataset. The experimental results show that our method not only effectively reduces the number of network parameters and computational load, but also improves the detection speed of the model on embedded devices while maintaining good detection accuracy.",
    booktitle = "Proceedings of the 2024 International Symposium on AI and Cybersecurity",
    pages = "1–6",
    numpages = "6",
    keywords = "Convolutional Neural Net work, Embedded Devices, Lightweight Network, Object Detection, YOLOv5s",
    location = "",
    series = "ISAICS '24"
}

@inproceedings{cons880,
    author = "Xu, Chang and Wang, Yunke and Guo, Jianyuan and Liu, Daochang and Dong, Minjing and George, Yasmeen and Barthelemy, Johan and Liu, Yan and Chen, Ling",
    title = "Workshop on Sustainable AI for the Future Web",
    year = "2025",
    isbn = "9798400713316",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3701716.3717658",
    doi = "10.1145/3701716.3717658",
    abstract = "AI has been widely integrated into web applications, and has revolutionized user experiences by enabling personalized services, optimizing decision-making and enhancing productivity. However, AI for the web application also poses significant sustainability challenges. AI models rely heavily on vast amounts of web data, consuming substantial computational resources and energy, while the proliferation of AI-generated content risks polluting the web with low-quality information and misinformation. This degradation of data quality threatens the robustness, fairness, and trustworthiness of AI systems, raising concerns about security, bias, and equitable outcomes across diverse user groups. Therefore, we propose this workshop that aims to advance research in sustainable AI for the web, focusing on energy-efficient, socially equitable, and technically robust AI models. By fostering interdisciplinary collaboration among AI, environmental science and social sciences experts, the workshop seeks to develop innovative solutions that ensure AI's long-term positive impact on the web.",
    booktitle = "Companion Proceedings of the ACM on Web Conference 2025",
    pages = "2052–2055",
    numpages = "4",
    keywords = "ai models in web applications, sustainable ai",
    location = "Sydney NSW, Australia",
    series = "WWW '25"
}

@inproceedings{cons881,
    author = "Hou, Wenhui and Yu, Xiaohan",
    title = "Exploring the Blended Teaching Mode of Python Programming Language Course Based on OBE Concepts",
    year = "2025",
    isbn = "9798400713811",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3746469.3746539",
    doi = "10.1145/3746469.3746539",
    abstract = "Aiming at the status quo and challenges of the teaching of programming courses in colleges and universities, this article proposes a blended teaching mode based on the concept of Outcome-Based Education (OBE), and takes the course of Python Programming Language as an example for in-depth research on teaching reform and practice. The article points out the problems of current teaching, including inaccurate positioning of course objectives, disconnection between teaching content and social needs, obsolete teaching mode and single teaching evaluation system. On this basis, the OBE+ online-offline hybrid teaching model is constructed, and the teaching implementation paths of pre-course, in-course and post-course are described in detail. Teaching effectiveness shows that the model effectively improves students' learning enthusiasm, ability and literacy, reduces the failure rate, and realizes the transformation from knowledge transmission to ability cultivation.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area Education Digitalization and Computer Science International Conference",
    pages = "434–439",
    numpages = "6",
    keywords = "Blended Learning, OBE, Python Programming Language",
    location = "",
    series = "EDCS '25"
}

@inproceedings{cons882,
    author = "Du, Wujun",
    title = "Research on How AI Agents Are Applied in Online Course Q\&amp;A: Taking the DeepSeek Platform as a Case Study",
    year = "2025",
    isbn = "9798400713347",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3757749.3757866",
    doi = "10.1145/3757749.3757866",
    abstract = "Aiming at the inefficiency and not enough coverage of traditional Q\&amp;A models in the “Introduction to Artificial Intelligence” course, this paper comes up with an AI agent design scheme based on the DeepSeek platform. First of all,it constructs a knowledge base specific to the course. Then it designs a multimodal interaction interface. Also,it integrats a real-time WeCom push mechanism. Though these steps, it enables 24-hour personalized Q\&amp;A for students. The experimental results turn out that the system boosts the student question resolution rate to 92\%. What's more, it cuts down teachers' repetitive Q\&amp;A workload by 75\%. It actually shows quite significant advantages when it comes to solving complex problems like algorithm optimization and formula derivation. This paper offers a practical reference that can be quantified for the implementation of intelligent educational tools in course group scenarios.",
    booktitle = "Proceedings of the 2025 2nd International Conference on Computer and Multimedia Technology",
    pages = "712–718",
    numpages = "7",
    keywords = "AI Agent, DeepSeek, Multimodal Learning, Online Education, Q\&amp;A System",
    location = "",
    series = "ICCMT '25"
}

@article{cons883,
    author = "Jillepalli, Ananth",
    title = "Effects of Neoliberalism on Computing Education Research and Practice",
    year = "2025",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3766901",
    doi = "10.1145/3766901",
    abstract = "I explore Neoliberalism and its effects on Computing Education and Research. I begin the exploration by analyzing the impact of declining state funding for higher education. I discuss the following mechanisms used by higher-ed institutions to cope with declines in state support: managerial culture, increase students’ fees, privatization of research, adjunctification of teaching professors, audit culture, and Artificial Intelligence agents as teachers. I then explore the commodified state of education and research resulting in a sovereign student, debasement of academic standards, and a perversion of academic subjectivity.I discuss how the commodification results in a dehumanization of faculty \&amp; students producing a compliance culture, loss of professional and pedagogical identities, loss of autonomy and public trust, and marginalization of equity, civic engagement, and critical inquiry. I analyze the reasons underlying a successful permeation of Neoliberalism in academia including portraying Neoliberalism as a class war, categorization STEM fields as luxury commodities, exploring exploitation of foreign workers, and commenting about the academic Stockholm syndrome. I discuss about a super-cycle of suffering-exploitation caused by Neoliberal pressures. I conclude the discussion with some strategies that can be used by computing researchers and practitioners to salvage the Neoliberal situation.",
    note = "Just Accepted",
    journal = "ACM Trans. Comput. Educ.",
    month = "September",
    keywords = "broadening participation, class, political economy, epistemic oppression"
}

@inproceedings{cons884,
    author = "Zhu, Jin and Chen, Moyan and Zhang, Dandan",
    title = "AIGC empowers the application of art design teaching scenarios in colleges and universities----Take Midjourney as an example",
    year = "2025",
    isbn = "9798400712692",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3722237.3722292",
    doi = "10.1145/3722237.3722292",
    abstract = {At present, with the rapid development of science and technology, the smart education model supported by advanced technologies such as big data analysis or artificial intelligence has become the mainstream. In view of the lack of teaching students in accordance with their aptitude and the incomplete teaching evaluation system in the current art design education system in colleges and universities, this paper puts forward a solution of artificial intelligence teaching method, analyzes the development status and application fields of modern technology with the guiding concept of "science-led and practice-driven", deduces the transformation of design process, and takes Midjourney as an example for different application scenarios. This paper analyzes the teaching mode of big data and artificial intelligence in the field of art design in colleges and universities, and builds a dual teaching practice system of "knowledge+skills" based on the advantages of disciplines and industries, so as to provide a plan for improving students' practical ability and continuously improving the teaching system.},
    booktitle = "Proceedings of the 2024 3rd International Conference on Artificial Intelligence and Education",
    pages = "319–323",
    numpages = "5",
    keywords = "Art design, Artificial intelligence, Big data, Midjourney, Teaching application",
    location = "",
    series = "ICAIE '24"
}

@inproceedings{cons885,
    author = "Wu, Zi-Xin and Lin, Li and Chuang, Ling-I and Shen, Jian and Lai, Ruei Ci and Liang, Rung-Huei and Cheng, Yu-Ting and Chen, Chien-Hsiung",
    title = "Dream Relay: Exploring Dream Sharing with Generative AI",
    year = "2025",
    isbn = "9798400713958",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3706599.3720238",
    doi = "10.1145/3706599.3720238",
    abstract = "To better understand people’s inner worlds, the HCI community has explored ways to understand dream experience through generative AI (GAI). This paper presented “dream relay,” a novel approach to sharing dreams by integrating GAI. In the relay, participants used a dream probe to record their dreams, which were then visualized by GAI and shared with the next person as stimuli. We conducted a probe-based, group autoethnography study to explore how dream sharing was influenced in the way of relay and with GAI. Results showed how participants recorded their dreams and perceived the AI-generated dream visuals. This study also highlighted the value of GAI in sparking imagination and alleviating personal privacy concerns, which increased the willingness to share. Finally, we discussed the human-AI collaboration in reshaping dreams, as well as the role of GAI in facilitating social interaction.",
    booktitle = "Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems",
    articleno = "202",
    numpages = "7",
    keywords = "Dreams, Dream sharing, Dream visualization, Generative AI, Dream privacy",
    location = "",
    series = "CHI EA '25"
}

@inproceedings{cons886,
    author = "Wei, Yanru",
    title = "Research on the impact of artificial intelligence on enterprise Decision support System (DSS) : based on bibliometrics",
    year = "2025",
    isbn = "9798400712432",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3732801.3732818",
    doi = "10.1145/3732801.3732818",
    abstract = {The purpose of this study is to systematically study the influence of artificial intelligence (AI) on enterprise decision support system. This survey aims to identify the limitations of existing research and explore future trends. 801 literatures were selected from the core collection database of web of science and analyzed in depth by using bibliometric methods and visualization tools (vosviewer and CiteSpace). The analysis includes partnerships between authors, institutions and countries, co-occurrence and emergence of keywords, number of publications and timeline. The analysis shows that although the application of artificial intelligence in decision support system has achieved good results, the research on its comprehensive impact is still disorderly.In recent years, keywords such as "decision support system", "management", "modeling" and terms related to "neural networks" and "clinical research" have become prominent research topics.At the same time, "clinical decision support system" has become a prominent research hotspot.This area is receiving more and more attention.This paper aims to make up for the deficiencies of the existing research through a systematic review of the literature.In doing so, it provides valuable insights that can inform the optimization of enterprise decision support systems.},
    booktitle = "Proceedings of the 2025 2nd International Conference on Informatics Education and Computer Technology Applications",
    pages = "83–87",
    numpages = "5",
    keywords = "Artificial intelligence, Corporate decision-making, Decision support systems",
    location = "",
    series = "IECA '25"
}

@inproceedings{cons887,
    author = "Chen, Liuqing and Xiao, Shuhong and Chen, Yunnong and Song, Yaxuan and Wu, Ruoyu and Sun, Lingyun",
    title = "ChatScratch: An AI-Augmented System Toward Autonomous Visual Programming Learning for Children Aged 6-12",
    year = "2024",
    isbn = "9798400703300",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3613904.3642229",
    doi = "10.1145/3613904.3642229",
    abstract = "As Computational Thinking (CT) continues to permeate younger age groups in K-12 education, established CT platforms such as Scratch face challenges in catering to these younger learners, particularly those in the elementary school (ages 6-12). Through formative investigation with Scratch experts, we uncover three key obstacles to children’s autonomous Scratch learning: artist’s block in project planning, bounded creativity in asset creation, and inadequate coding guidance during implementation. To address these barriers, we introduce ChatScratch, an AI-augmented system to facilitate autonomous programming learning for young children. ChatScratch employs structured interactive storyboards and visual cues to overcome artist’s block, integrates digital drawing and advanced image generation technologies to elevate creativity, and leverages Scratch-specialized Large Language Models (LLMs) for professional coding guidance. Our study shows that, compared to Scratch, ChatScratch efficiently fosters autonomous programming learning, and contributes to the creation of high-quality, personally meaningful Scratch projects for children.",
    booktitle = "Proceedings of the 2024 CHI Conference on Human Factors in Computing Systems",
    articleno = "649",
    numpages = "19",
    keywords = "Children Aged 6-12, Computational Thinking, Large Language Model, Scratch",
    location = "Honolulu, HI, USA",
    series = "CHI '24"
}

@inproceedings{cons888,
    author = "Qin, Yueming and Yan, Jiuxin and Chen, Shu",
    title = "Immersive Teaching Practice of Virtual Reality (VR) in Tax Return Practical Training",
    year = "2025",
