@article{cons2962,
    author = "Hockenberry, Max A. and Daugird, Timothy A. and Legant, Wesley R.",
    title = "Cell dynamics revealed by microscopy advances",
    journal = "Current Opinion in Cell Biology",
    volume = "90",
    pages = "102418",
    year = "2024",
    issn = "0955-0674",
    doi = "https://doi.org/10.1016/j.ceb.2024.102418",
    url = "https://www.sciencedirect.com/science/article/pii/S0955067424000978",
    abstract = "Cell biology emerges from spatiotemporally coordinated molecular processes. Recent advances in live-cell microscopy, fueled by a surge in optical, molecular, and computational technologies, have enabled dynamic observations from single molecules to whole organisms. Despite technological leaps, there is still an untapped opportunity to fully leverage their capabilities toward biological insight. We highlight how single-molecule imaging has transformed our understanding of biological processes, with a focus on chromatin organization and transcription in the nucleus. We describe how this was enabled by the close integration of new imaging techniques with analysis tools and discuss the challenges to make a comparable impact at larger scales from organelles to organisms. By highlighting recent successful examples, we describe an outlook of ever-increasing data and the need for seamless integration between dataset visualization and quantification to realize the full potential warranted by advances in new imaging technologies."
}

