@inproceedings{cons893,
    author = "Lee, Seunghan and Lee, Soryung and Joo, Kyungwon and Kim, Sunghoon",
    title = "Comparative Analysis of Technology Trends in the Water Field across IP5 Countries Using Natural Language Processing",
    year = "2025",
    isbn = "9798400717383",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3711542.3711564",
    doi = "10.1145/3711542.3711564",
    abstract = "In the rapidly advancing field of water technology, a systematic and strategic approach utilizing various technologies is curcial. In this study, we use Natural Language Processing (NLP) to analyze and predict technology trends in the water field based on data from IP5 countries (South Korea, China, Japan, the United States, and Europe). To do so, we use Latent Dirichlet Allocation (LDA) for topic modeling and KeyBERT for keyword extraction to provide a detailed comparison of technology trends and their underlying factors. Our findings highlight distinct focuses and commonalities in water technology development across countries, offering valuable insights for future research and policy formulation.",
    booktitle = "Proceedings of the 2024 8th International Conference on Natural Language Processing and Information Retrieval",
    pages = "425–430",
    numpages = "6",
    keywords = "Water Resources, Natural Language Processing (NLP), Latent Dirichlet Allocation (LDA), KeyBERT, Technology Trends",
    location = "",
    series = "NLPIR '24"
}

@inproceedings{cons894,
    author = "Zhang, Min and Rauf, Irum and Bandara, Arosha K.",
    title = "To Protect \&amp; Serve: Enabling Responsible Software Engineering for Online Safety",
    year = "2025",
    isbn = "9798400714610",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3711919.3728676",
    doi = "10.1145/3711919.3728676",
    abstract = "Software products have been at the heart of the explosion of social computing technologies, but they are also implicated in facilitating online violence against women and girls. In this context, there is an acute need for responsible approaches to software engineering that help minimise the risks of online harms through effective consideration of how harms could arise in the context of a particular software product and selection of appropriate mitigations to minimise the likelihood and impact of these harms. In this paper, we highlight some of the key challenges faced by software engineering teams who want to ensure that software products serve the needs of users, while also protecting these users from harms. To address these challenges, we propose that there is an essential prerequisite to develop and maintain a knowledge model of online harms. Such a knowledge model could be used by software engineers to explore how online harms link to relevant policy and regulation, the actors involved in online harm incidents; other relevant contextual factors; and product features. We propose a meta-model for capturing this knowledge and identify some key research challenges to address for software development teams to practice responsible software engineering for online safety.",
    booktitle = "Proceedings of the 1st International Workshop on Responsible Software Engineering",
    pages = "1–6",
    numpages = "6",
    keywords = "Meta-model, Online safety, Responsible software engineering",
    location = "Trondheim, Norway",
    series = "ResponsibleSE '25"
}

@inproceedings{cons895,
    author = "Liu, Xiaohu and Guo, Yutang",
    title = "Research and Application of Controllable AIGC Technology in Architectural Renderings Generation",
    year = "2024",
    isbn = "9798400707254",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3703187.3703241",
    doi = "10.1145/3703187.3703241",
    abstract = "With the wide application of AIGC image technology in the production of architectural renderings, how to generate more accurate and clear architectural renderings has become a research hotspot in the industry. Aiming at this problem, this paper designs a system framework for controllable AI-generated architectural renderings, which has the Features of strong scalability and smooth processing flow. This paper also proposes a three-category combination method of text-to-image prompt words to effectively design prompt words. At the same time, this paper designs and implements a three-stage AI generation algorithm for architectural renderings, conducts theoretical analysis on the complexity of the algorithm, and tests and compares the generation effects through experiments. The research results of this paper can effectively realize controllable AI-generated architectural renderings and have good application effects and promotion significance.",
    booktitle = "Proceedings of the 2024 7th International Conference on Computer Information Science and Artificial Intelligence",
    pages = "319–324",
    numpages = "6",
    keywords = "AIGC, Controlnet, Prompt, Text-to-image",
    location = "",
    series = "CISAI '24"
}

@inproceedings{cons896,
    author = "Nie, Fankai and Sun, Yuhan and Hou, Ting and Shi, Shaoting and Chen, Xi and Liu, Baitang",
    title = "Enhancing Tourist Experience Across Age Groups with Large Language Models: Evaluating ChatGPT as a Virtual Tour Guide",
    year = "2025",
    isbn = "9798400712791",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3745238.3745457",
    doi = "10.1145/3745238.3745457",
    abstract = "As the smart tourism sector is growing rapidly, large language models (LLMs) have emerged to slowly function as an emerging technology for enhancing the tourist experience. The present study statistically tested the worth of having LLMs as virtual guides in smart tourist scenarios. It comparatively evaluated and analyzed their efficacy and quality in gaining information, user experience, and willingness to use among different age groups. This study recruited 180 tourists in three age categories (Digital Natives, Digital Adopters, and Digital Migrants) via a stratified random sampling method. They were equally assigned to the experimental group and the control group. When compared with conventional tourism digital media, the results showed that virtual tour guides derived from LLMs had tremendous advantages in increasing information acquisition effectiveness, raising interactivity, and optimizing user experience. However, acceptability of LLMs virtual guides was different among people of different ages. Digital Natives and Digital Migrants were more contented and yet willing to accept, while Digital Adopters showed a neutral attitude toward LLMs' profound content. The current study also revealed the key problems of LLMs in intelligent tourism, e.g., information credibility and interactive adaptability. The findings provide theoretical support for digital innovation in smart tourism and practical insights for policymakers, tourism technology companies, and cultural managers.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence",
    pages = "1403–1408",
    numpages = "6",
    keywords = "ChatGPT, LLMs, Smart tourism, User experience, Virtual tour guide",
    location = "",
    series = "DEAI '25"
}

@inproceedings{cons897,
    author = "Cheng, Mingyong and Yu, Zetao and Dang, Xuexi",
    title = "Landscape Illusions: An AI and AR Powered Journey from Nature to Imagined Futures",
    year = "2024",
    isbn = "9798400704857",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3635636.3660500",
    doi = "10.1145/3635636.3660500",
    abstract = "“Landscape Illusions” ventures into the realm where human perception intertwines with the natural world, unveiling a series of AR-infused Chinese landscape painting scrolls with animated experience. This collaboration between artists and generative AI crafts a dialogue that traverses time and space, merging the ancient allure of nature with the innovative pulse of digital creativity. The collection, comprising “Metropolis Veins,” “Rising Tides,” “Symbiotic Horizons,” and “Stellar Reflections,” acts as a mirror reflecting various environmental and societal themes. It invites viewers to engage deeply with the artwork, challenging them to rethink their relationship with the environment around them. This series is a reflection on the complex narratives nature weaves, marrying the serene beauty of traditional landscapes with the inventive power of AI and the immersive experience of AR technology. “Landscape Illusions” prompts critical discussions about nature's role in our lives and the impact we have on it, making it a poignant commentary on contemporary environmental issues and inspiring a reimagined vision for our collective future.",
    booktitle = "Proceedings of the 16th Conference on Creativity \&amp; Cognition",
    pages = "603–607",
    numpages = "5",
    keywords = "Artificial Intelligence Art, Augmented Reality Art, Chinese Landscape Painting, Climate Change, Coexistence, Generative Art, Landscape \&amp; Nature, Speculative Future",
    location = "Chicago, IL, USA",
    series = "C\&amp;C '24"
}

@inbook{cons898,
    author = "Lee, Kyungho",
    title = "Towards a Working Definition of Designing Generative User Interfaces",
    year = "2025",
    isbn = "9798400714863",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3715668.3736365",
    abstract = "Generative UI is transforming interface design by facilitating AI-driven collaborative workflows between designers and computational systems. This study establishes a working definition of Generative UI through a multi-method qualitative approach, integrating insights from a systematic literature review of 127 publications, expert interviews with 18 participants, and analyses of 12 case studies. Our findings identify five core themes that position Generative UI as an iterative and co-creative process. We highlight emerging design models, including hybrid creation, curation-based workflows, and AI-assisted refinement strategies. Additionally, we examine ethical challenges, evaluation criteria, and interaction models that shape the field. By proposing a conceptual foundation, this study advances both theoretical discourse and practical implementation, guiding future HCI research toward responsible and effective generative UI design practices.",
    booktitle = "Companion Publication of the 2025 ACM Designing Interactive Systems Conference",
    pages = "489–495",
    numpages = "7"
}

@inproceedings{cons899,
    author = "Ardimento, Pasquale and Bernardi, Mario Luca and Cimitile, Marta and Scalera, Michele",
    title = "Enhancing Software Modeling Learning with AI-Powered Scaffolding",
    year = "2024",
    isbn = "9798400706226",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3652620.3687776",
    doi = "10.1145/3652620.3687776",
    abstract = "This study introduces an innovative AI-powered scaffolding approach aimed at enhancing software modeling learning through UML diagrams. The focus of this research is on defining the principles and functions comprising the scaffolding. Leveraging recent advancements in generative AI, our approach provides a structured educational framework to improve comprehension and proficiency in modeling concepts. We present the initial implementation of the scaffolding, specifically highlighting the feedback function. By integrating theoretical insights with practical applications, this study seeks to advance Model-Driven Software Engineering education and underscores the potential of AI in enhancing instructional methodologies.",
    booktitle = "Proceedings of the ACM/IEEE 27th International Conference on Model Driven Engineering Languages and Systems",
