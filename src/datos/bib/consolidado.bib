@article{cons2943,
    author = "Shi, Xingyue and Zhou, Linming and Huang, Yuhui and Wu, Chaohui and Wu, Yongjun and Li, Juan and Hong, Zijian",
    title = "Machine learning assisted screening of binary alloys for metal-based anode materials",
    journal = "Journal of Energy Chemistry",
    volume = "104",
    pages = "62-68",
    year = "2025",
    issn = "2095-4956",
    doi = "https://doi.org/10.1016/j.jechem.2024.12.036",
    url = "https://www.sciencedirect.com/science/article/pii/S209549562400888X",
    keywords = "CGCNN, Alloy anodes, Machine learning, Metal-based batteries",
    abstract = "Metal alloy anode materials with high specific capacity and low voltage have recently gained significant attention due to their excellent electrochemical performance and the ability to suppress dendrite growth. However, experimental investigations of metal alloys can be time-consuming and expensive, often requiring extensive experimental design and effort. In this study, we developed a machine learning model based on the Crystal Graph Convolutional Neural Network (CGCNN) to screen alloy anode materials for seven battery systems, including lithium (Li), sodium (Na), potassium (K), zinc (Zn), magnesium (Mg), calcium (Ca), and aluminum (Al). We utilized data with tens of thousands of alloy materials from the Materials Project (MP) and Automatic FLOW for Materials Discovery (AFLOW) databases. Without any experimental voltage input, we identified over 30 alloy systems that have been experimentally validated with good precision. Additionally, we predicted over 100 alloy anodes with low potential and high specific capacity. We hope this work to spur further interest in employing advanced machine learning models for the design of battery materials."
}

@article{cons2944,
