    author = "Schulz, Lukas P. and Gatti, Beatrice and Milani, Gregorio P. and Lava, Sebastiano A.G. and Lavagno, Camilla and Bianchetti, Mario G. and Bronz, Gabriel and Kottanattu, Lisa and Camozzi, Pietro and Faré, Pietro B.",
