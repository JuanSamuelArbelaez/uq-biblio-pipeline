@article{cons3093,
    author = "Seong, Min-Jun and Yoon, Ye Rin and Kwon, Kil Koang and Kim, Haseong and Lee, Seung-Goo and Shin, Jonghyeok and Lee, Dae-Hee",
    title = "Automated Construction of a Yeast-Based Multigene Library via Homologous Recombination in a Biofoundry Workflow",
    journal = "ACS Synthetic Biology",
    volume = "14",
    number = "5",
    pages = "1549-1556",
    year = "2025",
    issn = "2161-5063",
    doi = "https://doi.org/10.1021/acssynbio.4c00812",
    url = "https://www.sciencedirect.com/science/article/pii/S2161506325001457",
    keywords = "multigene assembly, in vivo homologous recombination, expression-tunable library, automated gene assembly, biofoundry, high-throughput gene assembly",
    abstract = "Efficiently building metabolic pathways via multigene assembly has long been constrained by the limitations of traditional cloning techniques, necessitating a breakthrough in gene assembly methods. Notably, various in vitro gene assembly methods have been developed to simplify the construction of an expression-tunable library. However, in vitro gene assembly requires a tedious multistep construction process, making it time-consuming and labor-intensive. Therefore, in this study, we developed an automated one-step multigene assembly method for constructing an expression-tunable library based on in vivo homologous recombination. We optimized the shuttle vector for in vivo homologous recombination to improve the assembly efficiency. We also scaled down the whole assembly method for a high-throughput gene assembly. Finally, the developed method demonstrated the construction of the expression-tunable multigene library in the biofoundry. Therefore, this study offers a versatile strategy for parallel and high-throughput genetic engineering in synthetic biology."
}

@article{cons3094,
    author = "Biddle, K. and Bechman, K. and Gibson, M. and Adas, M. and Yang, Z. and Birring, S.S. and Norton, S. and Galloway, J.",
    title = "POS0309 THE EPIDEMIOLOGY OF SARCOIDOSIS IN ENGLAND",
    journal = "Annals of the Rheumatic Diseases",
    volume = "84",
    pages = "569-570",
    year = "2025",
    note = "EULAR 2025: European Congress of Rheumatology",
    issn = "0003-4967",
    doi = "https://doi.org/10.1016/j.ard.2025.05.696",
    url = "https://www.sciencedirect.com/science/article/pii/S0003496725017297",
    keywords = "Epidemiology, Observational studies/registry",
    abstract = "Background: Sarcoidosis is a systemic inflammatory condition characterised by the formation of granuloma in organs. It can cause end-organ damage and is associated with an elevated risk of mortality [1, 2]. Despite its clinical importance, the epidemiology of sarcoidosis in England is poorly characterised, with a notable lack of published data on its prevalence, and estimates of incidence and mortality that were last calculated two decades ago [3, 4]. Objectives: This study's objective was to explore contemporary trends in the incidence, prevalence, and mortality rates of sarcoidosis in England. Methods: This research utilised a population-based approach, using data from the Clinical Practice Research Datalink (CPRD), linking primary care records with secondary care data and death registrations from the Office for National Statistics (ONS). Adults aged 18 years or older who contributed data between 2003 and 2023 were included. Sarcoidosis cases were identified through diagnostic codes in primary care records. Age- and sex-standardised incidence and prevalence were calculated. Standardised mortality ratios (SMRs) were used to compare mortality rates with those of the general population. A control cohort without sarcoidosis was matched within the CPRD, and negative binomial regression was applied to assess differences in all-cause mortality rates between individuals with incident sarcoidosis and their matched counterparts. Results: A total of 56,287 patients had a diagnostic code for sarcoidosis between January 1st, 2003 and December 31st 2023. The age and sex-standardised incidence of sarcoidosis was 6.65 per 100,000 person-years in 2003 and 7.73 per 100,000 person-years in 2023 (Figure 1a). Regression demonstrated an annual increase in incidence of 0.10 cases per 100,000 person-years (95\% CI 0.06 to 0.14) over the study period. Notable rises in new diagnoses were observed among males and individuals over 60 years old. The prevalence of sarcoidosis using at least one diagnostic code, standardised by age and sex, increased from 168 per 100,000 in 2003 to 231 per 100,000 in 2023. This increase appeared consistent across the study period (Figure 1b). The age-and-sex-standardised all-cause mortality rate among the prevalent population was 9.5 per 1,000 patients in 2003 and 12.2 per 1,000 patients in 2023 (Figure 1c). Over the study period, there was an annual increase in mortality of 0.07 per 1,000 patients (95\% CI 0.02 to 0.12). Elevated mortality rates were observed in males [SMR: 1.8 (95\% CI: 1.7 to 1.8)] and females [SMR: 2.0 (95\% CI: 2.0 to 2.1)], particularly among those aged 30–70 years. Regression models showed significantly higher all-cause mortality in the incident sarcoidosis cohort compared to matched controls [adjusted incidence rate ratio (IRR): 1.73 (95\% CI: 1.63 to 1.83)] Figure 1Age and sex standardised incidence, prevalence and mortality of sarcoidosis in England Conclusion: The incidence and prevalence of sarcoidosis are rising in England, with notable rises amongst males and individuals aged 60 and older. Younger patients with sarcoidosis are at increased risk of death compared to matched controls. Acknowledging the growing burden of this disease, along with shifting demographic trends, is crucial for optimising healthcare policies and ensuring the effective allocation of healthcare resources. REFERENCES: [1] Sikjaer, M. G., Hilberg, O., Ibsen, R. \& Løkke, A. Sarcoidosis-related mortality and the impact of corticosteroid treatment: A population-based cohort study. Respirology 27, 217–225 (2022). [2] Rossides, M. et al. Sarcoidosis mortality in Sweden: a population-based cohort study. Eur. Respir. J. 51, (2018). [3] Gribbin, J. et al. Incidence and mortality of idiopathic pulmonary fibrosis and sarcoidosis in the UK. Thorax 61, 980 LP – 985 (2006). [4] Hanley, A., Hubbard, R. B. \& Navaratnam, V. Mortality trends in asbestosis, extrinsic allergic alveolitis and sarcoidosis in England and Wales. Respir. Med. 105, 1373–1379 (2011). Acknowledgements: NIL. Disclosure of Interests: Kathryn Biddle: None declared. Katie Bechman: None declared. Mark Gibson: None declared. Maryam Adas: None declared. Zijing Yang: None declared. Surinder S Birring: None declared. Sam Norton: None declared. James Galloway Abbvie, Alfasigma, Janssen, Lilly, Pfizer, UCB, Abbvie, Alfasigma, GSK, Kinevant, Pfizer, Xentria. © The Authors 2025. This abstract is an open access article published in Annals of Rheumatic Diseases under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/). Neither EULAR nor the publisher make any representation as to the accuracy of the content. The authors are solely responsible for the content in their abstract including accuracy of the facts, statements, results, conclusion, citing resources etc."
}

@article{cons3095,
    author = "Shapiro, Jonathan and Lyakhovitsky, Anna",
    title = "Revolutionizing teledermatology: Exploring the integration of artificial intelligence, including Generative Pre-trained Transformer chatbots for artificial intelligence-driven anamnesis, diagnosis, and treatment plans",
    journal = "Clinics in Dermatology",
    volume = "42",
    number = "5",
    pages = "492-497",
    year = "2024",
    note = "Artificial Intelligence II",
    issn = "0738-081X",
    doi = "https://doi.org/10.1016/j.clindermatol.2024.06.020",
    url = "https://www.sciencedirect.com/science/article/pii/S0738081X24001044",
    abstract = "The integration of teledermatology and artificial intelligence (AI) marks a significant advancement in dermatologic care. This study examines the synergistic interplay between these two domains, highlighting their collective impact on enhancing the accuracy, accessibility, and efficiency of teledermatologic services. Teledermatology expands dermatologic care to remote and underserved areas, and AI technologies show considerable potential in analyzing dermatologic images and performing various tasks involved in teledermatology consultations. Such integration facilitates rapid, precise diagnoses, personalized treatment plans, and data-driven insights. Our explorative study involved designing a GPT-based chatbot named “Dr. DermBot” and exploring its performance in a teledermatologic consultation process. The design phase focused on the chatbot's ability to conduct consultations autonomously. The subsequent testing phase assessed its performance against the backdrop of current teledermatologic practices, exploring the potential of AI and chatbots to simulate and potentially enhance teledermatologic health care. Our study demonstrates the promising future of combining teledermatology with AI. It also brings to light ethical and legal concerns, including the protection of patient data privacy and adherence to regulatory standards. The union of teledermatology and AI not only aims to enhance the precision of teledermatologic diagnoses but also broadens the accessibility of dermatologic services to previously underserved populations, benefiting patients, health care providers, and the overall health care system."
}

@article{cons3096,
    author = "Liang, Qichao and Ma, Qiang and Wu, Hao and Lai, Rongshun and Wang, Qianji and Li, Zhibin and Xu, Haibo and Zhang, Yangyang and Qi, Tao",
    title = "Concentration extraction and spatial distribution identification of heavy rare earth in EPMA images of sintered Nd–Fe–B",
    journal = "Journal of Magnetism and Magnetic Materials",
    volume = "624",
    pages = "173028",
    year = "2025",
    issn = "0304-8853",
    doi = "https://doi.org/10.1016/j.jmmm.2025.173028",
    url = "https://www.sciencedirect.com/science/article/pii/S0304885325002604",
    keywords = "DDPM, NdFeB, Image generation, EPMA",
    abstract = "The addition of heavy rare earth elements to sintered Nd–Fe–B magnets through grain boundary diffusion techniques can significantly improve the coercivity of magnets with minimal reduction in remanence. The diffusion depth and distribution of the diffusion source are critical metrics for evaluating the efficiency of the diffusion process. Glow discharge mass spectrometry can sequentially strip layers of the magnet within a limited region to measure the concentration of the diffusion source at various depths. However, the accuracy is compromised by the multiphase nature of the base magnet material and the inhomogeneous distribution of the diffusion source. In contrast, electron probe microanalysis enables direct observation of the diffusion depth and distribution by analyzing diffusion cross-sections of the magnet. Coupled with digital image processing techniques, electron probe microanalysis allows high-throughput analysis of images to calculate concentration across depth intervals, establish depth-concentration relationships, and predict the concentration of heavy rare-earth elements at specific depths. Describing the distribution of diffusion sources presents a significant challenge. In this work, a probabilistic denoising diffusion model is proposed for the first time to quantify the distribution of the diffusion source. EPMA images were segmented into 3,700 distinct positions for model training. The trained model can generate diffusion images with the same distribution of heavy rare-earth elements at any position. By training on microscopic images of various magnets, the model establishes a profound correlation between magnet performance and microstructure, providing practical guidance for optimizing magnets or diffusion sources."
}

