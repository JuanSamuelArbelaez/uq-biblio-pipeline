@article{cons2503,
    author = "Wang, Lei and Peng, Nan and Liu, Lu and Wei, Sheng",
    title = "Innovation of Multimodal Learning Paths Based on Learning Behavior and Sentiment Analysis in AI Digital Intelligence Platform",
    journal = "Procedia Computer Science",
    volume = "261",
