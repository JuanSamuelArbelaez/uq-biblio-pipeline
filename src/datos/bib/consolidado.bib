@inproceedings{cons846,
    author = "Yang, Chao and Wang, Deliang and Chen, Gaowei",
    title = "Chat-LAD: Enhancing Teacher Understanding of Learning Analytics Dashboard with AI-Empowered Explanations",
    year = "2025",
    isbn = "9798400712913",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3698205.3733922",
    doi = "10.1145/3698205.3733922",
    abstract = "Despite the great potential of learning analytics dashboards (LADs) in presenting complex learning data to support teacher reflection and professional learning, several challenges persist. These include cognitive overload due to visualization complexities, limited data interpretation, and a lack of personalized support, which hinder the effective use for reflective practices and decision-making, especially for users with limited digital literacy. To address these issues, this study introduces Chat-LAD, an artificial intelligence (AI)-powered chatbot that leverages generative AI and multi-agent retrieval-augmented generation (RAG) to provide real-time explanations tailored to user needs, enhancing teachers' understanding of LADs for classroom discourse analysis. A case study demonstrates Chat-LAD's capabilities in clarifying visual elements, offering context-aware responses, and providing personalized feedback based on user historical data. This study facilitates a transition in human-AI interaction from a singular, passive text-based approach to a multimodal, collaborative framework, highlighting the educational value of generative AI in enhancing visual interpretability in the use of LADs.",
    booktitle = "Proceedings of the Twelfth ACM Conference on Learning @ Scale",
    pages = "197–201",
    numpages = "5",
    keywords = "ai chatbot, classroom discourse, human-ai interaction, interpretability, learning analytics dashboard",
    location = "Palermo, Italy",
    series = "L@S '25"
}

@inproceedings{cons847,
    author = "Ustymenko, Stanislav and Phadke, Abhishek",
    title = "Promise and Challenges of Generative AI in Healthcare Information Systems",
    year = "2024",
    isbn = "9798400702372",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3603287.3651196",
    doi = "10.1145/3603287.3651196",
    abstract = "Large Language Models (LLMs) based on pretrained transformer architectures, such as Generative Pretrained Transformer 4 (GPT-4) from OpenAI, are on the cutting age of artificial intelligence research. Along with generating abundant academic literature, these models are the basis of numerous practical systems widely utilized by end users and organizations. In healthcare information systems, there are many case studies and research prototypes demonstrating the promise of applying GPT-like programs to numerous practical natural language processing tasks. At the same time, current limitations of LLMs prevent their safe deployments in professional environments. In this study, we give an overview of capabilities, limitations, and risks associated with current iterations of LLMs. We provide an overview of literature on using LLMs in healthcare context. Finally, we present a framework of generic healthcare IT system utilizing LLMs, and discuss avenues for future research.",
    booktitle = "Proceedings of the 2024 ACM Southeast Conference",
    pages = "223–228",
    numpages = "6",
    keywords = "GPT, Healthcare IT, Large Language Models, Software Engineering",
    location = "Marietta, GA, USA",
    series = "ACMSE '24"
}

@inproceedings{cons848,
    author = "Chen, Yanshi and Ji, Wei and Luo, Chuangli",
    title = "The prediction model of Chinese labor demand change is based on generative adversarial deep learning (GADL) and multi-modal data fusion",
    year = "2025",
    isbn = "9798400712791",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3745238.3745269",
    doi = "10.1145/3745238.3745269",
    abstract = "With the rapid development of artificial intelligence (AI) technology and the upgrading of industrial structure, the demand changes in the labor market show more complex dynamic characteristics, and it is difficult for traditional statistical and machine learning methods to accurately predict market trends. In order to improve the prediction accuracy and model adaptability, this paper proposes a labor demand prediction model based on generative adversarial deep learning (GADL) and multi-modal data fusion. The model uses generative adversarial network (GAN) to generate supplementary data to compensate for data scarcity, combined with convolutional neural network (CNN) and Transformer to conduct multimodal feature extraction, and finally time series modeling by long and short-term memory network (LSTM). The experimental results show that the GADL model is better than the LSTM and ARIMA method in several key performance indicators, and the mean square error (MSE) is reduced to 5\% of the traditional method, and the determination coefficient (R²) reaches 0.9966, which significantly improves the prediction accuracy. The research shows that GADL model can more effectively capture the changing trend of labor market and provide data support for the optimization of government employment policy, enterprise human resource planning and talent training in universities. The study in this paper provides a new methodology for labor market prediction and lays the foundation for subsequent research.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence",
    pages = "177–181",
    numpages = "5",
    location = "",
    series = "DEAI '25"
}

@inproceedings{cons849,
    author = "Zhang, Wenting and Zhang, Qiaorong and Cai, Mingming and Wang, Dongqing and Zheng, Yafeng",
    title = "Navigating the Application Challenges of ChatGPT in Education: Promoting Responsible Use and Minimizing Mental Risks",
    year = "2024",
    isbn = "9798400716805",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3675812.3675843",
    doi = "10.1145/3675812.3675843",
    abstract = "With the wide application of artificial intelligence, especially generative AI like ChatGPT, the era of significant transformation in education has quietly arrived. This article first explores the current applications of ChatGPT in logical learning, language learning, as well as personalized and effective teaching. It then deeply analyzes the challenges brought by the application of ChatGPT in education from three aspects: digital ethics, psychological risks for teachers and students, and educational governance. Based on its potential risks and challenges, effective measures and suggestions are proposed, including improving information literacy education, fully utilizing human-computer collaboration, and establishing clear regulations for the use of ChatGPT. These measures aim to ensure that ChatGPT can maximize its application value in the field of education while minimizing the mental risks.",
    booktitle = "Proceedings of the 2024 9th International Conference on Distance Education and Learning",
    pages = "23–28",
    numpages = "6",
