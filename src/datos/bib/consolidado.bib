}

@inproceedings{cons870,
    author = "Valtolina, Stefano and Zanotti, Paolo and Mandelli, Stefano",
    title = "Designing Conversational Agents to Empower Active Aging",
    year = "2024",
    isbn = "9798400706257",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3652988.3673939",
    doi = "10.1145/3652988.3673939",
    abstract = "Senile dementia is a growing healthcare concern, highlighting the need for cognitive stimulation in individuals with mental decline. This study presents an innovative web-based dashboard to identify and address cognitive decline in elderly patients. The toolkit includes patient profiling, treatment planning, and real-time cognitive monitoring, aiming to intervene early in the onset of mental deterioration, often missed during sporadic assessments. A conversational agent (CA) tailored for older people facilitates natural cognitive exercises and allows geriatric professionals to monitor cognitive abilities remotely. This CA ensures continuous monitoring and early detection of cognitive changes. The study evaluates the efficacy of these tools in enhancing care quality, fostering independence, and promoting overall well-being among older adults.",
    booktitle = "Proceedings of the 24th ACM International Conference on Intelligent Virtual Agents",
    articleno = "30",
    numpages = "4",
    keywords = "Conversational Agents, End User Development",
    location = "GLASGOW, United Kingdom",
    series = "IVA '24"
}

@inproceedings{cons871,
    author = "Sun, Huaijin and He, Ying",
    title = "The Application and User Acceptance of AIGC in Network Audiovisual Field: Based on the Perspective of Social Cognitive Theory",
    year = "2023",
    isbn = "9798400700590",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3627915.3628020",
    doi = "10.1145/3627915.3628020",
    abstract = {[Purpose/Significance] Chinese network audiovisual has become the largest Internet application in China, by combing the application and user acceptance of AIGC in the field of network audiovisual, this paper discusses the standardization, rationalization and high-quality development of AIGC deeply embedded in the field of network audiovisual.[Design/Methodology] Based on the research framework of "environment - subject cognition - behavior" of social cognition theory, this paper constructs a model of "network audiovisual environment - self-determination theory-user acceptance" of AIGC, studies the application of AIGC in network audiovisual environment from three aspects of generation carrier, generation technology and generation digital life. According to the self-determination theory of psychology, this paper studies the user's autonomy, competence and relatedness, and then discusses the user's acceptance behavior.[Findings/Conclusion] By analyzing the application process of AIGC to be accepted by users in the field of network audiovisual, it is found that there are problems of data source, use ethics and copyright ownership of AIGC, and threats from data security, digital colonization, and users’ ideology.[Originality/Value] The analysis of AIGC is combined with the network audiovisual, which is the largest application environment of the Internet in China, and using communication science and social psychology to carry out cross-research, it brings new creative ideas to the analysis of AIGC and puts forward countermeasures to the potential threats of AIGC.},
    booktitle = "Proceedings of the 7th International Conference on Computer Science and Application Engineering",
    articleno = "11",
    numpages = "5",
    keywords = "Artificial Intelligence Generated Content (AIGC), Network Audiovisual Field, Self-determination Theory, Social Cognitive Theory, User Acceptance",
    location = "Virtual Event, China",
    series = "CSAE '23"
}

@inproceedings{cons872,
    author = "Sun, Jian and Wang, Shuyi and Zhang, Runnan",
    title = "Research Status and Prospects of Generative AI Governance in China Based on Visual Analysis",
    year = "2025",
    isbn = "9798400712791",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3745238.3745397",
    doi = "10.1145/3745238.3745397",
    abstract = "The data in this paper comes from CNKI, the Chinese literature database. This paper researched papers from 2015 to 2024 on Chinese generative AI governance in this database. With the help of the visualization software Citerspace and VOSviewer, the paper conducts data processing and visualization analyses from annual publication volumes, main agencies, core authors, and keyword trends. The paper studied the conditions and future perspectives of the Chinese generative AI governance studies. Our study shows that the paper volumes of this field are witnessing a rising trend. The research mainly aims at digital security as the key research topic; AI algorithms in technical difficulty-related topics; agile governance, risk governance, digital governance, technical governance, comprehensive governance, and global governance as solution-related topics. Trends in this field are becoming more diverse in governance fields and patterns. National security is becoming more and more important macroscopically. As for governance tools, papers focus more on the development of legal regulations. Microly, papers pay attention more to the privacy and security of personal information.",
    booktitle = "Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence",
    pages = "1017–1023",
    numpages = "7",
    keywords = "Artificial Intelligence, China, Generative AI Governance, Visual Analysis",
    location = "",
    series = "DEAI '25"
}

@inbook{cons873,
    author = "Shen, Yixian and Zhang, Hang and Shen, Yanxin and Wang, Lun and Shi, Chuanqi and Du, Shaoshuai and Tao, Yiyi",
    title = "AltGen: AI-Driven Alt Text Generation for Enhancing EPUB Accessibility",
    year = "2025",
    isbn = "9798400713637",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3730436.3730449",
    abstract = "Digital accessibility is essential for the equitable dissemination of content; however, certain EPUB files fail to adhere to fundamental accessibility standards, particularly in the provision of alternate text (alt text) for images. Alt text is indispensable for visually impaired individuals to understand visual content through assistive technologies. Nonetheless, the manual generation of high-quality alt text at scale continues to pose a considerable difficulty because of the requisite skill and time involved.This paper introduces AltGen, a framework utilizing generative AI to automate the development of alt text for EPUB files. AltGen uses pre-trained transformer models to provide descriptive and contextually pertinent alt text. It employs a structured process encompassing data extraction, visual content analysis with computer vision models (e.g., CLIP, ViT), and context-sensitive text generation utilizing fine-tuned large language models. The produced alt-text is assessed by computational measures, including cosine similarity and BLEU scores, and qualitative input from visually challenged individuals. Experimental findings demonstrate that AltGen lowers accessibility errors by 97.5\%, with participants noting substantial enhancements in content understanding and usability.",
    booktitle = "Proceedings of the 2025 International Conference on Artificial Intelligence and Computational Intelligence",
    pages = "78–83",
    numpages = "6"
}

@inproceedings{cons874,
    author = "Xu, Anbang and Yu, Tan and Du, Min and Gundecha, Pritam and Guo, Yufan and Zhu, Xinliang and Wang, May and Li, Ping and Chen, Xinyun",
    title = "Generative AI and Retrieval-Augmented Generation (RAG) Systems for Enterprise",
    year = "2024",
    isbn = "9798400704369",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3627673.3680117",
    doi = "10.1145/3627673.3680117",
    abstract = "This workshop introduces generative AI applications for enterprise, with a focus on retrieval-augmented generation (RAG) systems. Generative AI is a field of artificial intelligence that can create new content and solve complex problems. RAG systems are a novel generative AI technique that combines information retrieval with text generation to generate rich and diverse responses. RAG systems can leverage enterprise data, which is often specific, structured, and dynamic, to provide customized solutions for various domains. However, enterprise data also poses challenges such as scalability, security, and data quality. This workshop convenes researchers and practitioners to explore RAG and other generative AI systems in real-world enterprise scenarios, fostering knowledge exchange, collaboration, and identification of future directions. Relevant to the CIKM community, the workshop intersects with core areas of data science and machine learning, offering potential benefits across various domains.",
    booktitle = "Proceedings of the 33rd ACM International Conference on Information and Knowledge Management",
    pages = "5599–5602",
    numpages = "4",
    keywords = "enterprise application, generation, rag, retrieval",
    location = "Boise, ID, USA",
    series = "CIKM '24"
}

@inproceedings{cons875,
    author = "Li, Jiahui and Wang, Ruoqian and Li, Xiaomin and Cai, Rongcong and Guo, Jiaqi",
    title = "A quasi-experimental study: To explore the influence of AIGC in the teaching of art design course",
    year = "2025",
    isbn = "9798400712432",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
