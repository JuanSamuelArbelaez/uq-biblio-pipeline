}

@inproceedings{cons414,
    author = "Schauer, Sophie and Simbeck, Katharina",
    title = "Conceptual Implementation of a Digital Cultural Heritage Application using Generative AI",
    year = "2025",
    isbn = "9798400710322",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3719236.3719242",
    doi = "10.1145/3719236.3719242",
    abstract = "This paper explores the conceptual implementation of an application design, previously developed by communication design students. In an increasingly digitalised world, making cultural heritage accessible and approachable to diverse visitors is critical. The concept idea centres on an interactive video call with the patron of a Renaissance sandstone altar exhibited at the museum. The technical implementation includes generative AI tools for text, audio and animation production. Issues such as ensuring the accuracy of information, maintaining user privacy and preventing biases in AI-generated content are identified. The importance of co-creation with experts and adherence to ethical standards are highlighted to create a reliable educational tool. This implementation proposal forms the foundation for further development and future deployment as part of the museum’s permanent exhibition, aiming to transform how visitors experience and interact with cultural heritage artefacts.",
    booktitle = "Proceedings of the 21st International Conference on Culture and Computer Science: From Humanism to Digital Humanities",
    articleno = "10",
    numpages = "6",
    keywords = "Cultural Heritage, Generative Artificial Intelligence, Museum Mediation, Digitalisation, Mobile Application, Human-Computer Interaction.",
    location = "",
    series = "KUI '24"
}

@inproceedings{cons415,
    author = "Patras, Ioannis",
    title = "Controllable image generation and manipulation",
    year = "2023",
    isbn = "9798400701870",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3592572.3596476",
    doi = "10.1145/3592572.3596476",
    abstract = "Recent years have witnessed an unprecedented interest in developing Deep Learning methodologies for the generation of images and image sequences that are hardly distinguishable to the human eye from real ones. A major issue in this field is how the generation can be easily controlled. In this talk we will focus on some of our recent works in generative models that are primarily aimed at controllable generation. We will first present unsupervised methods for learning non-linear paths in the latent spaces of Generative Adversarial Networks such that following different paths lead to different types of changes (e.g., removing the background, changing head poses, or facial expressions) in the resulting images\&nbsp;[4]. Subsequently, we will present a method that allows local editing by finding a Parts and Appearances decomposition in the GAN latent space\&nbsp;[2]. Then, we will present recent works on reenactment\&nbsp;[1], where the goal is to transfer the facial activity (pose, expressions, speech) of a certain person to another one, and recent works in which supervision for generation comes from language models\&nbsp;[3]. Finally, we will touch on the technical challenges ahead, as well on the challenges that this creates in spreading misinformation.",
    booktitle = "Proceedings of the 2nd ACM International Workshop on Multimedia AI against Disinformation",
    pages = "1",
    numpages = "1",
    keywords = "artificial intelligence, deep learning, generative adversarial networks, generative artificial intelligence, image manipulation, reenactment",
    location = "Thessaloniki, Greece",
    series = "MAD '23"
}

@inproceedings{cons416,
    author = "Li, Hui and Peng, Juan and Li, Xianhao and Yang, Xingrui and Wang, Pan and Fan, Xiaohu",
    title = "Application research of evolutionary generative model for financial information sentiment retrieval based on interactive genetic algorithm",
    year = "2025",
    isbn = "9798400713163",
    publisher = "Association for Computing Machinery",
    address = "New York, NY, USA",
    url = "https://doi.org/10.1145/3746709.3746884",
    doi = "10.1145/3746709.3746884",
    abstract = "Financial texts contain rich emotional information, which is of great significance for capturing emotional fluctuations in financial markets, assisting investors in decision-making and implementing financial risk management. However, sentiment information of financial texts requires a lot of domain expert knowledge, and manual retrieval is expensive. In this paper, we propose the application of an evolutionary generative model for sentiment retrieval of financial information based on interactive genetic algorithms from the perspective of user implicit modeling. The uncertain preference estimation of evolutionary individuals is realized. The user preference model is adjusted according to the uncertainty evaluation, and the user preference is dynamically tracked to obtain the fitness value of the evolutionary individual for evolutionary optimization. The experimental results show that the proposed method can implicitly perceive user preferences, reduce user explicit evaluation, reduce user fatigue, and improve the search performance of the algorithm.",
    booktitle = "Proceedings of the 2025 6th International Conference on Computer Information and Big Data Applications",
    pages = "1031–1036",
    numpages = "6",
    keywords = "Generative patterns are evolutionary, Interactive genetic algorithm, Generative artificial intelligence, Financial information, Emotion retrieval",
    location = "",
    series = "CIBDA '25"
}

